{%- comment -%}
  Ciamore Guthaben: Gutschein-Seite mit druckbarem A4-Blatt.
  Bildschirm: Hinweis + Buttons + A4-Vorschau. Druck: nur das A4-Blatt, randlos.
  Das Blatt ist für zweimaliges Falten (DL-Umschlag) gebaut: Falzlinien bei 99 mm und 198 mm.
{%- endcomment -%}
{%- liquid
  layout none
  assign gc_value = gift_card.initial_value | money_without_trailing_zeros | strip_html
  assign gc_balance = gift_card.balance | money_without_trailing_zeros | strip_html
  assign gc_code = gift_card.code | format_code
  assign gc_expiry = gift_card.expires_on | date: '%d.%m.%Y'
  assign gc_to = gift_card.recipient.nickname | default: gift_card.recipient.name
  assign gc_from = ''
  if gc_to != blank and gift_card.customer
    assign gc_from = gift_card.customer.first_name
  endif
  assign gc_message = gift_card.message
-%}
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <title>Dein Ciamore Guthaben über {{ gc_value }}</title>
  <link rel="canonical" href="{{ canonical_url }}">
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer="defer"></script>
  <style>
    @font-face { font-family: 'CmBric'; src: url('{{ 'cm-bricolage.woff2' | asset_url }}') format('woff2'); font-weight: 200 800; font-display: swap; }
    @font-face { font-family: 'CmFig'; src: url('{{ 'cm-figtree-400.woff2' | asset_url }}') format('woff2'); font-weight: 400; font-display: swap; }
    @font-face { font-family: 'CmFig'; src: url('{{ 'cm-figtree-600.woff2' | asset_url }}') format('woff2'); font-weight: 600; font-display: swap; }
    @font-face { font-family: 'CmFig'; src: url('{{ 'cm-figtree-700.woff2' | asset_url }}') format('woff2'); font-weight: 700; font-display: swap; }

    :root {
      --ink: #1e1e1e;
      --muted: #6f6a63;
      --line: #d9d3c8;
      --cream: #f3f1ec;
      --gold-1: #b8893d; --gold-2: #f6dd9a; --gold-3: #c9a45c; --gold-4: #fff2c9; --gold-5: #a9792c;
      --gold-text: #9a7430;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; }
    body {
      background: var(--cream);
      color: var(--ink);
      font-family: 'CmFig', system-ui, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* ---------- Bildschirm-Kopf ---------- */
    .gc-top { max-width: 760px; margin: 0 auto; padding: 32px 16px 8px; text-align: center; }
    .gc-top__logo { width: 150px; height: auto; display: block; margin: 0 auto 22px; }
    .gc-top h1 { font: 700 30px/1.15 'CmBric', sans-serif; letter-spacing: -.02em; margin: 0 0 10px; }
    .gc-top p { font-size: 15px; line-height: 1.55; color: #4a4640; margin: 0 auto 6px; max-width: 520px; }
    .gc-top__status { display: inline-block; margin: 10px 0 0; padding: 6px 12px; border-radius: 999px; background: #fff; border: 1px solid var(--line); font-size: 13px; font-weight: 600; }
    .gc-top__status--warn { background: #fff3f0; border-color: #f0c9bf; color: #8a2b14; }
    .gc-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin: 22px 0 6px; }
    .gc-btn { appearance: none; border: 0; cursor: pointer; text-decoration: none; font: 600 15px 'CmFig', sans-serif; padding: 14px 22px; border-radius: 999px; display: inline-flex; align-items: center; gap: 8px; }
    .gc-btn--primary { background: var(--ink); color: #fff; }
    .gc-btn--ghost { background: transparent; color: var(--ink); border: 1.5px solid var(--ink); }
    .gc-codebar { margin: 18px auto 0; display: inline-flex; align-items: center; gap: 10px; background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 10px 10px 10px 16px; }
    .gc-codebar code { font: 600 17px/1 ui-monospace, 'SFMono-Regular', Menlo, monospace; letter-spacing: .08em; }
    .gc-codebar button { appearance: none; border: 0; background: var(--cream); border-radius: 10px; padding: 8px 12px; font: 600 13px 'CmFig', sans-serif; cursor: pointer; color: var(--ink); }
    .gc-tip { font-size: 13px !important; color: var(--muted) !important; margin-top: 14px !important; }
    .gc-wallet { display: block; margin: 14px auto 0; width: 120px; }

    /* ---------- A4-Blatt ---------- */
    .gc-stage { padding: 18px 16px 56px; display: flex; justify-content: center; overflow: hidden; }
    .gc-scale { transform-origin: top center; }
    .sheet {
      width: 210mm; height: 297mm; position: relative; overflow: hidden;
      background: #fffdf9;
      box-shadow: 0 30px 60px -25px rgba(40,30,15,.35), 0 8px 18px -8px rgba(0,0,0,.12);
      -webkit-print-color-adjust: exact; print-color-adjust: exact;
    }
    .panel { position: absolute; left: 0; right: 0; height: 99mm; padding: 0 18mm; }
    .panel--1 { top: 0; }
    .panel--2 { top: 99mm; display: flex; align-items: center; justify-content: center; }
    .panel--3 { top: 198mm; }

    /* Falzmarken */
    .fold { position: absolute; width: 6mm; height: 0; border-top: .25mm solid #cfc8bb; }
    .fold--l { left: 0; } .fold--r { right: 0; }
    .fold--a { top: 99mm; } .fold--b { top: 198mm; }

    /* Panel 1: Cover */
    .p1 { height: 100%; display: flex; flex-direction: column; align-items: center; text-align: center; padding-top: 16mm; }
    .p1__logo { width: 46mm; height: auto; }
    .p1__label { margin-top: 7mm; font: 600 8.5pt 'CmFig', sans-serif; letter-spacing: .38em; color: var(--gold-text); }
    .p1__title { margin: 3.5mm 0 0; font: 700 27pt/1.05 'CmBric', sans-serif; letter-spacing: -.02em; }
    .p1__msg { margin: 4mm auto 0; max-width: 140mm; font-size: 10.5pt; line-height: 1.45; color: #4a4640; font-style: italic; }
    .p1__names { margin-top: auto; margin-bottom: 11mm; width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 12mm; }
    .p1__name { display: flex; align-items: flex-end; gap: 3mm; font: 600 9pt 'CmFig', sans-serif; letter-spacing: .2em; color: var(--muted); }
    .p1__name span.line { flex: 1; border-bottom: .3mm solid #bdb5a7; height: 7mm; font: 400 13pt 'CmBric', sans-serif; letter-spacing: 0; color: var(--ink); text-align: left; padding-left: 2mm; }

    /* Panel 2: Karte */
    .card {
      width: 138mm; height: 87mm; border-radius: 5mm; position: relative; overflow: hidden; color: #fff;
      background: linear-gradient(145deg,#262629 0%,#0d0d0f 45%,#050506 70%,#1a1a1d 100%);
    }
    .card__glitter { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: .45; }
    .card__shine { position: absolute; inset: 0; background: linear-gradient(115deg,rgba(255,255,255,0) 30%,rgba(255,255,255,.10) 42%,rgba(255,255,255,0) 54%); }
    .card__in { position: absolute; inset: 0; padding: 8mm 9mm; display: flex; flex-direction: column; justify-content: space-between; }
    .card__top { display: flex; justify-content: space-between; align-items: flex-start; }
    .card__logo { width: 40mm; height: auto; }
    .card__tag { font: 600 6.5pt 'CmFig', sans-serif; letter-spacing: .32em; color: #e6cf93; margin-top: 1.6mm; }
    .card__lbl { font: 600 7.5pt 'CmFig', sans-serif; letter-spacing: .34em; color: rgba(255,255,255,.75); margin-bottom: 1mm; }
    .card__val {
      display: inline-block;
      font: 800 54pt/0.95 'CmBric', sans-serif; letter-spacing: -.03em;
      background: linear-gradient(95deg,var(--gold-1) 0%,var(--gold-2) 30%,var(--gold-3) 52%,var(--gold-4) 72%,var(--gold-5) 100%);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .card__bottom { display: flex; justify-content: space-between; align-items: flex-end; }
    .card__code { font: 600 10.5pt ui-monospace, 'SFMono-Regular', Menlo, monospace; letter-spacing: .12em; color: #f3e3b6; }
    .card__codelbl { font: 600 6pt 'CmFig', sans-serif; letter-spacing: .3em; color: rgba(255,255,255,.55); margin-bottom: 1.2mm; }
    .card__spark { font-size: 15pt; color: #e6cf93; line-height: 1; }

    /* Panel 3: Einlösen */
    .p3 { height: 100%; display: grid; grid-template-columns: 1fr 34mm; gap: 10mm; align-items: center; padding-bottom: 16mm; }
    .p3__h { font: 700 14pt 'CmBric', sans-serif; margin: 0 0 4mm; letter-spacing: -.01em; }
    .p3 ol { list-style: none; margin: 0; padding: 0; counter-reset: s; }
    .p3 li { counter-increment: s; position: relative; padding-left: 9mm; margin: 0 0 3.2mm; font-size: 10pt; line-height: 1.4; color: #3a3631; }
    .p3 li::before { content: counter(s); position: absolute; left: 0; top: -.2mm; width: 5.6mm; height: 5.6mm; border-radius: 50%; background: var(--ink); color: #fff; font: 700 8pt/5.6mm 'CmFig', sans-serif; text-align: center; }
    .p3 li b { color: var(--ink); }
    .p3__code { font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace; font-weight: 600; letter-spacing: .06em; white-space: nowrap; }
    .p3__qr { text-align: center; }
    .p3__qr #QrCode { width: 30mm; height: 30mm; margin: 0 auto; }
    .p3__qr #QrCode img, .p3__qr #QrCode canvas { width: 30mm !important; height: 30mm !important; }
    .p3__qr small { display: block; margin-top: 2mm; font-size: 7.5pt; letter-spacing: .12em; color: var(--muted); text-transform: uppercase; }
    .foot { position: absolute; left: 18mm; right: 18mm; bottom: 9mm; display: flex; justify-content: space-between; font-size: 7.5pt; color: #8a847b; letter-spacing: .04em; border-top: .25mm solid #e6e0d5; padding-top: 3mm; }

    @media (max-width: 600px) {
      .gc-top h1 { font-size: 25px; }
      .gc-btn { width: 100%; justify-content: center; }
    }

    /* ---------- Druck ---------- */
    @page { size: A4; margin: 0; }
    @media print {
      html, body { background: #fff; width: 210mm; height: 297mm; }
      .gc-top, .gc-wallet { display: none !important; }
      .gc-stage { padding: 0; display: block; }
      .gc-scale { transform: none !important; height: auto !important; }
      .sheet { box-shadow: none; page-break-after: avoid; break-after: avoid; }
      .card__val { background: none; -webkit-background-clip: border-box; background-clip: border-box; color: #d4ad62; }
    }
  </style>
  {{ content_for_header }}
</head>
<body>
  <header class="gc-top">
    <img class="gc-top__logo" src="{{ 'cm-logo-black.png' | asset_url }}" alt="Ciamore" width="1339" height="358">
    <h1>Dein Guthaben ist da ✨</h1>
    <p>Hier ist dein Ciamore Guthaben über <b>{{ gc_value }}</b>. Druck dir die Seite unten auf A4 aus, zweimal falten, ab in den Umschlag. Fertig ist das Geschenk.</p>

    {%- if gift_card.enabled == false -%}
      <span class="gc-top__status gc-top__status--warn">Dieser Gutschein ist deaktiviert.</span>
    {%- elsif gift_card.expired -%}
      <span class="gc-top__status gc-top__status--warn">Dieser Gutschein ist am {{ gc_expiry }} abgelaufen.</span>
    {%- elsif gift_card.balance != gift_card.initial_value -%}
      <span class="gc-top__status">Restguthaben: {{ gc_balance }} von {{ gc_value }}</span>
    {%- endif -%}

    <div class="gc-actions">
      <button type="button" class="gc-btn gc-btn--primary" onclick="window.print()">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        Ausdrucken oder als PDF speichern
      </button>
      <a class="gc-btn gc-btn--ghost" href="{{ shop.url }}">Zum Shop</a>
    </div>

    <div class="gc-codebar">
      <code id="GiftCardDigits">{{ gc_code }}</code>
      <button type="button" id="CopyCode">Kopieren</button>
    </div>
    <p class="gc-tip">Tipp: Im Druckdialog „Ränder: Keine“ bzw. „Randlos“ wählen und Hintergrundgrafiken aktivieren, dann sieht die Karte am schönsten aus.</p>

    {%- if gift_card.pass_url -%}
      <a href="{{ gift_card.pass_url }}" class="gc-wallet"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Zu Apple Wallet hinzufügen"></a>
    {%- endif -%}
  </header>

  <div class="gc-stage">
    <div class="gc-scale" id="GcScale">
      <article class="sheet" aria-label="Gutschein zum Ausdrucken">
        <i class="fold fold--l fold--a"></i><i class="fold fold--r fold--a"></i>
        <i class="fold fold--l fold--b"></i><i class="fold fold--r fold--b"></i>

        <section class="panel panel--1">
          <div class="p1">
            <img class="p1__logo" src="{{ 'cm-logo-black.png' | asset_url }}" alt="Ciamore">
            <div class="p1__label">GESCHENKGUTSCHEIN</div>
            <h2 class="p1__title">Ein kleines Funkeln<br>nur für dich</h2>
            {%- if gc_message != blank -%}
              <p class="p1__msg">„{{ gc_message | escape }}“</p>
            {%- endif -%}
            <div class="p1__names">
              <div class="p1__name">FÜR <span class="line">{{ gc_to | escape }}</span></div>
              <div class="p1__name">VON <span class="line">{{ gc_from | escape }}</span></div>
            </div>
          </div>
        </section>

        <section class="panel panel--2">
          <div class="card">
            <img class="card__glitter" src="{{ 'ciamore-newyearglow-bg.jpg' | asset_url }}" alt="">
            <div class="card__shine"></div>
            <div class="card__in">
              <div class="card__top">
                <img class="card__logo" src="{{ 'cm-logo-white.png' | asset_url }}" alt="Ciamore">
                <div class="card__tag">GUTHABEN</div>
              </div>
              <div>
                <div class="card__val">{{ gc_value }}</div>
              </div>
              <div class="card__bottom">
                <div>
                  <div class="card__codelbl">GUTSCHEINCODE</div>
                  <div class="card__code">{{ gc_code }}</div>
                </div>
                <div class="card__spark">✦</div>
              </div>
            </div>
          </div>
        </section>

        <section class="panel panel--3">
          <div class="p3">
            <div>
              <h3 class="p3__h">So löst du dein Guthaben ein</h3>
              <ol>
                <li>Such dir auf <b>ciamore.de</b> deine Lieblings-Pieces oder ein Bundle aus.</li>
                <li>Gib im Checkout den Code <span class="p3__code">{{ gc_code }}</span> ein.</li>
                <li>Nicht alles auf einmal ausgegeben? Kein Problem, <b>dein Restguthaben bleibt erhalten.</b></li>
              </ol>
            </div>
            <div class="p3__qr">
              <div id="QrCode"></div>
              <small>Zum Shop</small>
            </div>
          </div>
        </section>

        <footer class="foot">
          <span>ciamore.de · Wasserfester Schmuck</span>
          <span>{% if gift_card.expires_on %}Gültig bis {{ gc_expiry }}{% else %}Guthaben über {{ gc_value }}{% endif %}</span>
        </footer>
      </article>
    </div>
  </div>

  <script>
    (function () {
      // A4-Vorschau auf kleinen Bildschirmen passend skalieren
      var wrap = document.getElementById('GcScale');
      function fit() {
        var sheet = wrap.firstElementChild;
        var w = sheet.offsetWidth, h = sheet.offsetHeight;
        var avail = Math.min(document.documentElement.clientWidth - 32, w);
        var s = avail / w;
        wrap.style.transform = s < 1 ? 'scale(' + s + ')' : '';
        wrap.style.height = s < 1 ? (h * s) + 'px' : '';
      }
      window.addEventListener('resize', fit);
      fit();

      // Code kopieren
      var btn = document.getElementById('CopyCode');
      btn && btn.addEventListener('click', function () {
        var code = document.getElementById('GiftCardDigits').textContent.trim();
        var done = function () { btn.textContent = 'Kopiert ✓'; setTimeout(function () { btn.textContent = 'Kopieren'; }, 1800); };
        if (navigator.clipboard) { navigator.clipboard.writeText(code).then(done, done); } else { done(); }
      });

      // QR-Code zum Shop
      window.addEventListener('load', function () {
        if (window.QRCode) {
          new QRCode(document.getElementById('QrCode'), { text: {{ shop.url | json }}, width: 240, height: 240, colorDark: '#1e1e1e', colorLight: '#fffdf9' });
        }
      });
    })();
  </script>
</body>
</html>
