        "code_UrMXFJ": {
          "type": "code",
          "name": "gutscheincode",
          "settings": {
            "code": "<div class=\"gg-rabatt-wrapper\">\n  <div class=\"gg-gutscheincode-wrapper\" id=\"gg-box\">\n    \n    <div class=\"gg-gutscheincode-text\" id=\"gg-original-content\">\n      <span class=\"gg-code-text\">\n        oder nur <b id=\"discounted-price\">--,-- €</b> mit dem Code \n        <b class=\"gg-code\" id=\"copy-code-button\">\n          \"FALL20\"\n          <svg viewBox=\"0 0 24 24\" width=\"13\" height=\"13\">\n            <path d=\"M16 1H6a2 2 0 0 0-2 2v10h2V3h10V1zm3 4H10a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 16H10V7h9v14z\"/>\n          </svg>\n        </b>\n      </span>\n    </div>\n\n    <div id=\"gg-success-message\">\n      Gutscheincode kopiert\n    </div>\n\n    <span class=\"gg-subtext\" id=\"gg-subtext\">\n      Ab einem Bestellwert von 69€\n    </span>\n\n  </div>\n</div>\n\n<style>\n.gg-rabatt-wrapper { margin: 15px 0; }\n\n.gg-gutscheincode-wrapper {\n  background: #FBF7F0;\n  border-radius: 12px;\n  padding: 12px 16px;\n  text-align: center;\n  position: relative; /* wichtig */\n}\n\n.gg-gutscheincode-text {\n  font-size: 13px;\n  line-height: 1.4;\n}\n\n.gg-gutscheincode-text b { font-weight: 700; }\n\n.gg-code { cursor: pointer; }\n\n.gg-code svg {\n  margin-left: 2px;\n  vertical-align: middle;\n  fill: #000;\n  opacity: 0.85;\n  transform: translateY(-1px);\n}\n\n.gg-subtext {\n  display: block;\n  margin-top: 6px;\n  font-size: 12px;\n  opacity: 0.8;\n}\n\n/* SUCCESS TEXT (zentriert über Box) */\n#gg-success-message {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  font-size: 14px;\n  font-weight: 600;\n  opacity: 0;\n  pointer-events: none;\n  transition: opacity 0.2s ease;\n}\n\n</style>\n\n<script>\n// ===== COPY BUTTON =====\ndocument.getElementById('copy-code-button').addEventListener('click', function() {\n  const couponCode = 'FALL20';\n\n  navigator.clipboard.writeText(couponCode).then(function() {\n\n    const original = document.getElementById('gg-original-content');\n    const subtext = document.getElementById('gg-subtext');\n    const success = document.getElementById('gg-success-message');\n\n    // Inhalt nur unsichtbar machen (Platz bleibt erhalten)\n    original.style.visibility = 'hidden';\n    subtext.style.visibility = 'hidden';\n\n    // Success anzeigen\n    success.style.opacity = '1';\n\n    // Nach 1.5s zurück\n    setTimeout(() => {\n      original.style.visibility = 'visible';\n      subtext.style.visibility = 'visible';\n      success.style.opacity = '0';\n    }, 1500);\n\n    // Toast\n\n    \n  });\n});\n\n\n// ===== 20% BERECHNUNG =====\nfunction getCurrentProductPrice() {\n  let salePrice = document.querySelector('.product__price--sale');\n  if (salePrice) return extractNumber(salePrice.innerText);\n\n  let normalPrice = document.querySelector('.product__price');\n  if (normalPrice) return extractNumber(normalPrice.innerText);\n\n  return null;\n}\n\nfunction extractNumber(text) {\n  let match = text.replace(/\\s/g, '').match(/(\\d+[.,]\\d{2})/);\n  if (!match) return null;\n  return parseFloat(match[1].replace(',', '.'));\n}\n\nfunction formatGermanPrice(number) {\n  return number.toLocaleString('de-DE', {\n    style: 'currency',\n    currency: 'EUR'\n  });\n}\n\nfunction updateDiscountPrice() {\n  let price = getCurrentProductPrice();\n  if (!price) return;\n\n  let discounted = price * 0.80;\n  let formatted = formatGermanPrice(discounted);\n\n  document.getElementById('discounted-price').innerText = formatted;\n}\n\ndocument.addEventListener('DOMContentLoaded', function() {\n  updateDiscountPrice();\n});\n</script>",
