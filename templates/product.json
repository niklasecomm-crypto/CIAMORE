    "section_custom_code_Cj7iha": {
      "type": "section-custom-code",
      "settings": {
        "code": "{%- unless product.handle == 'geschenkgutschein-1' -%}\n<div class=\"cm-specs\" data-v=\"lines\">\n  <dl class=\"cm-specs__list\">\n  {% if product.metafields.custom.materialien != blank %}\n  <div class=\"cm-specs__row\"><dt>Material</dt><dd>{{ product.metafields.custom.materialien }}</dd></div>\n  {% endif %}\n  {% if product.metafields.custom.steine != blank %}\n  <div class=\"cm-specs__row\"><dt>Steine</dt><dd>{{ product.metafields.custom.steine }}</dd></div>\n  {% endif %}\n  {% if product.metafields.custom.laenge != blank %}\n  <div class=\"cm-specs__row\"><dt>Länge</dt><dd>{{ product.metafields.custom.laenge }}</dd></div>\n  {% endif %}\n  {% if product.metafields.custom.veredelung != blank %}\n  <div class=\"cm-specs__row\"><dt>Veredelung</dt><dd>{{ product.metafields.custom.veredelung }}</dd></div>\n  {% endif %}\n  {% if product.metafields.custom.kleeblatt != blank %}\n  <div class=\"cm-specs__row\"><dt>Kleeblatt</dt><dd>{{ product.metafields.custom.kleeblatt }}</dd></div>\n  {% endif %}\n  {% if product.metafields.custom.kleeblatt_farben != blank %}\n  <div class=\"cm-specs__row\"><dt>Kleeblatt-Farben</dt><dd>{{ product.metafields.custom.kleeblatt_farben | join: ', ' }}</dd></div>\n  {% endif %}\n  {% if product.metafields.custom.wasserfest != blank %}\n  <div class=\"cm-specs__row\"><dt>Wasserfest</dt><dd><span class=\"cm-specs__yes\">✓</span></dd></div>\n  {% endif %}\n  </dl>\n</div>\n<style>\n  .cm-specs { margin: 8px 0 4px; font-family: var(--cm-body); }\n  .cm-specs__title { margin: 0 0 6px; font-family: var(--cm-display); font-weight: 800; font-size: 22px; letter-spacing: -0.03em; line-height: 1.1; color: #212121; }\n  .cm-specs__list { margin: 0; padding: 0; }\n  .cm-specs dt, .cm-specs dd { margin: 0; }\n  .cm-specs__yes { font-weight: 700; }\n  /* 1 lines: Bezeichnung klein grau in Großbuchstaben, Wert fett, Haarlinien */\n  .cm-specs[data-v=\"lines\"] .cm-specs__row { display: grid; grid-template-columns: 38% 1fr; align-items: baseline; gap: 16px; padding: 13px 0; border-bottom: 1px solid #dcdcdc; }\n  .cm-specs[data-v=\"lines\"] .cm-specs__row:last-child { border-bottom: 0; }\n  .cm-specs[data-v=\"lines\"] dt { font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #212121; }\n  .cm-specs[data-v=\"lines\"] dd { font-size: 14.5px; font-weight: 600; line-height: 1.4; color: #212121; }\n  /* 2 leaders: wie eine edle Preisliste, Punktlinie zwischen Bezeichnung und Wert, Wert rechtsbündig */\n  .cm-specs[data-v=\"leaders\"] .cm-specs__row { display: flex; align-items: baseline; gap: 8px; padding: 9px 0; }\n  .cm-specs[data-v=\"leaders\"] dt { flex: 0 0 auto; font-size: 14px; color: #4d4d4d; }\n  .cm-specs[data-v=\"leaders\"] .cm-specs__row::after { content: none; }\n  .cm-specs[data-v=\"leaders\"] dt::after { content: \"\"; display: inline-block; }\n  .cm-specs[data-v=\"leaders\"] .cm-specs__row { position: relative; }\n  .cm-specs[data-v=\"leaders\"] dd { order: 3; flex: 0 1 auto; text-align: right; font-size: 14px; font-weight: 700; color: #212121; max-width: 62%; }\n  .cm-specs[data-v=\"leaders\"] .cm-specs__row > dt + dd { margin-left: auto; }\n  .cm-specs[data-v=\"leaders\"] .cm-specs__row::before { content: \"\"; order: 2; flex: 1 1 auto; min-width: 16px; border-bottom: 1.5px dotted #c9c4bc; transform: translateY(-4px); }\n  /* 3 grid: 2er-Raster, Bezeichnung klein über dem Wert, feine Linien */\n  .cm-specs[data-v=\"grid\"] .cm-specs__list { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid #e7e4e0; }\n  .cm-specs[data-v=\"grid\"] .cm-specs__row { padding: 12px 12px 12px 0; border-bottom: 1px solid #e7e4e0; display: flex; flex-direction: column; gap: 3px; position: relative; }\n  .cm-specs[data-v=\"grid\"] .cm-specs__row:nth-child(even) { padding-left: 14px; }\n  .cm-specs[data-v=\"grid\"] .cm-specs__row:nth-child(even)::before { content: \"\"; position: absolute; left: 0; top: 12px; bottom: 12px; width: 1px; background: #e7e4e0; }\n  .cm-specs[data-v=\"grid\"] dt { font-size: 11.5px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #8a847c; }\n  .cm-specs[data-v=\"grid\"] dd { font-size: 14.5px; font-weight: 700; line-height: 1.35; color: #212121; }\n  /* 4 gold: Bezeichnung klein über dem Wert, links eine feine Goldlinie, luftig */\n  .cm-specs[data-v=\"gold\"] .cm-specs__list { display: flex; flex-direction: column; gap: 14px; padding: 4px 0 4px 16px; border-left: 2px solid transparent; border-image: linear-gradient(180deg, #e6cf93, #a8853f) 1; }\n  .cm-specs[data-v=\"gold\"] .cm-specs__row { display: flex; flex-direction: column; gap: 2px; }\n  .cm-specs[data-v=\"gold\"] dt { font-size: 12px; color: #8a847c; }\n  .cm-specs[data-v=\"gold\"] dd { font-size: 15px; font-weight: 700; color: #212121; line-height: 1.35; }\n  @media (min-width: 750px) { .cm-specs__title { font-size: 24px; } }\n</style>\n<script>(function(){ var v = new URLSearchParams(location.search).get('spec'); if (v) document.querySelectorAll('.cm-specs').forEach(function(n){ n.setAttribute('data-v', v); }); })();</script>\n{%- endunless -%}",
