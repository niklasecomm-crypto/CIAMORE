        "code": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Wasserfest Banner – Mobile & Desktop</title>\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n  <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@500;700&display=swap\" rel=\"stylesheet\">\n  <style>\n    body {\n      font-family: 'Inter', sans-serif;\n      color: #333;\n    }\n    .mobile-banner-wrapper {\n      display: block;\n    }\n    @media screen and (min-width: 768px) {\n      .mobile-banner-wrapper {\n        display: none;\n      }\n    }\n    .waterproof-banner {\n      background-color: #F0EAE0;\n      color: #333 !important;\n      padding: 5px 25px 5px 15px;\n      border-radius: 0 15px 15px 0;\n      display: inline-flex;\n      align-items: center;\n      font-size: 12px;\n      margin-left: -16px;\n      font-family: 'Inter', sans-serif;\n      font-weight: 500;\n    }\n    .waterproof-banner .text-container {\n      position: relative;\n      top: 2px;\n    }\n    .waterproof-banner .text-wasserfest {\n      font-weight: 700;\n      font-size: 14px;\n      color: #333 !important;\n    }\n    .waterproof-banner .text-keinabfaerben {\n      font-weight: 500;\n      color: #333 !important;\n    }\n    .desktop-waterproof-banner-wrapper {\n      display: none;\n    }\n    @media screen and (min-width: 768px) {\n      .desktop-waterproof-banner-wrapper {\n        display: block;\n        width: 100vw;\n        position: relative;\n        left: 50%;\n        transform: translateX(-50%);\n        margin: 0;\n        padding: 0;\n      }\n      .desktop-waterproof-banner {\n        background-color: #F0EAE0;\n        color: #333;\n        padding: 7px 24px 7px 16px;\n        border-radius: 0 18px 18px 0;\n        display: inline-flex;\n        align-items: center;\n     