    "section_custom_code_tRHxm8": {
      "type": "section-custom-code",
      "name": "Custom code",
      "settings": {
        "code": "<!-- Schriftart: Inter 500 (Medium) & 700 (Bold) -->\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@500;700&display=swap\" rel=\"stylesheet\">\n\n<style>\n.shipping-accordion {\n  padding: 24px 0;\n  font-family: 'Inter', sans-serif;\n  font-weight: 500;\n}\n\n.shipping-accordion summary {\n  list-style: none;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-weight: 700; /* bold */\n  cursor: pointer;\n  font-size: 14px;\n  margin-bottom: -8px;\n  margin-top: -8px;\n  font-family: 'Inter', sans-serif;\n}\n\n.shipping-accordion summary::-webkit-details-marker {\n  display: none;\n}\n\n.shipping-accordion .icon {\n  font-size: 22px;\n  font-weight: 200;\n  display: inline-block;\n  transition: transform 0.3s ease-in-out;\n  line-height: 1;\n}\n\n.shipping-accordion[open] .icon {\n  transform: rotate(360deg);\n}\n\n.shipping-content {\n  margin-top: 36px;\n  font-family: 'Inter', sans-serif;\n  font-weight: 500;\n}\n\n.shipping-content h2 {\n  font-size: 20px;\n  font-weight: 700; /* bold */\n  margin-bottom: 16px;\n  margin-top: 36px;\n}\n\n.shipping-content .subtitle {\n  font-size: 14px;\n  color: #000;\n  margin-bottom: 34px;\n  margin-top: 12px;\n  font-weight: 500;\n}\n\n.shipping-content .shipping-zone {\n  font-size: 18px;\n  font-weight: 700; /* bold */\n  margin-bottom: 12px;\n}\n\n.shipping-table {\n  width: 100%;\n  margin-bottom: 20px;\n  margin-top: 26px;\n  border-collapse: collapse;\n  font-size: 14px;\n  font-family: 'Inter', sans-serif;\n  font-weight: 500;\n}\n\n.shipping-table td {\n  padding: 6px 0;\n}\n\n.shipping-table tr + tr td {\n  border-top: 1px solid #eee;\n}\n</style>\n\n<details class=\"shipping-accordion\">\n  <summary>\n    Versand\n    <span class=\"icon\">+</span>\n  </summary>\n  <div class=\"shipping-content\">\n    <h2>Versandkosten &amp; Versanddauer</h2>\n    <p class=\"subtitle\">Der Versand erfolgt durch die Deutsche Post bzw. DHL</p>\n\n    <p class=\"shipping-zone\">Innerhalb Deutschland: 1–3 Werktage*</p>\n    <table class=\"shipping-table\">\n      <tr>\n        <td>Bis 39 €</td>\n        <td>3,90 € Versandkosten</td>\n      </tr>\n      <tr>\n        <td>Ab 39 €</td>\n        <td>Kostenlos</td>\n      </tr>\n    </table>\n\n    <p class=\"shipping-zone\">Europäische Union: 3–9 Werktage*</p>\n    <table class=\"shipping-table\">\n      <tr>\n        <td>Bis 79 €</td>\n        <td>6,90 € Versandkosten</td>\n      </tr>\n      <tr>\n        <td>Ab 79 €</td>\n        <td>Kostenlos</td>\n      </tr>\n    </table>\n\n    <p class=\"shipping-zone\">Schweiz &amp; Liechtenstein: 4–10 Werktage*</p>\n    <table class=\"shipping-table\">\n      <tr>\n        <td>Bis 99 €</td>\n        <td>7,90 € Versandkosten</td>\n      </tr>\n      <tr>\n        <td>Ab 99 €</td>\n        <td>Kostenlos</td>\n      </tr>\n    </table>\n  </div>\n</details>\n\n<script>\n  document.querySelectorAll('.shipping-accordion').forEach(el => {\n    const icon = el.querySelector('.icon');\n\n    // Initial: korrektes Symbol setzen\n    icon.textContent = el.open ? '−' : '+';\n\n    el.addEventListener('toggle', () => {\n      icon.textContent = el.open ? '−' : '+';\n    });\n  });\n</script>",
        "width": "wrapper",
