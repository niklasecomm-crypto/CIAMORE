            "code": "{% assign material_text = product.metafields.custom.material %}\n\n{% if material_text != blank %}\n  <p class=\"custom-text\">{{ material_text }}</p>\n{% endif %}\n\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@500&display=swap');\n\n  /* Desktop-Styles (Standard ab 768px) */\n  .custom-text {\n    padding-top: 0px;       /* Abstand oben (Desktop) */\n    padding-bottom: 5px;    /* Abstand unten (Desktop) */\n    margin-top: 5px;\n    margin-bottom: -14px;\n    font-size: 11px;        /* Schriftgröße (Desktop) */\n    color: #9d9d9d;\n    font-family: 'Inter', sans-serif;\n    font-weight: 500;\n  }\n\n  /* Mobile-Styles (bis 767px) */\n  @media screen and (max-width: 767px) {\n    .custom-text {\n      padding-top: 0px;       /* Abstand oben (Mobile) */\n      padding-bottom: 2px;    /* Abstand unten (Mobile) */\n      font-size: 10px;        /* Schriftgröße (Mobile) */\n    }\n  }\n</style>",
