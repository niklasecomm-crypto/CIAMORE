<script>
/* Bundle-Leiste: Hinweis, wie viele Produkte noch fehlen ("Noch 1 Produkt wählen") */
(function () {
  var MIN = { '28202': 4, '28201': 5, '28353': 3 };
  function need() {
    var m = location.pathname.match(/bundle\/(\d+)/); if (m && MIN[m[1]]) return MIN[m[1]];
    var r = document.querySelector('.bogos-step-items-product-require-title'); var x = r && r.textContent.match(/\d+/); return x ? +x[0] : 0;
  }
  function count() {
    var n = 0; document.querySelectorAll('.bogos-bp-widget .bogos-step-item').forEach(function (it) { var q = it.querySelector('.bogos-bp-quantity-input'); n += q ? (parseInt(q.value, 10) || 1) : 1; }); return n;
  }
  function upd() {
    var head = document.querySelector('.bogos-bp-widget .bogos-bp-widget-header'); if (!head) return;
    var req = need(); if (!req) return;
    var el = head.parentNode.querySelector(':scope > .cm-bp-left');
    if (!el) { el = document.createElement('div'); el.className = 'cm-bp-left'; el.setAttribute('aria-live', 'polite'); head.insertAdjacentElement('afterend', el); }
    var left = req - count();
    var txt = left > 0 ? 'Noch ' + left + (left === 1 ? ' Produkt' : ' Produkte') + ' wählen' : '';
    if (el.textContent !== txt) el.textContent = txt;
    el.hidden = !txt;
  }
  var t = 0; new MutationObserver(function (ms) { if (ms.every(function (m) { return m.target.closest && m.target.closest('.cm-bp-left'); })) return; clearTimeout(t); t = setTimeout(upd, 60); }).observe(document.documentElement, { childList: true, subtree: true, characterData: true, attributes: true, attributeFilter: ['value'] });
  document.addEventListener('input', function (e) { if (e.target.closest && e.target.closest('.bogos-bp-widget')) setTimeout(upd, 30); });
  document.addEventListener('click', function (e) { if (e.target.closest && e.target.closest('.bogos-bp-widget, .bogos-bp-btn-add-product, .bogos-product-add-btn')) setTimeout(upd, 400); });
})();
</script>
<script>
/* Bundle-Fenster: Zurück-Wischen/Zurück-Taste schließt nur das Produkt-Fenster statt das Bundle zu verlassen.
   Außerdem Button-Text wie auf der Produktseite ("In den Warenkorb"). */
(function () {
  var pushed = false;
  function wrapEl() { var m = document.querySelector('.bogos-product-detail-modal'); return m && m.parentElement; }
  function isOpen() { var w = wrapEl(); return !!(w && w.classList.contains('sca-is-visible-fg')); }
  function closeModal() { var b = document.querySelector('.bogos-product-detail-modal .bogos-product-modal-close-btn'); if (b) b.click(); }
  function sync() {
    var open = isOpen();
    if (open && !pushed) { try { history.pushState({ cmBogosModal: 1 }, ''); pushed = true; } catch (e) {} }
    if (!open && pushed) { pushed = false; if (history.state && history.state.cmBogosModal) { try { history.back(); } catch (e) {} } }
    var add = document.querySelector('.bogos-product-detail-modal .bogos-product-add-btn');
    if (add) { var t = add.textContent.trim(); var n = /^in den warenkorb$/i.test(t) ? 'In den Warenkorb' : (/^ausverkauft$/i.test(t) ? 'Ausverkauft' : t); if (n !== t) add.textContent = n; }
  }
  window.addEventListener('popstate', function () { if (pushed && isOpen()) { pushed = false; closeModal(); } });
  var t = 0; new MutationObserver(function () { clearTimeout(t); t = setTimeout(sync, 30); }).observe(document.documentElement, { subtree: true, childList: true, attributes: true, attributeFilter: ['class'] });
})();
</script>
<script>
/* Cookie-Banner kompakt (Shopify-Banner): kurzer Text, "Okay" zuerst, "Einstellungen" als Link in der Textzeile. */
(function () {
  function fix() {
    var d = document.querySelector('.shopify-pc__banner__dialog'); if (!d) return;
    var p = d.querySelector('.shopify-pc__banner__body p'); var a = p && p.querySelector('a');
    if (p && a && !p.dataset.cm) { p.dataset.cm = 1; a.textContent = 'Datenschutz'; p.textContent = 'Wir nutzen Cookies, um dir das beste Erlebnis zu bieten. '; p.appendChild(a); }
    var m = d.querySelector('.shopify-pc__banner__btn-manage-prefs');
    if (p && m && !p.contains(m)) { var dot = document.createElement('span'); dot.className = 'cm-ck-dot'; dot.textContent = '·'; p.appendChild(dot); p.appendChild(m); var sp = m.querySelector('span'); (sp || m).textContent = 'Einstellungen'; }
    var ok = d.querySelector('.shopify-pc__banner__btn-accept'); if (ok && ok.textContent.trim() !== 'Okay') ok.textContent = 'Okay';
