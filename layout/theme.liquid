  <script>
/* BOGOS Geschenk-Fenster: aus den Varianten-Karten eine Auswahl im Shop-Stil bauen
   (Farbe, Größe, ein Button). Beim Bestätigen wird der passende BOGOS-Button geklickt.
   Schlägt hier etwas fehl, bleibt das Original-Karussell von BOGOS sichtbar. */
(function () {
  var COLORS = /^(gold|platin|silber|ros[eé]gold|ros[eé])$/i;
  function t(el, sel) { var e = el.querySelector(sel); return e ? e.textContent.replace(/\s+/g, ' ').trim() : ''; }
  function uniq(a) { return a.filter(function (v, i) { return a.indexOf(v) === i; }); }
  function read(offer) {
    return [].slice.call(offer.querySelectorAll('.bogos-offer-gift-item')).map(function (c) {
      var parts = t(c, '.bogos-gift-variant-title').split('/').map(function (s) { return s.trim(); }).filter(Boolean);
      var color = parts.length && COLORS.test(parts[0]) ? parts.shift() : '';
      var img = c.querySelector('.bogos-gift-item-image');
      return { name: t(c, '.bogos-gift-product-title'), color: color, size: parts.join(' / '), img: img ? img.currentSrc || img.src : '', old: t(c, '.bogos-gift-item-compare-price'), btn: c.querySelector('.bogos-gift-item-add-container button') };
    }).filter(function (i) { return i.btn; });
  }
  /* Wie viele Geschenke darf der Kunde mitnehmen? BOGOS schreibt das in
     seinen eigenen Hinweis ("You can add 2 gift product(s)"), den wir
     optisch ausblenden. Ohne Angabe gehen wir von einem aus. */
  function allowed(offer) {
    var badge = offer.querySelector('.bogos-badge-title');
    var m = badge && badge.textContent.match(/(\d+)/);
    return m ? parseInt(m[1], 10) : 1;
  }

  /* Ab welchem Warenkorbwert gibt es dieses Geschenk? Steht in den
     BOGOS-Daten am jeweiligen Angebot. Damit sortieren wir die Geschenke
     so, wie der Kunde sie beim normalen Einkaufen erreichen würde: erst
     das Gratis-Geschenk ab 50 €, darunter das VIP-Geschenk ab 79 €. */
  function schwelle(name) {
    try {
      var offers = (window.fgData && window.fgData.offers) || [];
      for (var i = 0; i < offers.length; i++) {
        var gp = offers[i].gift_products || [];
        for (var j = 0; j < gp.length; j++) {
          if (String(gp[j].title || '').indexOf(name) > -1) {
            var c = (offers[i].offer_conditions || [])[0];
            var v = c && c.min_amount != null ? parseFloat(c.min_amount) : NaN;
            if (!isNaN(v)) return v;
          }
        }
      }
    } catch (e) {}
    return Infinity;   /* unbekannt: hinten anstellen, Reihenfolge bleibt */
  }

  /* Stehen dem Kunden mehrere verschiedene Geschenk-PRODUKTE gleichzeitig
     zu (etwa Gratis-Geschenk ab 50 € und VIP-Geschenk ab 79 €, beide auf
     einmal freigeschaltet), wirft BOGOS sie in einen einzigen Block. Früher
     baute der Code daraus einen Umschalter, das las sich wie "entweder
     oder", obwohl der Kunde beide bekommt. Jetzt wird pro Produkt ein
     eigener Block gebaut, jeder mit eigener Auswahl und eigenem Button.
     Ist wirklich nur eines von mehreren erlaubt, bleibt der Umschalter. */
  /* Sobald ein Geschenk gewählt ist, nimmt BOGOS dessen Varianten komplett
     aus dem Fenster. Aus dem Fenster mit zwei Geschenken wurde dadurch
     mitten im Vorgang wieder das Fenster mit einem Geschenk, inklusive
     anderer Überschrift. Deshalb merken wir uns, was in diesem geöffneten
     Fenster schon angeboten wurde, und lassen das gewählte als erledigten
     Kasten stehen, solange noch eines offen ist. Ist nichts mehr offen,
     wird die Merkliste geleert und BOGOS schließt das Fenster wie gehabt. */
  var gezeigt = {};   /* Produkte, die dieses Fenster angeboten hat */
  var auswahl = {};   /* zuletzt gewählte Variante je Produkt */
  var laeuft = {};    /* Produkte, deren Hinzufügen gerade läuft */
  var ausKorb = {};   /* Varianten der Geschenke, aus dem Warenkorb gelesen */
  var korbLaeuft = false;

  /* Welche Variante liegt im Warenkorb? Die Merkliste oben kennt nur, was
     in diesem Fenster angetippt wurde, und ist nach einem Seitenwechsel
     leer. Der Warenkorb weiß es immer, deshalb lesen wir dort nach. */
  function korbLesen(dann) {
    if (korbLaeuft) return;
    korbLaeuft = true;
    fetch('/cart.js', { cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(function (c) {
        var neu = {};
        (c.items || []).forEach(function (it) {
          if (it.final_price !== 0) return;          /* nur Geschenke */
          var teile = String(it.variant_title || '').split('/').map(function (x) { return x.trim(); }).filter(Boolean);
          var farbe = teile.length && COLORS.test(teile[0]) ? teile.shift() : '';
          neu[String(it.product_title || '')] = { color: farbe, size: teile.join(' / ') };
        });
        ausKorb = neu;
        korbLaeuft = false;
        if (dann) dann();
      })
      .catch(function () { korbLaeuft = false; });
  }

  function variante(name) {
    if (auswahl[name]) return auswahl[name];
    var treffer = Object.keys(ausKorb).filter(function (t) { return t.indexOf(name) > -1; })[0];
    return treffer ? ausKorb[treffer] : null;
  }

  function build(offer) {
    var all = read(offer); if (!all.length) return;
    var namen = uniq(all.map(function (i) { return i.name; }));
    namen.forEach(function (n) {
      if (gezeigt[n]) return;
      var erst = all.filter(function (i) { return i.name === n; })[0];
      gezeigt[n] = { name: n, img: erst.img, old: erst.old };
    });

    var darf = allowed(offer);
    var teile = [];
    if (namen.length > 1 && darf >= namen.length) {
      namen.forEach(function (n) { teile.push({ name: n, items: all.filter(function (i) { return i.name === n; }) }); });
    } else {
      teile.push({ name: namen[0], items: all });
    }
    var fehlt = false;
    Object.keys(gezeigt).forEach(function (n) {
      if (namen.indexOf(n) === -1) {
        delete laeuft[n];   /* liegt im Warenkorb, Wartezustand beenden */
        if (!variante(n)) fehlt = true;
        teile.push({ name: n, fertig: gezeigt[n] });
