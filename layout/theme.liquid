<script>
/* Akkordeons (Produktseite Versand/Rücksendung + Startseiten-FAQ): Höhen-Animation, immer nur eins offen */
document.addEventListener('DOMContentLoaded', function () {
  var SEL = '.template-product details.shipping-accordion, .template-product details.return-accordion, details.cm-faq__item';
  function groupOf(d) { var g = d.closest('[data-cm-acc-group]'); return g ? g.querySelectorAll('details.cm-faq__item') : document.querySelectorAll('.template-product details.shipping-accordion, .template-product details.return-accordion'); }
  function closeAcc(d) {
    var body = d.querySelector(':scope > .cm-acc-body'); if (!body || !d.classList.contains('cm-acc-open')) return;
    body.style.height = body.scrollHeight + 'px'; body.offsetHeight;
    d.classList.remove('cm-acc-open'); body.style.height = '0px';
  }
  function openAcc(d) {
    var body = d.querySelector(':scope > .cm-acc-body'), inner = body.firstChild;
    d.classList.add('cm-acc-open'); body.style.height = inner.scrollHeight + 'px';
    setTimeout(function () { if (d.classList.contains('cm-acc-open')) body.style.height = 'auto'; }, 320);
  }
  document.querySelectorAll(SEL).forEach(function (d) {
    var sum = d.querySelector('summary'); if (!sum || d.__cmAcc) return; d.__cmAcc = true;
    var body = document.createElement('div'); body.className = 'cm-acc-body';
    var inner = document.createElement('div'); inner.className = 'cm-acc-inner'; body.appendChild(inner);
    while (sum.nextSibling) inner.appendChild(sum.nextSibling);
    d.appendChild(body);
    var open = d.hasAttribute('open'); body.style.height = open ? 'auto' : '0px'; d.classList.toggle('cm-acc-open', open); d.setAttribute('open', '');
    sum.addEventListener('click', function (e) {
      e.preventDefault();
      if (d.classList.contains('cm-acc-open')) { closeAcc(d); return; }
      groupOf(d).forEach(function (o) { if (o !== d) closeAcc(o); });
      openAcc(d);
    });
  });
});
</script>
