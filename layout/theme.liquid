<script>
/* Bundle-Seiten (BOGOS): Produkt-Fenster beim Antippen wie die Produktseite (Material, Swatches, Größen + Größentabelle, Produktinfo-Tabelle) */
(function () {
  var SW_RAW = window.__cmSwatchList || '';
  var FILES = window.__cmFilesBase || '/cdn/shop/files/';
  var SWNAMES = (window.__cmSwatchNames || 'Farbe, Veredelung').split(',').map(function (s) { return s.trim().toLowerCase(); });
  var map = {};
  SW_RAW.split(/\n/).forEach(function (l) { var i = l.indexOf(':'); if (i < 1) return; var k = l.slice(0, i).trim().toLowerCase(), v = l.slice(i + 1).trim(); if (k && v) map[k] = v; });
  function swStyle(val) {
    var v = map[String(val).toLowerCase()]; if (!v) return '';
    if (/^#|^rgb/i.test(v)) return 'background:' + v;
    return 'background-image:url(' + FILES + v.replace(/\.(png|jpe?g|webp)$/i, function (m) { return '_small' + m; }) + ')';
  }
  function isSize(name) { return /gr(ö|oe)(ß|ss)e|size/i.test(name); }
  var pc = {}, mc = {};
  function getProduct(h) { if (!pc[h]) pc[h] = fetch('/products/' + h + '.js').then(function (r) { return r.json(); }); return pc[h]; }
  function getMeta(h) { if (!mc[h]) mc[h] = fetch('/products/' + h + '?view=cm-meta').then(function (r) { return r.json(); }).catch(function () { return {}; }); return mc[h]; }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function handleOf(modal) { var l = modal.querySelector('.bogos-product-page-link'); var m = l && (l.getAttribute('href') || '').match(/\/products\/([^/?#]+)/); return m && m[1]; }

  function openChart(modal, html) {
    var o = document.createElement('div'); o.className = 'cm-bvo-chart';
    o.innerHTML = '<div class="cm-bvo-chart__box" role="dialog" aria-label="Größentabelle"><button type="button" class="cm-bvo-chart__x" aria-label="Schließen">&times;</button><div class="cm-bvo-chart__rte">' + html + '</div></div>';
    o.addEventListener('click', function (e) { if (e.target === o || e.target.closest('.cm-bvo-chart__x')) { e.preventDefault(); e.stopPropagation(); o.remove(); } });
    modal.appendChild(o);
  }

  function extras(modal, h) {
    if (modal.__cmXh === h) return; modal.__cmXh = h;
    modal.querySelectorAll('.cm-bm-mat, .cm-bm-specs').forEach(function (e) { e.remove(); });
    var desc = modal.querySelector('.bogos-product-description'); if (desc) desc.classList.remove('cm-bm-hide');
    getMeta(h).then(function (d) {
      if (handleOf(modal) !== h) return;
      var title = modal.querySelector('.bogos-product-title');
      if (d.material && title && !modal.querySelector('.cm-bm-mat')) { var s = document.createElement('div'); s.className = 'cm-bm-mat'; s.textContent = d.material; title.insertAdjacentElement('beforebegin', s); }
      if (d.specs && d.specs.indexOf('cm-specs__row') > -1 && !modal.querySelector('.cm-bm-specs')) {
        var w = document.createElement('div'); w.className = 'cm-bm-specs'; w.innerHTML = d.specs;
        var anchor = desc || modal.querySelector('.bogos-product-page-link');
        if (anchor) { anchor.insertAdjacentElement('afterend', w); if (desc) desc.classList.add('cm-bm-hide'); }
      }
      modal.__cmChart = d.sizechart || '';
    });
  }

  function build(vc) {
    var modal = vc.closest('.bogos-product-detail-modal'); if (!modal) return;
    var h = handleOf(modal);
    var items = {}, n = 0; vc.querySelectorAll('[data-variant-id]').forEach(function (it) { items[it.getAttribute('data-variant-id')] = it; n++; });
    if (!h) return;
    extras(modal, h);
    if (!n) return;
    var key = h + ':' + Object.keys(items).join(',');
    if (vc.__cmVoKey === key) return; vc.__cmVoKey = key;
    var old = vc.parentNode.querySelector(':scope > .cm-bvo'); if (old) old.remove();
    getProduct(h).then(function (p) {
      if (vc.__cmVoKey !== key || !p || !p.variants || p.variants.length < 2) { vc.classList.remove('cm-bvo-host'); return; }
      var avail = {}; Object.keys(items).forEach(function (id) { avail[id] = items[id].getAttribute('data-check-variant-available') !== '0'; });
      var curEl = vc.querySelector('.active[data-variant-id]') || vc.querySelector('[data-variant-id]');
      var cur = p.variants.find(function (v) { return curEl && String(v.id) === curEl.getAttribute('data-variant-id'); }) || p.variants[0];
      if (!avail[cur.id]) { var fa = p.variants.find(function (v) { return avail[v.id]; }); if (fa) { cur = fa; if (items[fa.id]) setTimeout(function () { items[fa.id].click(); }, 0); } }
      var sel = cur.options.slice();
      var box = document.createElement('div'); box.className = 'cm-bvo';
      p.options.forEach(function (o, oi) {
        var isSw = SWNAMES.indexOf(o.name.toLowerCase()) > -1 && o.values.some(function (v) { return swStyle(v); });
        var g = document.createElement('div'); g.className = 'cm-bvo__group' + (isSw ? ' cm-bvo__group--sw' : ' cm-bvo__group--pill');
        var q = (!isSw && isSize(o.name)) ? ' <button type="button" class="cm-bvo__q" aria-label="Größentabelle">?</button>' : '';
        g.innerHTML = '<div class="cm-bvo__legend"><span class="cm-bvo__name">' + esc(o.name) + ':' + q + '</span> <span class="cm-bvo__val"></span></div><div class="cm-bvo__vals"></div>';
        var vals = g.querySelector('.cm-bvo__vals');
        if (isSw) vals.style.setProperty('--n', o.values.length);
        o.values.forEach(function (val) {
