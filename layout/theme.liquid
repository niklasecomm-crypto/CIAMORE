<script>
/* Veredelung: Position der gleitenden weißen Fläche setzen */
(function () {
  function upd(box, anim) {
    var items = [].slice.call(box.querySelectorAll('tooltip-component'));
    if (!items.length) return;
    var i = items.findIndex(function (t) { var x = t.querySelector('input'); return x && x.checked; });
    if (!anim) box.classList.add('no-anim');
    box.style.setProperty('--n', items.length); box.style.setProperty('--i', Math.max(0, i));
    if (!anim) setTimeout(function () { box.classList.remove('no-anim'); }, 60);
  }
  function all(anim) { document.querySelectorAll('.template-product .radio__fieldset--swatches .radio__buttons').forEach(function (b) { upd(b, anim); }); }
  document.addEventListener('change', function (e) { var b = e.target.closest && e.target.closest('.radio__fieldset--swatches .radio__buttons'); if (b) upd(b, true); });
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { all(false); }); else all(false);
  window.addEventListener('pageshow', function () { all(false); });
})();
</script>
<script>
/* Set-Produkte (cm-multi-pdp): Slider-Pill wie bei Einzelprodukten */
(function () {
  function upd(box, anim) {
    var items = [].slice.call(box.querySelectorAll('.radio__button'));
    if (!items.length) return;
    var i = items.findIndex(function (b) { var x = b.querySelector('input'); return x && x.checked; });
    if (!anim) box.classList.add('no-anim');
    box.style.setProperty('--n', items.length); box.style.setProperty('--i', Math.max(0, i));
    if (!anim) setTimeout(function () { box.classList.remove('no-anim'); }, 60);
  }
  function all(anim) { document.querySelectorAll('.cm-multi-pdp .product__selectors .radio__buttons').forEach(function (b) { upd(b, anim); }); }
  document.addEventListener('change', function (e) { var b = e.target.closest && e.target.closest('.cm-multi-pdp .product__selectors .radio__buttons'); if (b) upd(b, true); });
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { all(false); }); else all(false);
  window.addEventListener('pageshow', function () { all(false); });
  /* Einmalig warten bis die Set-Container im DOM sind, dann initialisieren und Observer stoppen */
  if (!document.querySelectorAll('.cm-multi-pdp .product__selectors .radio__buttons').length) {
    var mo = new MutationObserver(function () {
      if (document.querySelectorAll('.cm-multi-pdp .product__selectors .radio__buttons').length) { mo.disconnect(); all(false); }
    });
    mo.observe(document.documentElement, { childList: true, subtree: true });
  }
})();
</script>
<script>
/* BOGOS: fest eingebaute englische Texte auf Deutsch */
(function(){
  var R=[
    [/^This item:?$/,'Dieser Artikel'],
    [/\((\d+\s?%)\s*OFF\)/g,'($1 Rabatt)'],
    [/\((\d+)\s*products?\)/g,'($1 Produkte)'],
    [/\bitem\(s\)/g,'Artikel'],
    [/^\(s\)$/,''],[/^OFF$/,'Rabatt'],[/^(\d+\s?%)\s*OFF$/i,'$1 Rabatt'],
    [/^(\d+\s+)?items?$/,function(m,a){return (a||'')+'Artikel';}],
    [/^See more/,'Mehr anzeigen'],[/^See product.?s details$/i,'Produktdetails ansehen'],[/^See less$/,'Weniger anzeigen'],
    [/^Get our special offers$/,'Unsere Angebote'],
    [/^Not reached yet$/,'Noch nicht erreicht'],
    [/^Free Shipping$/,'Gratis Versand'],[/^Free Gift$/,'Gratis Geschenk'],[/^VIP Gift$/,'VIP Geschenk'],
    [/^Buy (.+)$/,'Ab $1']
  ];
  function fix(root){
    var w=document.createTreeWalker(root,NodeFilter.SHOW_TEXT),n,t,o;
    while(n=w.nextNode()){
      if(!n.parentElement||/SCRIPT|STYLE/.test(n.parentElement.tagName))continue;
      o=n.nodeValue;t=o.trim();if(!t||!/[A-Za-z]/.test(t))continue;
      var r=t;for(var i=0;i<R.length;i++)r=r.replace(R[i][0],R[i][1]);
      if(r!==t)n.nodeValue=o.replace(t,r);
    }
  }
  function deal(){
    document.querySelectorAll('.bogos-step-item-discount-price,.bogos-bp-total-discount-price').forEach(function(d){
      var o=d.nextElementSibling;if(!o||!/original-price/.test(o.className))return;
      var on=o.style.display!=='none'&&o.textContent.trim()!==''&&o.textContent.trim()!==d.textContent.trim();
      if(d.classList.contains('cm-deal')!==on)d.classList.toggle('cm-deal',on);
      var same=o.textContent.trim()===d.textContent.trim();
      if(o.classList.contains('cm-same')!==same)o.classList.toggle('cm-same',same);
    });
  }
  function run(){document.querySelectorAll('[class*="bogos"]').forEach(function(el){if(!el.parentElement.closest('[class*="bogos"]'))fix(el);});deal();}
  var q=0;new MutationObserver(function(ms){if(q)return;if(ms.every(function(m){return m.type==='attributes'&&!(m.target.closest&&m.target.closest('[class*="bogos"]'));}))return;q=1;setTimeout(function(){q=0;run();},30);}).observe(document.documentElement,{childList:true,subtree:true,characterData:true,attributes:true,attributeFilter:["style"]});
  document.addEventListener('DOMContentLoaded',run);setTimeout(run,1500);
})();
</script>
<script>
  window.__cmSwatchList = {{ settings.swatch_color_list | json }};
  window.__cmFilesBase = '{{ 'x.png' | file_url | split: 'x.png' | first }}';
  window.__cmSwatchNames = {{ 'general.swatches.color' | t | json }};
