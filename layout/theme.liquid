    teile.forEach(function (t, i) { t.s = schwelle(t.name); t.idx = i; });
    teile.sort(function (a, b) { return a.s === b.s ? a.idx - b.idx : a.s - b.s; });

    var sig = teile.map(function (t) {
      var w = variante(t.name) || {};
      return t.name + (t.fertig ? ':fertig:' + (w.color || '') + '/' + (w.size || '') : '');
    }).join(';') + '#' +
      all.map(function (i) { return [i.name, i.color, i.size, i.btn.disabled ? 'x' : 'o'].join('|'); }).join(';');
    if (offer.__cmSig === sig && offer.querySelector('.cm-gift')) return;
    offer.__cmSig = sig;
    /* Scrollstand merken, sonst springt der Inhalt beim Neuaufbau. */
    var scroller = offer.closest('.bogos-gift-slider-modal');
    var stand = scroller ? scroller.scrollTop : 0;
    [].forEach.call(offer.querySelectorAll('.cm-gift'), function (b) { b.remove(); });
    var frag = document.createDocumentFragment();
    teile.forEach(function (t) {
      var box = t.fertig ? buildFertig(t.fertig) : buildOne(t.items, offer);
      if (box) frag.appendChild(box);
    });
    if (!frag.childNodes.length) return;
    offer.insertBefore(frag, offer.firstChild);
    offer.classList.add('cm-gift-on');
    if (scroller && stand) scroller.scrollTop = stand;
  }

  /* Kasten für ein Geschenk, das in diesem Fenster schon genommen wurde. */
  function buildFertig(info) {
    function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    /* Gewählte Variante mit anzeigen, in derselben Schreibweise wie auf der
       Produktseite, damit der Kunde sieht, was im Warenkorb liegt. */
    var gew = variante(info.name) || {};
    var zeilen = '';
    if (gew.color) zeilen += '<div class="cm-gift__label"><b>Veredelung:</b><small>' + esc(gew.color) + '</small></div>';
    if (gew.size) zeilen += '<div class="cm-gift__label"><b>Größe:</b><small>' + esc(gew.size) + '</small></div>';
    var box = document.createElement('div');
    box.className = 'cm-gift cm-gift--fertig';
    box.innerHTML = '<div class="cm-gift__top">' + (info.img ? '<img class="cm-gift__img" src="' + esc(info.img) + '" alt="">' : '') +
      '<div><p class="cm-gift__name">' + esc(info.name) + '</p><div class="cm-gift__price"><span class="cm-gift__free">Gratis</span>' +
      (info.old ? '<span class="cm-gift__old">' + esc(info.old) + '</span>' : '') + '</div></div></div>' +
      zeilen +
      '<button type="button" class="cm-gift__cta" disabled>Liegt im Warenkorb</button>';
    return box;
  }

  function buildOne(items, offer) {
    /* Getroffene Auswahl überlebt einen Neuaufbau. BOGOS baut das Fenster
       beim Hinzufügen neu, vorher sprang die Veredelung dadurch auf Gold
       zurück, während im Hintergrund die richtige Variante gelegt wurde. */
    var merk = auswahl[items[0].name] || {};
    var sel = { name: items[0].name, color: merk.color || items[0].color, size: merk.size || items[0].size };
    var box = document.createElement('div'); box.className = 'cm-gift';
    function pick() {
      var pool = items.filter(function (i) { return i.name === sel.name; });
      if (!pool.some(function (i) { return i.color === sel.color; })) sel.color = pool[0].color;
      pool = pool.filter(function (i) { return i.color === sel.color; });
      var hit = pool.filter(function (i) { return i.size === sel.size; })[0] || pool[0];
      sel.size = hit.size; return hit;
    }
    function row(label, value) { return '<div class="cm-gift__label"><b>' + label + ':</b>' + (value ? '<small>' + value + '</small>' : '') + '</div>'; }
    var prevColor = 0;
    function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function render() {
      var cur = pick();
      var names = uniq(items.map(function (i) { return i.name; }));
      var byName = items.filter(function (i) { return i.name === sel.name; });
      var colors = uniq(byName.map(function (i) { return i.color; })).filter(Boolean);
      var sizes = byName.filter(function (i) { return i.color === sel.color && i.size; });
      var h = '<div class="cm-gift__top">' + (cur.img ? '<img class="cm-gift__img" src="' + esc(cur.img) + '" alt="">' : '') +
        '<div><p class="cm-gift__name">' + esc(cur.name) + '</p><div class="cm-gift__price"><span class="cm-gift__free">Gratis</span>' + (cur.old ? '<span class="cm-gift__old">' + esc(cur.old) + '</span>' : '') + '</div></div></div>';
      if (names.length > 1) h += row('Geschenk') + '<div class="cm-gift__seg">' + names.map(function (n) { return '<button type="button" data-k="name" data-v="' + esc(n) + '" class="' + (n === sel.name ? 'is-on' : '') + '">' + esc(n) + '</button>'; }).join('') + '</div>';
      var ci = Math.max(0, colors.indexOf(sel.color));
      if (colors.length > 1) h += row('Veredelung', esc(sel.color)) + '<div class="cm-gift__seg cm-gift__seg--color" style="--n:' + colors.length + ';--i:' + prevColor + '">' + colors.map(function (c) { return '<button type="button" data-k="color" data-v="' + esc(c) + '" class="' + (c === sel.color ? 'is-on' : '') + '"><span class="cm-gift__dot cm-gift__dot--' + esc(c.toLowerCase()) + '" style="background-image:url(/cdn/shop/files/' + encodeURIComponent(c) + '-png_small.png)"></span>' + esc(c) + '</button>'; }).join('') + '</div>';
      if (sizes.length > 1) h += row('Größe', esc(sel.size)) + '<div class="cm-gift__pills">' + sizes.map(function (i) { return '<button type="button" data-k="size" data-v="' + esc(i.size) + '" class="' + (i.size === sel.size ? 'is-on' : '') + '">' + esc(i.size) + '</button>'; }).join('') + '</div>';
      var wartet = !!laeuft[sel.name];
      var aus = wartet || cur.btn.disabled;
      var text = wartet ? 'Wird hinzugefügt …' : (cur.btn.disabled ? 'Bereits gewählt' : 'Gratis hinzufügen');
      h += '<button type="button" class="cm-gift__cta"' + (aus ? ' disabled' : '') + '>' + text + '</button>';
      box.innerHTML = h;
      var seg = box.querySelector('.cm-gift__seg--color');
      if (seg) { void seg.offsetWidth; seg.style.setProperty('--i', ci); }
      prevColor = ci;
    }
    box.addEventListener('click', function (e) {
      var b = e.target.closest('button'); if (!b) return;
      if (b.classList.contains('cm-gift__cta')) {
        var cur = pick();
        if (cur.btn.disabled || laeuft[sel.name]) return;
        laeuft[sel.name] = Date.now();
        auswahl[sel.name] = { color: cur.color, size: cur.size };
        b.disabled = true; b.textContent = 'Wird hinzugefügt …';
        cur.btn.click();
        /* Notnagel, falls BOGOS gar nicht reagiert: Zustand wieder freigeben. */
        setTimeout(function () {
          if (laeuft[sel.name]) { delete laeuft[sel.name]; offer.__cmSig = ''; run(); }
        }, 8000);
        return;
      }
      sel[b.getAttribute('data-k')] = b.getAttribute('data-v');
      auswahl[sel.name] = { color: sel.color, size: sel.size };
      render();
    });
    render();
    return box;
  }
  function run() {
    var pop = document.getElementById('freegifts-main-popup-container'); if (!pop) return;
    try {
      /* Fenster zu (BOGOS setzt visibility auf hidden) oder kein Geschenk
         mehr drin: eigene Kästen entfernen und Merkliste leeren, damit
         beim nächsten Öffnen von vorne aufgebaut wird und kein veralteter
         Kasten stehen bleibt. */
      var zu = getComputedStyle(pop).visibility === 'hidden';
      if (zu || !pop.querySelector('.bogos-offer-gift-item')) {
        gezeigt = {}; auswahl = {}; laeuft = {}; ausKorb = {};
        [].forEach.call(pop.querySelectorAll('.cm-gift'), function (b) { b.remove(); });
        [].forEach.call(pop.querySelectorAll('.cm-gift-on'), function (o) { o.classList.remove('cm-gift-on'); o.__cmSig = ''; });
      }
      /* Manche Modal-Skripte sperren das Scrollen, indem sie touchmove auf
         dem Dokument abfangen. Innerhalb des Geschenk-Fensters lassen wir
         das Ereignis nicht weiterlaufen, damit der Inhalt scrollbar bleibt. */
      if (!pop.__cmTouch) {
        pop.__cmTouch = true;
        pop.addEventListener('touchmove', function (e) { e.stopPropagation(); }, { passive: true });
      }
      [].forEach.call(pop.querySelectorAll('.bogos-slider-offer'), build);

      /* Überschrift und Unterzeile richten sich danach, wie viele Geschenke
         gerade im Fenster stehen. */
      var anzahl = pop.querySelectorAll('.cm-gift').length;
      var titelText = anzahl > 1 ? 'Deine Gratis-Geschenke' : 'Dein Gratis-Geschenk';
      var subText = anzahl > 1
        ? 'Du hast ' + anzahl + ' Geschenke frei. Wähle je eine Variante, wir legen beide kostenlos dazu.'
        : 'Wähle deine Variante, wir legen es kostenlos dazu.';

      var title = pop.querySelector('#bogos-gift-popup-title');
      if (title && title.textContent.trim() !== titelText) title.textContent = titelText;

      var head = pop.querySelector('.bogos-gifts-slider-header');
      var sub = pop.querySelector('.cm-gift__sub');
      if (!sub && head) { sub = document.createElement('p'); sub.className = 'cm-gift__sub'; head.parentNode.insertBefore(sub, head.nextSibling); }
      if (sub && sub.textContent !== subText) sub.textContent = subText;
    } catch (err) { [].forEach.call(pop.querySelectorAll('.cm-gift-on'), function (o) { o.classList.remove('cm-gift-on'); }); }
  }
  var queued = false;
  new MutationObserver(function () { if (queued) return; queued = true; requestAnimationFrame(function () { queued = false; run(); }); }).observe(document.documentElement, { childList: true, subtree: true });
  run();
})();
  </script>
  <script>
/* Back-in-Stock "Benachrichtige mich, wenn verfügbar".
   Einzelprodukt: Klaviyos BIS-Button + optionales Grössen-Dropdown (unverändert).
   Set/Bundle (Clover-Sets, Kombi-Sets): eigenes Shop-Popup, in dem der Kunde pro
   Komponente die Veredelung wählt, E-Mail eingibt und abschickt. Die Anmeldung läuft
   direkt über Klaviyos Client-Endpoint auf genau die gewählte Set-Variante. */
(function () {
  if (!document.querySelector('.template-product')) return;

  var KL_KEY = 'R99EUf';            /* öffentlicher Klaviyo-Schlüssel (Site-ID) */
  var KL_LIST = 'SU9Niz';           /* E-Mail-Liste für die Newsletter-Checkbox */
  var KL_REV = '2025-01-15';        /* feste Klaviyo-API-Version, damit sich der Weg nicht ungefragt ändert */
  var VAR_PREFIX = '$shopify:::$default:::';

  var product = null, wrap = null, isSet = false, pop = null, busy = false;

  function handle() { var m = /\/products\/([^\/?#]+)/.exec(location.pathname); return m ? m[1] : ''; }
  function scope() {
    var outer = document.querySelector('.product__form__outer');
    if (!outer) return null;
    var sec = outer.closest('.shopify-section, [data-section-type], main') || document;
    return { outer: outer, submit: sec.querySelector('.product__submit') || document.querySelector('[data-product-form] .product__submit') };
  }
  function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]; }); }

  function ensure(s) {
    if (wrap && document.body.contains(wrap)) return wrap;
    if (!s.submit) return null;
    wrap = s.submit.querySelector('.cm-notify');
    if (wrap) return wrap;
    wrap = document.createElement('div');
    /* Einheitlich fuer Einzelprodukte UND Sets: ein eigener Button, der unser Popup oeffnet.
       Der versteckte Anker lenkt Klaviyos automatisch eingespritzten Button in unseren
       Wrapper, wo CSS ihn ausblendet. Ohne den Anker setzt Klaviyo sonst einen eigenen,
       ungestylten Button an eine Standardstelle (die haessliche Box). */
    wrap.className = 'cm-notify cm-notify--pop';
    wrap.innerHTML =
      '<button type="button" class="cm-notify__setbtn"><span>Benachrichtige mich, wenn verfügbar</span></button>' +
      '<a href="#" class="klaviyo-bis-trigger cm-notify__btn" tabindex="-1" aria-hidden="true"></a>';
    wrap.querySelector('.cm-notify__setbtn').addEventListener('click', openPopup);
    s.submit.appendChild(wrap);
    return wrap;
  }
  function options(outer) {
    return [].map.call(outer.querySelectorAll('.radio__fieldset'), function (fs) {
      var c = fs.querySelector('input:checked'); return c ? c.value : null;
    });
  }
  function match(opts) {
    if (!product || !opts.length || opts.indexOf(null) >= 0) return undefined;
    return variantByOpts(opts);
  }
  function variantByOpts(vals) {
    if (!product) return undefined;
    return product.variants.filter(function (v) {
      return v.options.length === vals.length && v.options.every(function (o, i) { return o === vals[i]; });
    })[0];
  }
  function update() {
    if (!product) return;
    var s = scope(); if (!s) return;
    var w = ensure(s); if (!w) return;
    var v = match(options(s.outer));
    if (v && v.available === false) { w.classList.add('is-on'); }
    else { w.classList.remove('is-on'); }
  }

  /* ----- Set-Popup ----- */
  function optName(i) {
    var o = product.options[i];
    var n = (typeof o === 'string') ? o : (o && o.name) || ('Option ' + (i + 1));
    return n.replace(/\s*\([^)]*\)\s*$/, '').trim() || n;
  }
  function optValues(i) {
    var seen = {}, out = [];
    product.variants.forEach(function (v) { var val = v.options[i]; if (val != null && !seen[val]) { seen[val] = 1; out.push(val); } });
    return out;
  }
  function buildPopup() {
    if (pop) return pop;
    pop = document.createElement('div');
    pop.className = 'cm-pop';
    pop.setAttribute('hidden', '');
    pop.innerHTML =
      '<div class="cm-pop__backdrop" data-close></div>' +
      '<div class="cm-pop__box" role="dialog" aria-modal="true" aria-label="Benachrichtigung bei Verfügbarkeit">' +
        '<button type="button" class="cm-pop__close" data-close aria-label="Schließen">&times;</button>' +
        '<h2 class="cm-pop__title">Benachrichtige mich, sobald das Produkt wieder verfügbar ist</h2>' +
        '<p class="cm-pop__intro">Stell dein Set zusammen. Wir kontaktieren dich, sobald genau diese Kombination wieder verfügbar ist.</p>' +
        '<form class="cm-pop__form" novalidate>' +
          '<div class="cm-pop__fields"></div>' +
          '<div class="cm-pop__field">' +
            '<label class="cm-pop__label" for="cm-pop-email">E-Mail-Adresse</label>' +
            '<input id="cm-pop-email" type="email" class="cm-pop__input" autocomplete="email" placeholder="Deine E-Mail">' +
          '</div>' +
          '<label class="cm-pop__check"><input type="checkbox" class="cm-pop__checkbox" checked><span>Außerdem Angebote und News von Ciamore per E-Mail erhalten</span></label>' +
          '<button type="submit" class="cm-pop__submit">Benachrichtigung aktivieren</button>' +
          '<p class="cm-pop__status" role="status" aria-live="polite"></p>' +
        '</form>' +
        '<div class="cm-pop__done" hidden>' +
          '<div class="cm-pop__doneicon" aria-hidden="true">✓</div>' +
          '<p class="cm-pop__donetext"></p>' +
          '<button type="button" class="cm-pop__submit" data-close>Schließen</button>' +
        '</div>' +
      '</div>';
    document.body.appendChild(pop);
    [].forEach.call(pop.querySelectorAll('[data-close]'), function (el) { el.addEventListener('click', closePopup); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && pop && !pop.hasAttribute('hidden')) closePopup(); });
    pop.querySelector('.cm-pop__form').addEventListener('submit', onSubmit);
    return pop;
  }
  function status(msg, kind) {
    var el = pop.querySelector('.cm-pop__status');
    el.textContent = msg || '';
    el.className = 'cm-pop__status' + (kind ? ' is-' + kind : '');
  }
  function openPopup() {
    if (!product) return;
    var p = buildPopup();
    p.querySelector('.cm-pop__form').hidden = false;
    p.querySelector('.cm-pop__done').hidden = true;
    status('', '');
    p.querySelector('.cm-pop__intro').textContent = isSet
      ? 'Stell dein Set zusammen. Wir kontaktieren dich, sobald genau diese Kombination wieder verfügbar ist.'
      : 'Wir kontaktieren dich, sobald genau diese Variante wieder verfügbar ist.';
    var s = scope();
    var cur = s ? match(options(s.outer)) : null;
    var pre = cur ? cur.options : (product.variants[0] ? product.variants[0].options : []);
    pop._base = pre.slice();   /* Basis-Auswahl; die Dropdowns ueberschreiben einzelne Dimensionen */
    var html = '';
    for (var i = 0; i < product.options.length; i++) {
      var vals = optValues(i);
      if (vals.length < 2) continue;   /* Dimension ohne echte Auswahl (nur ein Wert) weglassen */
      var opts = vals.map(function (val) {
        return '<option value="' + esc(val) + '"' + (val === pre[i] ? ' selected' : '') + '>' + esc(val) + '</option>';
      }).join('');
      html +=
        '<div class="cm-pop__field">' +
          '<label class="cm-pop__label">' + esc(optName(i)) + '</label>' +
          '<div class="cm-pop__selectwrap"><select class="cm-pop__select" data-oi="' + i + '">' + opts + '</select></div>' +
        '</div>';
    }
    p.querySelector('.cm-pop__fields').innerHTML = html;
    document.body.appendChild(p); /* ans Ende hängen: liegt sicher über anderen Overlays (z. B. Gratis-Geschenk) */
    p.removeAttribute('hidden');
    document.documentElement.style.overflow = 'hidden';
    /* NICHT das erste Dropdown fokussieren – es wuerde sonst aufklappen. Fokus auf den Dialog selbst. */
    var box = p.querySelector('.cm-pop__box'); if (box) { box.setAttribute('tabindex', '-1'); try { box.focus(); } catch (e) {} }
  }
  function closePopup() {
    if (!pop) return;
    pop.setAttribute('hidden', '');
    document.documentElement.style.overflow = '';
    var btn = wrap && wrap.querySelector('.cm-notify__setbtn'); if (btn) { try { btn.focus(); } catch (e) {} }
  }
  function validEmail(x) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(x); }
  function klFetch(url, body) {
    return fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json', 'revision': KL_REV }, body: JSON.stringify(body) });
  }
  function subscribeBIS(email, variantId) {
    return klFetch('https://a.klaviyo.com/client/back-in-stock-subscriptions/?company_id=' + KL_KEY, {
      data: { type: 'back-in-stock-subscription',
        attributes: { channels: ['EMAIL'], profile: { data: { type: 'profile', attributes: { email: email } } } },
        relationships: { variant: { data: { type: 'catalog-variant', id: VAR_PREFIX + variantId } } } }
    });
  }
  function subscribeNews(email) {
    return klFetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + KL_KEY, {
      data: { type: 'subscription',
        attributes: { custom_source: 'Back in Stock Popup',
          profile: { data: { type: 'profile', attributes: { email: email, subscriptions: { email: { marketing: { consent: 'SUBSCRIBED' } } } } } } },
        relationships: { list: { data: { type: 'list', id: KL_LIST } } } }
    });
  }
  function onSubmit(e) {
    e.preventDefault();
    if (busy) return;
    var emailEl = pop.querySelector('.cm-pop__input');
    var email = emailEl.value.trim();
    if (!validEmail(email)) { status('Bitte gib eine gültige E-Mail-Adresse ein.', 'err'); try { emailEl.focus(); } catch (x) {} return; }
    var vals = (pop._base || []).slice();
    [].forEach.call(pop.querySelectorAll('.cm-pop__select'), function (sel) { vals[+sel.getAttribute('data-oi')] = sel.value; });
    var v = variantByOpts(vals);
    if (!v) { status('Diese Auswahl gibt es leider nicht. Bitte prüfe deine Eingabe.', 'err'); return; }
    if (v.available !== false) { status('Diese Auswahl ist gerade verfügbar – du kannst sie direkt in den Warenkorb legen.', 'ok'); return; }
    var news = pop.querySelector('.cm-pop__checkbox').checked;
    var btn = pop.querySelector('.cm-pop__form .cm-pop__submit');
    var orig = btn.textContent;
    busy = true; btn.disabled = true; btn.textContent = 'Wird aktiviert …'; status('', '');
    subscribeBIS(email, v.id).then(function (r) {
      if (!(r.status === 200 || r.status === 201 || r.status === 202)) throw new Error('bis ' + r.status);
      return news ? subscribeNews(email).catch(function () {}) : null;
    }).then(function () {
      pop.querySelector('.cm-pop__donetext').textContent = 'Super. Wir benachrichtigen dich unter ' + email + ', sobald es wieder verfügbar ist.';
      pop.querySelector('.cm-pop__form').hidden = true;
      pop.querySelector('.cm-pop__done').hidden = false;
    }).catch(function () {
      status('Das hat gerade nicht geklappt. Bitte versuch es gleich noch einmal.', 'err');
    }).then(function () {
      busy = false; btn.disabled = false; btn.textContent = orig;
    });
  }

  function init() {
    if (!handle()) return;
    fetch('/products/' + handle() + '.js').then(function (r) { return r.json(); }).then(function (p) {
      product = p;
      isSet = (p.options || []).some(function (o) { var n = (typeof o === 'string') ? o : (o && o.name) || ''; return String(n).indexOf('(') >= 0; });
      update();
    }).catch(function () {});
    document.addEventListener('change', function (e) {
      if (e.target && e.target.matches && e.target.matches('.product__form__outer [name^="options"]')) setTimeout(update, 0);
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>
