<script>
/* Anti-Flash: sold-out Styling wird NICHT per :has(input.sold-out) gesteuert
   (das flasht auf Mobile wenn das Theme die Klasse kurz entfernt und wieder setzt),
   sondern per eigener .cm-so Klasse auf dem tooltip-component. Diese Klasse wird
   nur geändert wenn sich der tatsächliche Zustand ändert. */
(function () {
  /* cm-so auf alle tooltip-components setzen deren input sold-out ist */
  function syncAll(root) {
    (root || document).querySelectorAll('.radio__fieldset--swatches tooltip-component').forEach(function (tc) {
      var inp = tc.querySelector('input');
      if (!inp) return;
      tc.classList.toggle('cm-so', inp.classList.contains('sold-out'));
    });
  }
  /* Initial + bei Quick-Add Modals die erst später ins DOM kommen */
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', function () { syncAll(); }); } else { syncAll(); }
  new MutationObserver(function (muts) {
    for (var i = 0; i < muts.length; i++) {
      for (var j = 0; j < muts[i].addedNodes.length; j++) {
        var n = muts[i].addedNodes[j];
        if (n.nodeType === 1 && n.querySelector && n.querySelector('.radio__fieldset--swatches')) syncAll(n);
      }
    }
  }).observe(document.body || document.documentElement, { childList: true, subtree: true });
  /* Nach jedem Variantenwechsel: Theme-Handler laufen lassen (sold-out Klassen
     werden vom Theme entfernt+gesetzt), dann im nächsten Microtask den tatsächlichen
     Endzustand in cm-so übernehmen. Der Microtask läuft VOR dem nächsten Paint,
     also sieht der User nie den Zwischenzustand. */
  document.addEventListener('change', function (e) {
    if (!e.target.matches || !e.target.matches('[name^="options"]')) return;
    var fs = e.target.closest('.radio__fieldset');
    var root = fs ? fs.closest('.product__form__outer, .product-quick-add__form__inner, [data-product-form]') : null;
    if (!root) root = fs;
    if (!root) return;
    Promise.resolve().then(function () { syncAll(root); });
  });
})();
/* Produktkarte (Kollektion, Startseite, Suche): ganze Karte führt zum Produkt, auch
   nachdem Farbkreise getippt wurden, und zwar direkt zur gerade angezeigten Variante.
   Hintergrund: Das Variantenbild (.product-item__bg__inner) liegt nach dem Tippen über
   dem Standardbild und steckt in keinem Link. Welche Variante gilt, wird beim Klick aus
   dem sichtbaren Bild abgelesen, es wird also nirgends ein Zustand gespeichert. */
(function () {
  var touch = window.matchMedia && window.matchMedia('(hover: none), (pointer: coarse)').matches;
  function handle(href) { var m = /\/products\/([^\/?#]+)/.exec(href || ''); return m ? m[1] : ''; }
  function activeSwatch(card) {
    var img = card.querySelector('[data-product-image] .product-item__bg__inner.is-visible[data-variant-title]');
    if (!img) return null;
    var name = img.getAttribute('data-variant-title'), found = null;
    card.querySelectorAll('grid-swatch [data-swatch-button]').forEach(function (b) {
      if (!found && b.getAttribute('data-swatch-variant-name') && b.getAttribute('data-swatch-variant-name').replace(/"/g, "'") === name) found = b;
    });
    return found;
  }
  function target(card, main) {
    var u = new URL(main.href, location.href), sw = activeSwatch(card);
    var id = sw && sw.getAttribute('data-swatch-variant');
    if (id) u.searchParams.set('variant', id);
    return u.href;
  }
  function show(card, sw) {
    var box = card.querySelector('[data-product-image]'); if (!box) return;
    var name = (sw.getAttribute('data-swatch-variant-name') || '').replace(/"/g, "'");
    box.querySelectorAll('.product-item__bg__inner[data-variant-title]').forEach(function (i) {
      i.classList.toggle('is-visible', i.getAttribute('data-variant-title') === name);
    });
  }
  document.addEventListener('click', function (e) {
    if (e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    var t = e.target; if (!t || !t.closest) return;
    var card = t.closest('.product-item[data-grid-item]'); if (!card) return;
    /* Farbkreis: auf Touch-Geräten nur Vorschau, nie wegnavigieren */
    var sw = t.closest('grid-swatch [data-swatch-button]');
    if (sw) { if (touch) { e.preventDefault(); show(card, sw); } return; }
    var main = card.querySelector('a.product-link[href]'); if (!main) return;
    var link = t.closest('a[href]');
    if (link) { if (handle(link.getAttribute('href')) !== handle(main.getAttribute('href'))) return; }
    else if (t.closest('button, input, select, textarea, label, summary, form, dialog, [role="dialog"], [role="button"], quick-add-product, product-siblings, native-scrollbar')) return;
    var url = target(card, main);
    if (link && link.href === url) return; /* normaler Link, Browser macht den Rest */
    e.preventDefault();
    location.assign(url);
  });
})();
/* Quick-Add: kurzer Puls am gewählten Kreis und weicher Wechsel des Namens neben "Veredelung" */
/* Capture-Phase: blendet den Wert SOFORT aus, BEVOR theme.js den Text ändert */
document.addEventListener('change', function (e) {
  var t = e.target.closest && e.target.closest('.product-quick-add__form__inner .radio__fieldset--swatches tooltip-component'); if (!t) return;
  var v = t.closest('.radio__fieldset') && t.closest('.radio__fieldset').querySelector('.radio__legend__value');
  if (v) { v.style.transition = 'none'; v.style.opacity = '0'; }
}, true);
/* Bubble-Phase: Puls-Animation + nach dem Textwechsel sanft einblenden */
document.addEventListener('change', function (e) {
  var t = e.target.closest && e.target.closest('.product-quick-add__form__inner .radio__fieldset--swatches tooltip-component'); if (!t) return;
  t.classList.remove('cm-pulse'); void t.offsetWidth; t.classList.add('cm-pulse'); setTimeout(function () { t.classList.remove('cm-pulse'); }, 500);
  var v = t.closest('.radio__fieldset') && t.closest('.radio__fieldset').querySelector('.radio__legend__value');
  if (v) { requestAnimationFrame(function () { v.style.transition = 'opacity .2s ease'; v.style.opacity = '1'; }); }
});
/* Leerer Warenkorb: Bestseller per Plus direkt hinzufügen */
/* Wischen im leeren Warenkorb nicht an die Drawer-Gesten (Schließen per Wischen) weitergeben */
['touchstart','touchmove','touchend','pointerdown','pointermove'].forEach(function (ev) {
  document.addEventListener(ev, function (e) { if (e.target.closest && e.target.closest('[data-cm-swipe]')) e.stopPropagation(); }, { capture: true, passive: true });
});
document.addEventListener('click', function (e) {
  var b = e.target.closest && e.target.closest('[data-cm-add]'); if (!b) return;
  e.preventDefault(); b.classList.add('is-loading');
  fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: [{ id: +b.getAttribute('data-cm-add'), quantity: 1 }] }) })
    .then(function (r) { return r.json(); })
    .then(function () { b.classList.remove('is-loading'); document.dispatchEvent(new CustomEvent('theme:cart:refresh', { bubbles: true })); })
    .catch(function () { b.classList.remove('is-loading'); });
});
</script>
<script>
/* Veredelung: die ganze Fläche (Kreis + Text) ist antippbar, auch bei ausverkauften Varianten */
