<script>
/* Quick-Add: Specs-Tabelle (wie Produktseite) statt Fließtext "Material: … | Veredelung: …" */
(function () {
  var cache = {};
  function run() {
    document.querySelectorAll('.product-quick-add__description:not([data-cm-specs])').forEach(function (d) {
      var form = d.closest('.product-quick-add__form'); var a = form && form.querySelector('a[href*="/products/"]'); if (!a) return;
      var h = a.getAttribute('href').split('/products/')[1].split(/[?#]/)[0]; d.setAttribute('data-cm-specs', '1');
      if (!cache[h]) cache[h] = fetch('/products/' + h + '?view=cm-meta').then(function (r) { return r.json(); }).catch(function () { return {}; });
      cache[h].then(function (j) { if (j.specs && j.specs.indexOf('cm-specs__row') > -1) d.innerHTML = '<div class="cm-bm-specs">' + j.specs + '</div>'; });
    });
  }
  run(); new MutationObserver(run).observe(document.documentElement, { childList: true, subtree: true });
})();
</script>
<script>
