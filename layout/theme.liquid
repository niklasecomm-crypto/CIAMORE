<!doctype html>
<html class="no-js no-touch supports-no-cookies" lang="{{ request.locale.iso_code }}">
  
  <head>
    {%- render 'head' -%}

    {{ content_for_header }}

    <link rel="stylesheet" href="{{ 'custom.css' | asset_url }}">
    <link rel="preload" href="{{ 'cm-bricolage.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'cm-figtree-400.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="{{ 'ciamore-redesign.css' | asset_url }}">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Neue+Haas+Unica:wght@400;500;700&display=swap">


  </head>



  <body
    id="{{ page_title | handle }}"
    class="{% if request.path contains '/bundle/28201' %}cm-vip {% endif %}{% if template.name == 'product' %}{% assign cm_pt = product.title | downcase %}{% if cm_pt contains 'set' %}cm-multi-pdp {% endif %}{% endif %}template-{{ template.name | handle }} grid-{{ settings.grid_style }}{% if customer %} customer-logged-in{% endif %}{% if settings.animations_enable %} aos-initialized{% endif %}{% if settings.product_grid_outline %} has-line-design{% endif %}"
    data-animations="{{ settings.animations_enable }}"
  >
    {%- render 'loading' -%}

    <a class="in-page-link visually-hidden skip-link" data-skip-content href="#MainContent">
      {{- 'general.accessibility.skip_to_content' | t -}}
    </a>

    <div class="container" data-site-container>
      <div class="header-sections">
        {% sections 'group-header' %}
      </div>

      {% sections 'group-overlay' %}

      <!-- CONTENT -->
      <main role="main" id="MainContent" class="main-content">
        {{ content_for_layout }}
      </main>
    </div>

    {% sections 'group-pre-footer' %}

    <footer class="footer-sections">
      {% sections 'group-footer' %}
    </footer>

    {%- if settings.swatches_type != 'disabled' -%}
      {% render 'template-swatch' %}
    {%- endif -%}

    {% render 'zoom-pswp' %}

    {%- if template.name != 'product' and settings.show_scroll_top_button -%}
      <button
        type="button"
        class="btn btn--scroll-top btn--black btn--solid"
        aria-label="{{ 'general.accessibility.scroll_to_top' | t }}"
        data-scroll-top-button
      >
        {%- render 'icon-arrow-up' -%}
      </button>
    {%- endif -%}

    {%- comment -%}
      In order to use your custom javascript file at assets/custom.js
      just cut this next line and paste it outside this comment:
      <script src="{{ 'custom.js' | asset_url }}" defer="defer"></script>
    {%- endcomment -%}
    <!-- Paste marketing code or third party scripts below this comment line ============== -->




<script>
document.addEventListener("DOMContentLoaded", function () {
  const STORAGE_KEY = "ciamore_tragebilder_on";
  const toggle = document.getElementById("toggle-tragebilder");
  if (!toggle) return;

  // ✅ WICHTIG: Toggle-Logik NUR auf Collection-/Search-Seiten ausführen
  const allowedTemplates =
    document.body.classList.contains("template-collection") ||
    document.body.classList.contains("template-search") ||
    document.body.classList.contains("template-list-collections");

  if (!allowedTemplates) return;

  function applyToggleState(isActive, root = document) {
    const containers = root.querySelectorAll(".product-hover-wrapper, .image-wrapper");
    containers.forEach(container => {
      const defaultImg = container.querySelector(".product-image-default");
      const trageImg  = container.querySelector(".product-image-tragebild");
      if (!defaultImg) return;

      if (isActive && trageImg) {
        defaultImg.style.display = "none";
        trageImg.style.display = "block";
      } else {
        defaultImg.style.display = "block";
        if (trageImg) trageImg.style.display = "none";
      }
    });

    // optionaler CSS-Hook
    document.documentElement.toggleAttribute("data-tragebilder-on", !!isActive);
  }

  function saveState(on) {
    try { localStorage.setItem(STORAGE_KEY, on ? "1" : "0"); } catch(e) {}
  }
  function loadState() {
    try { return localStorage.getItem(STORAGE_KEY) === "1"; } catch(e) { return false; }
  }

  // 1) Zustand wiederherstellen
  const persisted = loadState();
  if (persisted !== toggle.checked) toggle.checked = persisted;

  // 2) anwenden
  applyToggleState(toggle.checked);

  // 3) Änderungen speichern + anwenden
  toggle.addEventListener("change", () => {
    saveState(toggle.checked);
    applyToggleState(toggle.checked);
  });

  // 4) Neu eingefügte Produktkarten berücksichtigen
  const grid = document.querySelector(".collection, .product-grid, .featured-collection, body");
  if (grid) {
    const mo = new MutationObserver(muts => {
      for (const m of muts) {
        m.addedNodes && m.addedNodes.forEach(node => {
          if (node.nodeType === 1) applyToggleState(toggle.checked, node);
        });
      }
    });
    mo.observe(grid, { childList: true, subtree: true });
  }

  document.addEventListener("shopify:section:load", () => applyToggleState(toggle.checked));
  document.addEventListener("shopify:section:reorder", () => applyToggleState(toggle.checked));

  // 5) Zurück/Vorwärts-Navigation (bfcache)
  window.addEventListener("pageshow", (e) => {
    if (e.persisted) {
      const on = loadState();
      if (on !== toggle.checked) toggle.checked = on;
      applyToggleState(on);
    }
  });

  // 6) Tab-Sync
  window.addEventListener("storage", (e) => {
    if (e.key === STORAGE_KEY) {
      const on = e.newValue === "1";
      if (on !== toggle.checked) toggle.checked = on;
      applyToggleState(on);
    }
  });
});
</script>






<script>
(function () {
  if (!('visualViewport' in window)) return;

  function setInsets() {
    // Wie viel „Platz“ klaut die iOS-Toolbar unten aktuell?
    // = Layout-Viewport minus (sichtbare Höhe + Versatz der sichtbaren Fläche)
    var vv = window.visualViewport;
    var delta = Math.max(0, window.innerHeight - (vv.height + vv.offsetTop));
    // in CSS verfügbar machen
    document.documentElement.style.setProperty('--ios-bottom-ui', delta + 'px');
    // optional: echte sichtbare Höhe als Variable, falls du 100vh ersetzen willst
    document.documentElement.style.setProperty('--vvh', vv.height + 'px');
  }

  setInsets();
  visualViewport.addEventListener('resize', setInsets);
  visualViewport.addEventListener('scroll', setInsets);
  window.addEventListener('orientationchange', setInsets);
})();
</script>






<script>
document.addEventListener('DOMContentLoaded', function() {
  document.body.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-popup-open]');
    if (!btn) return;
    
    setTimeout(function() {
      var modal = document.querySelector('.product-modal[open]');
      if (!modal) return;
      
      var scrollEl = modal.querySelector('.size-chart-scroll');
      if (!scrollEl) return;
      
      // Scroll lock komplett entfernen für dieses Element
      scrollEl.addEventListener('touchstart', function(e) {
        e.stopPropagation();
      }, { passive: true, capture: true });
      
      scrollEl.addEventListener('touchmove', function(e) {
        e.stopPropagation();
      }, { passive: true, capture: true });
    }, 400);
  });
});
</script>






