<style>
  .bogos-bundle-page-container .bogos-bp-steps-bar, 
  .bogos-bundle-page-container .bogos-bp-step-bar-single {
    display: none !important;
  }


  /* MEHR PRODUKTE ANSEHEN BUTTON */
  .bogos-bp-product-load-more-container {
    margin-top: 20px !important;
    margin-bottom: -5px !important;
  }
  /* BIS HIER HIN */


  /* PROGRESS BALKEN MIT 50% OFF IN DER MITTE (UNTEN AUF DER BUNDLE PAGE) */
  .bogos-bp-widget-progress-container {
    display: none !important;
  }
  /* BIS HIER HIN */


  /* IM CONTAINER UNTEN "STEP 1" WEGMACHEN */
  .bogos-step-items-header-title {
    display: none !important;
  }
  /* BIS HIER HIN */


  /* "WÄHLE MINDESTENS 4 PRODUKTE" TEXT WEGMACHEN */
  .bogos-step-items-product-require {
    display: none !important;
  }
  /* BIS HIER HIN */


  /* FEATURE BADGES */
  .ciamore-feature-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    margin-bottom: 10px;
    justify-content: center;
  }

  .ciamore-feature-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #FBF7F0;
    padding: 6px 10px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 700;
    color: #111;
    line-height: 1;
    white-space: nowrap;
  }

  .ciamore-feature-badges-row {
    display: flex;
    gap: 8px;
    justify-content: center;
    width: 100%;
  }

  .ciamore-feature-badges-center {
    display: flex;
    justify-content: center;
    width: 100%;
  }
  /* BIS HIER HIN */


/* Die Rabatt-Filter-Chips ("Alle / ab 30% / ab 50% / ab 70%") sind raus.
   In jedem Bundle gilt auf alle Produkte derselbe Rabatt, da gibt es nichts
   zu filtern. */


/* KEIN AUFBLITZEN DES VOLLEN PREISES IM BUNDLE-WARENKORB
   BOGOS fügt eine neue Zeile zuerst mit dem vollen Preis ein. Das Skript
   rechnet sie noch vor dem Zeichnen um, trotzdem hier eine Sperre als
   Absicherung: der Preis einer Zeile wird erst sichtbar, wenn er
   umgerechnet ist (Klasse cm-preis-ok). Nur in den Bundles mit
   Prozentrabatt, die Festpreis-Bundles rechnen nichts um. */
.bundle-blackweek .bogos-step-item:not(.cm-preis-ok) .bogos-step-item-price,
.bundle-50off .bogos-step-item:not(.cm-preis-ok) .bogos-step-item-price {
  visibility: hidden;
}
/* BIS HIER HIN */


/* RABATT-BADGE + PREISANZEIGE auf BOGOS-Karten (alle Bundles) */

/* Badge oben links auf dem Produktbild */
.bogos-bp-product-card .bogos-bp-product-img-container {
  position: relative !important;
}

/* Standard: exakt wie .sale-box in der Kollektion (Gradient + Border + Shadow) */
.ciamore-sale-badge {
  position: absolute;
  top: 8px;
  left: 8px;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.35) 38%, rgba(255, 255, 255, 0) 60%), rgb(245, 243, 239);
  color: rgb(51, 51, 51);
  font-family: Inter, sans-serif;
  font-size: 10.5px;
  font-weight: 600;
  padding: 5px 8px;
  border-radius: 8px;
  border: 1px solid rgba(0, 0, 0, 0.07);
  box-shadow: rgba(255, 255, 255, 0.95) 0px 1px 0px 0px inset, rgba(0, 0, 0, 0.035) 0px -1px 0px 0px inset, rgba(20, 20, 20, 0.18) 0px 4px 12px -6px;
  line-height: 1.2;
  text-transform: uppercase;
  z-index: 2;
  pointer-events: none;
}

/* Black Week: schwarzes Badge ohne Gradient/Border */
.bundle-blackweek .ciamore-sale-badge {
  background: #111;
  color: #fff;
  border: none;
  box-shadow: none;
}

/* Originalen BOGOS-Preis ausblenden wenn unser Preis da ist */
.bogos-bp-product-card.ciamore-price-enhanced .bogos-bp-product-price {
  display: none !important;
}

/* Neuer Preis-Container */
.ciamore-price-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 2px;
  flex-wrap: wrap;
}

.ciamore-price-row .new-price {
  font-size: 13px;
  font-weight: 400;
  color: rgb(216, 35, 35);
}

.ciamore-price-row .old-price {
  font-size: 13px;
  font-weight: 400;
  color: rgb(77, 77, 77);
  text-decoration: line-through;
}
/* BIS HIER HIN */


/* KEIN HOVER-ZOOM AUF TOUCH-GERÄTEN
   Beim Wischen am Handy berührt der Finger die Produktbilder und löst sonst
   den Hover-Zoom (scale 1.2) aus — das Bild hebt sich hervor. Auf Touch-Geräten
   abschalten; Desktop (Maus) behält den Zoom. */
@media (hover: none) {
  .bogos-bp-product-card .bogos-bp-product-img,
  .bogos-bp-product-card:hover .bogos-bp-product-img,
  .bogos-bp-product-card .bogos-bp-product-img:hover {
    transform: none !important;
  }
}
/* BIS HIER HIN */


/* PREIS IM QUICK-VIEW-POPUP wie auf der Produktseite: roter Preis +
   durchgestrichener Vergleichspreis daneben. */
.bogos-product-price .cm-bogos-new {
  color: rgb(216, 35, 35);
  font-weight: 700;
}
.bogos-product-price .cm-bogos-old {
  color: rgb(77, 77, 77);
  text-decoration: line-through;
  font-size: 16px;
  font-weight: 400;
  margin-left: 8px;
}
/* BIS HIER HIN */


/* QUICK-VIEW-POPUP: kleines Padding unten (der "Balken" unten in Safari ist
   Safaris eigene Adressleiste, keine Seiten-CSS — daher hier nichts erzwingen,
   kein 100dvh (verursacht Flackern beim Scrollen, weil Safari die Leiste
   dynamisch ein-/ausblendet)). */
.bogos-product-detail-modal .bogos-product-information-container {
  padding-bottom: 8px !important;
}
/* BIS HIER HIN */


/*HINTERGRUND BEI ZAHL IM WARENKORB / WAR DAVOR BLAU*/
.bogos-bp-widget-count {
  background-color: #000000 !important;
}
  /* BIS HIER HIN */


/* "Dein Dankeschön-Deal 🎁" TEXT AUF DER DANKESSEITE"*/ 
.bogos-ty-upsell h3 {
  font-size: 16px !important;
}
  /* BIS HIER HIN */





/*CUSTOM TEXTE UNTER DEM BUNDLE PREIS | WÄHLE MINDESTENS 4 PIECES UND SPARE 50% ETC.*/
