        <div class="bogos-bp-widget-container">
          {{ bogos_bundle_page_widget }}
        </div>
      </div>

    </div>
  {% endraw %}
</script>

<script>
  /* BLACK WEEK DISCOUNT FILTER CHIPS — Filtert Produkte nach Rabattstufe */
  /* data-discount wird jetzt vom Card-Redesign-Script gesetzt, hier nur noch Chip-Klick-Handler */
  (function(){
    if (!document.body.classList.contains('bundle-blackweek')) return;

    document.addEventListener('click', function(e) {
      var chip = e.target.closest('.ciamore-discount-chip');
      if (!chip) return;

      /* Aktiven Chip wechseln */
      document.querySelectorAll('.ciamore-discount-chip').forEach(function(c) {
        c.classList.remove('active');
      });
      chip.classList.add('active');

      var filter = chip.getAttribute('data-filter');
      var cards = document.querySelectorAll('.bogos-bp-product-card');
      cards.forEach(function(card) {
        if (filter === 'all') {
          card.classList.remove('ciamore-filtered-out');
        } else {
          var discount = parseInt(card.getAttribute('data-discount') || '0', 10);
          if (discount >= parseInt(filter, 10)) {
            card.classList.remove('ciamore-filtered-out');
          } else {
            card.classList.add('ciamore-filtered-out');
          }
        }
      });
    });
  })();
</script>

<script>
  /* BOGOS PRODUKTKARTEN REDESIGN — Erweitert alle Bundle-Karten mit Material, Preis, Swatches */
  (function(){
    var productDataCache = {};
    var cardsEnhanced = false;

    function formatPrice(cents) {
      /* 2990 → "€29,90" */
      var euros = (cents / 100).toFixed(2).replace('.', ',');
      return '€' + euros;
    }

    function enhanceCards() {
      if (cardsEnhanced) return;
      var cards = document.querySelectorAll('.bogos-bp-product-card');
      if (!cards.length) return;
      cardsEnhanced = true;

      /* Einzigartige Handles sammeln */
      var handles = [];
      cards.forEach(function(card) {
        var h = card.getAttribute('data-product-handle');
        if (h && handles.indexOf(h) === -1) handles.push(h);
      });

      /* Produkt-JSON laden */
      var fetches = handles.map(function(h) {
        if (productDataCache[h]) return Promise.resolve();
        return fetch('/products/' + h + '.js')
          .then(function(r) { return r.json(); })
          .then(function(data) { productDataCache[h] = data; })
          .catch(function() { productDataCache[h] = null; });
      });

      Promise.all(fetches).then(function() {
        cards.forEach(function(card) {
          var handle = card.getAttribute('data-product-handle');
          var data = productDataCache[handle];
          if (!data) return;

          /* Bereits enhanced? Skip */
          if (card.querySelector('.ciamore-card-material')) return;

          var titleEl = card.querySelector('.bogos-bp-product-title');
          if (!titleEl) return;

          /* --- Material Text --- */
          var materialEl = document.createElement('p');
          materialEl.className = 'ciamore-card-material';
          materialEl.textContent = '316L Edelstahl';
          titleEl.insertAdjacentElement('afterend', materialEl);

          /* --- Preis mit Vergleichspreis --- */
          /* Erste Variante oder die mit dem höchsten Rabatt nehmen */
          var bestVariant = null;
          var maxDiscount = 0;
          (data.variants || []).forEach(function(v) {
            if (v.compare_at_price && v.compare_at_price > v.price) {
              var d = Math.round((v.compare_at_price - v.price) / v.compare_at_price * 100);
              if (d > maxDiscount) {
                maxDiscount = d;
                bestVariant = v;
              }
            }
          });

          var firstVariant = data.variants && data.variants[0];
          var priceHolder = document.createElement('div');
          priceHolder.className = 'ciamore-card-price-holder';

          if (bestVariant && maxDiscount > 0) {
            priceHolder.innerHTML =
              '<span class="ciamore-card-sale-badge">-' + maxDiscount + '%</span>' +
              '<span class="ciamore-card-new-price">' + formatPrice(bestVariant.price) + '</span>' +
              '<span class="ciamore-card-old-price">' + formatPrice(bestVariant.compare_at_price) + '</span>';
          } else if (firstVariant) {
            priceHolder.innerHTML =
              '<span class="ciamore-card-regular-price">' + formatPrice(firstVariant.price) + '</span>';
          }

          materialEl.insertAdjacentElement('afterend', priceHolder);

          /* --- Rabatt-Attribut für Discount-Filter setzen (Blackweek) --- */
          card.setAttribute('data-discount', maxDiscount);

          /* --- Gold / Platin Swatches --- */
          /* Prüfen ob es Gold und Platin Varianten gibt */
          var hasGold = false;
          var hasPlatin = false;
          var goldVariant = null;
          var platinVariant = null;

          (data.variants || []).forEach(function(v) {
            var title = (v.title || '').toLowerCase();
            if (title.indexOf('gold') !== -1 && !hasGold) {
              hasGold = true;
              goldVariant = v;
            }
            if ((title.indexOf('platin') !== -1 || title.indexOf('silber') !== -1 || title.indexOf('silver') !== -1) && !hasPlatin) {
              hasPlatin = true;
              platinVariant = v;
            }
          });

          if (hasGold || hasPlatin) {
            var swatchContainer = document.createElement('div');
            swatchContainer.className = 'ciamore-card-swatches';

            if (hasGold) {
              var goldSwatch = document.createElement('span');
              goldSwatch.className = 'ciamore-card-swatch ciamore-card-swatch--gold active';
              goldSwatch.title = 'Gold';
              if (goldVariant && goldVariant.featured_image) {
                goldSwatch.setAttribute('data-img', goldVariant.featured_image.src);
              }
              swatchContainer.appendChild(goldSwatch);
            }

            if (hasPlatin) {
              var platinSwatch = document.createElement('span');
              platinSwatch.className = 'ciamore-card-swatch ciamore-card-swatch--platin';
              platinSwatch.title = 'Platin';
              if (platinVariant && platinVariant.featured_image) {
                platinSwatch.setAttribute('data-img', platinVariant.featured_image.src);
              }
              swatchContainer.appendChild(platinSwatch);
            }

            priceHolder.insertAdjacentElement('afterend', swatchContainer);
          }
        });
      });
    }

    /* Swatch-Klick: Bild wechseln */
    document.addEventListener('click', function(e) {
      var swatch = e.target.closest('.ciamore-card-swatch');
      if (!swatch) return;

      var card = swatch.closest('.bogos-bp-product-card');
      if (!card) return;

      /* Aktiven Swatch wechseln */
      card.querySelectorAll('.ciamore-card-swatch').forEach(function(s) {
        s.classList.remove('active');
      });
      swatch.classList.add('active');

      /* Bild wechseln */
      var imgSrc = swatch.getAttribute('data-img');
      if (imgSrc) {
        var img = card.querySelector('.bogos-bp-product-img');
        if (img) img.src = imgSrc;
      }
    });

    /* Warten bis BOGOS die Produkte gerendert hat */
    var checkInterval = setInterval(function() {
      if (document.querySelectorAll('.bogos-bp-product-card').length > 0) {
        clearInterval(checkInterval);
        enhanceCards();
      }
    }, 500);
    setTimeout(function() { clearInterval(checkInterval); }, 10000);

    /* Auch bei "Mehr Produkte laden" erneut enhancen */
    var observer = new MutationObserver(function(mutations) {
      var hasNewCards = false;
      mutations.forEach(function(m) {
        m.addedNodes.forEach(function(n) {
          if (n.nodeType === 1 && (n.classList.contains('bogos-bp-product-card') || n.querySelector && n.querySelector('.bogos-bp-product-card'))) {
            hasNewCards = true;
          }
        });
      });
      if (hasNewCards) {
        cardsEnhanced = false;
        enhanceCards();
      }
    });

    /* Observer starten sobald der Container da ist */
    var obsInterval = setInterval(function() {
      var container = document.querySelector('.bogos-bp-products-info');
      if (container) {
        clearInterval(obsInterval);
        observer.observe(container, { childList: true, subtree: true });
      }
    }, 500);
    setTimeout(function() { clearInterval(obsInterval); }, 10000);
  })();
</script>

<script>
  /* Geschenk-Popup darf nicht geschlossen werden — Overlay-Klick blockieren */
  (function(){
    var container = document.getElementById('freegifts-main-popup-container');
    if (!container) return;

    function blockOverlayClick(e) {
      /* Klick direkt auf den Container (= Overlay), nicht aufs Modal */
      if (e.target === container || e.target.classList.contains('bogos-gift-slider-overlay')) {
        e.stopPropagation();
        e.stopImmediatePropagation();
        e.preventDefault();
      }
    }

    container.addEventListener('click', blockOverlayClick, true);

    /* Falls BOGOS den Container erst später ins DOM injiziert */
    var obs = new MutationObserver(function(){
      var c = document.getElementById('freegifts-main-popup-container');
      if (c && !c.__cmOverlayBlocked) {
        c.__cmOverlayBlocked = true;
        c.addEventListener('click', blockOverlayClick, true);
      }
    });
    obs.observe(document.body, { childList: true, subtree: true });
  })();
</script>