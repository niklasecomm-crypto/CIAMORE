<script>
  /* RABATT-BADGE + PREISANZEIGE auf den Bundle-Karten — alle Bundles.

     Seit 23.11.2026 haben die Produkte im Shop keine durchgestrichenen
     Preise mehr. Der Rabatt entsteht erst im Bundle. Die Karte rechnet den
     Bundle-Preis deshalb selbst aus: sie liest den Prozentsatz, der im
     BOGOS-Bundle hinterlegt ist, und zeigt "neuer Preis / alter Preis" plus
     das Badge oben links. Änderst du den Prozentsatz in BOGOS, ändert sich
     die Anzeige automatisch mit — hier ist nichts fest eingetragen.

     Bundles mit Festpreis-Staffel (5 für 79, 3 für 69) haben keinen
     Prozentsatz. Dort bleibt die normale Preisanzeige von BOGOS stehen. */
  (function(){
    var info = null, infoDone = false;

    function bundleInfo() {
      if (infoDone) return info;
      var m = window.location.pathname.match(/bundle\/(\d+)/);
      var list = (window.fgData && window.fgData.bundles) || null;
      if (!m || !list) return null;          /* fgData noch nicht geladen */
      infoDone = true;
      for (var i = 0; i < list.length; i++) {
        if (String(list[i].id) !== m[1]) continue;
        var tiers = list[i].discount || [];
        if (!tiers.length || !tiers[0].discount) break;
        if (tiers[0].discount.type !== 'percentage') break;
        var pct = parseFloat(tiers[0].discount.value);
        if (!(pct > 0 && pct < 100)) break;
        info = { pct: Math.round(pct), factor: (100 - pct) / 100 };
        break;
      }
      return info;
    }

    /* "1.234,56 €" -> 1234.56 */
    function parsePrice(txt) {
      var t = String(txt == null ? '' : txt).replace(/[^0-9.,]/g, '');
      if (!t) return 0;
      t = t.replace(/\./g, '').replace(',', '.');
      var n = parseFloat(t);
      return isFinite(n) ? n : 0;
    }

    function fmt(n) { return n.toFixed(2).replace('.', ',') + ' €'; }

    function discounted(base, bi) { return Math.round(base * bi.factor * 100) / 100; }

    /* Nur schreiben, wenn sich etwas ändert — sonst löst der eigene
       DOM-Eingriff den MutationObserver endlos neu aus. */
    function setText(el, txt) { if (el && el.textContent !== txt) el.textContent = txt; }

    function updateCard(card) {
      var bi = bundleInfo();
      if (!bi) return;
      var priceEl = card.querySelector('.bogos-bp-product-price');
      if (!priceEl) return;
      var base = parsePrice(priceEl.textContent);
      if (!base) return;

      var imgBox = card.querySelector('.bogos-bp-product-img-container');
      if (imgBox) {
        var badge = imgBox.querySelector('.ciamore-sale-badge');
        if (!badge) {
          badge = document.createElement('span');
          badge.className = 'ciamore-sale-badge';
          imgBox.appendChild(badge);
        }
        setText(badge, '-' + bi.pct + '%');
      }

      var row = card.querySelector('.ciamore-price-row');
      if (!row) {
        row = document.createElement('div');
        row.className = 'ciamore-price-row';
        row.innerHTML = '<span class="new-price"></span><span class="old-price"></span>';
        priceEl.insertAdjacentElement('afterend', row);
      }
      setText(row.querySelector('.new-price'), fmt(discounted(base, bi)));
      setText(row.querySelector('.old-price'), fmt(base));
      if (!card.classList.contains('ciamore-price-enhanced')) card.classList.add('ciamore-price-enhanced');
    }

    /* Quick-View-Popup: gleicher Preis wie auf der Karte. Der Grundpreis
       kommt aus der aktiven Variante, nicht aus dem Text — sonst würde beim
       zweiten Durchlauf der schon rabattierte Preis nochmal rabattiert. */
    function updateModal() {
      var bi = bundleInfo();
      if (!bi) return;
      var modal = document.querySelector('.bogos-product-detail-modal');
      if (!modal || modal.offsetParent === null) return;
      var priceEl = modal.querySelector('.bogos-product-price');
      if (!priceEl) return;
      var act = modal.querySelector('[data-variant-price].active') || modal.querySelector('[data-variant-price]');
      var base = act ? parseFloat(act.getAttribute('data-variant-price')) : 0;
      if (!base || !isFinite(base)) return;
      var html = '<span class="cm-bogos-new">' + fmt(discounted(base, bi)) + '</span>' +
                 '<span class="cm-bogos-old">' + fmt(base) + '</span>';
      if (priceEl.innerHTML !== html) priceEl.innerHTML = html;
    }

    /* "DEIN BUNDLE": Zeilen und Gesamtpreis sollen den Bundle-Preis sofort
       zeigen, nicht erst wenn die Mindestmenge erreicht ist. BOGOS rechnet
       vorher mit dem vollen Preis — hier wird jede Zeile auf den Preis
       gesetzt, den der Kunde im Bundle zahlt, mit dem vollen Preis
       durchgestrichen daneben. Basis ist data-price am Element, also der
       echte Shop-Preis der gewählten Variante, nicht der angezeigte Text.
       Dass unterhalb der Mindestmenge noch nicht bestellt werden kann,
       steht weiter im Hinweis darüber und am gesperrten Button. */
    /* BOGOS versteckt den Vergleichspreis, solange es keinen Rabatt gibt:
       einmal per style="display:none", einmal über die Klasse cm-same aus
       dem Theme. Beides hier selbst wegnehmen, damit die Anzeige nicht vom
       Timing eines anderen Skripts abhängt. */
    function sichtbar(el) {
      if (!el) return;
      if (el.style && el.style.display === 'none') el.style.display = '';
      if (el.classList && el.classList.contains('cm-same')) el.classList.remove('cm-same');
    }

    function preisSpanne(item, klasse) {
      var el = item.querySelector('.' + klasse);
      if (el) return el;
      var box = item.querySelector('.bogos-step-item-price');
      if (!box) return null;
      el = document.createElement('span');
      el.className = klasse;
      box.appendChild(el);
      return el;
    }

    function updateWidget() {
      var bi = bundleInfo();
      if (!bi) return;
      var items = document.querySelectorAll('.bogos-bp-widget .bogos-step-item');
      if (!items.length) return;

      var summeNeu = 0, summeAlt = 0, vollstaendig = true;
      items.forEach(function (item) {
        var basis = parseFloat(item.getAttribute('data-price'));
        if (!basis || !isFinite(basis)) {
          vollstaendig = false;
          /* Ohne Grundpreis nichts rechnen, aber freigeben — sonst bliebe
             der Preis durch die CSS-Sperre dauerhaft unsichtbar. */
          item.classList.add('cm-preis-ok');
          return;
        }
        var mengeEl = item.querySelector('.bogos-bp-quantity-input');
        var menge = mengeEl ? (parseInt(mengeEl.value, 10) || 1) : 1;
        var neu = discounted(basis, bi);
        summeNeu += neu * menge;
        summeAlt += basis * menge;

        setText(preisSpanne(item, 'bogos-step-item-discount-price'), fmt(neu));
        var alt = preisSpanne(item, 'bogos-step-item-original-price');
        setText(alt, fmt(basis));
        sichtbar(alt);
        if (!item.classList.contains('cm-preis-ok')) item.classList.add('cm-preis-ok');
      });
      if (!vollstaendig) return;

      setText(document.querySelector('.bogos-bp-total-discount-price'), fmt(Math.round(summeNeu * 100) / 100));
      var gesamtAlt = document.querySelector('.bogos-bp-total-original-price');
      setText(gesamtAlt, fmt(Math.round(summeAlt * 100) / 100));
      sichtbar(gesamtAlt);
    }

    function updateAll() {
      try {
        document.querySelectorAll('.bogos-bp-product-card').forEach(updateCard);
        updateModal();
        updateWidget();
      } catch (e) {}
    }

    /* BOGOS rendert verzögert, lädt per "Mehr Produkte ansehen" nach und
       tauscht Preise beim Variantenwechsel. Deshalb ein Observer auf dem
       ganzen Body plus ein Startintervall.

       Das Widget wird dabei SOFORT aktualisiert, nicht entprellt: der
       Callback eines MutationObservers läuft noch vor dem Zeichnen. Mit
       Verzögerung blitzte beim Hinzufügen eines Produkts kurz der volle
       Preis auf, bevor er auf den Bundle-Preis sprang. Die Karten sind
       teurer zu berechnen und bleiben entprellt. */
    var t = 0;
    new MutationObserver(function () {
      try { updateWidget(); } catch (e) {}
      clearTimeout(t);
      t = setTimeout(updateAll, 80);
    }).observe(document.documentElement, { childList: true, subtree: true, characterData: true });

    var tries = 0;
    var iv = setInterval(function () {
      updateAll();
      tries++;
      /* Notbremse: kommen die BOGOS-Daten nach rund fünf Sekunden immer
         noch nicht, die CSS-Sperre aufheben. Dann steht dort zwar der
         volle Preis, aber besser als eine leere Stelle. */
      if (tries === 13 && !bundleInfo()) {
        document.querySelectorAll('.bogos-step-item').forEach(function (item) {
          item.classList.add('cm-preis-ok');
        });
      }
      if (tries > 40) clearInterval(iv);
    }, 400);

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', updateAll);
    else updateAll();
  })();
</script>

<script>
  /* Geschenk-Popup darf nicht geschlossen werden — Overlay-Klick blockieren */
  (function(){
    var container = document.getElementById('freegifts-main-popup-container');
    if (!container) return;

    function blockOverlayClick(e) {
      /* Klick direkt auf den Container (= Overlay), nicht aufs Modal */
      if (e.target === container || e.target.classList.contains('bogos-gift-slider-overlay')) {
        e.stopPropagation();
        e.stopImmediatePropagation();
        e.preventDefault();
      }
    }

    container.addEventListener('click', blockOverlayClick, true);

    /* Falls BOGOS den Container erst später ins DOM injiziert */
    var obs = new MutationObserver(function(){
      var c = document.getElementById('freegifts-main-popup-container');
      if (c && !c.__cmOverlayBlocked) {
        c.__cmOverlayBlocked = true;
        c.addEventListener('click', blockOverlayClick, true);
      }
    });
    obs.observe(document.body, { childList: true, subtree: true });
  })();
</script>