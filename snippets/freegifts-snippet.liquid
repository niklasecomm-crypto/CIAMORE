<style>
  .bogos-bundle-page-container .bogos-bp-steps-bar, 
  .bogos-bundle-page-container .bogos-bp-step-bar-single {
    display: none !important;
  }


  /* MEHR PRODUKTE ANSEHEN BUTTON */
  .bogos-bp-product-load-more-container {
    margin-top: 20px !important;
    margin-bottom: -5px !important;
  }
  /* BIS HIER HIN */


  /* PROGRESS BALKEN MIT 50% OFF IN DER MITTE (UNTEN AUF DER BUNDLE PAGE) */
  .bogos-bp-widget-progress-container {
    display: none !important;
  }
  /* BIS HIER HIN */


  /* IM CONTAINER UNTEN "STEP 1" WEGMACHEN */
  .bogos-step-items-header-title {
    display: none !important;
  }
  /* BIS HIER HIN */


  /* "WÄHLE MINDESTENS 4 PRODUKTE" TEXT WEGMACHEN */
  .bogos-step-items-product-require {
    display: none !important;
  }
  /* BIS HIER HIN */


  /* FEATURE BADGES */
  .ciamore-feature-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    margin-bottom: 10px;
    justify-content: center;
  }

  .ciamore-feature-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #FBF7F0;
    padding: 6px 10px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 700;
    color: #111;
    line-height: 1;
    white-space: nowrap;
  }

  .ciamore-feature-badges-row {
    display: flex;
    gap: 8px;
    justify-content: center;
    width: 100%;
  }

  .ciamore-feature-badges-center {
    display: flex;
    justify-content: center;
    width: 100%;
  }
  /* BIS HIER HIN */


/* BLACK WEEK DISCOUNT FILTER CHIPS */
.ciamore-discount-filters {
  display: none;
  gap: 8px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 16px;
  margin-bottom: 8px;
  padding: 0 16px;
}

.bundle-blackweek .ciamore-discount-filters {
  display: flex;
}

.ciamore-discount-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 8px 18px;
  border-radius: 100px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  border: 1.5px solid #333;
  background: transparent;
  color: #333;
  white-space: nowrap;
  -webkit-tap-highlight-color: transparent;
}

.ciamore-discount-chip:hover {
  border-color: #111;
  background: #f5f5f5;
}

.ciamore-discount-chip.active {
  background: #111;
  color: #fff;
  border-color: #111;
}

.ciamore-discount-chip .chip-pct {
  font-weight: 800;
}

/* Produkte die rausgefiltert werden */
.bogos-bp-product-card.ciamore-filtered-out {
  display: none !important;
}
/* BIS HIER HIN */


/* BOGOS PRODUKTKARTEN REDESIGN — Shop-Grid-Stil für alle Bundles */

/* Originale BOGOS-Preis und Varianten ausblenden */
.bogos-bp-product-card .bogos-bp-product-price {
  display: none !important;
}

/* Titel-Button als normalen Text stylen */
.bogos-bp-product-card .bogos-bp-product-title {
  font-size: 13px !important;
  font-weight: 400 !important;
  color: #111 !important;
  text-align: left !important;
  padding: 0 !important;
  margin: 8px 0 0 0 !important;
  background: none !important;
  border: none !important;
  cursor: pointer !important;
  line-height: 1.3 !important;
  display: block !important;
  width: 100% !important;
  text-decoration: none !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  white-space: nowrap !important;
}

/* Material-Text */
.ciamore-card-material {
  color: #9d9d9d;
  font-size: 12px;
  padding-top: 5px;
  margin-bottom: 4px;
  margin-top: 0;
  line-height: 1;
}

/* Preis-Container */
.ciamore-card-price-holder {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 4px;
}

/* Sale Badge */
.ciamore-card-sale-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #111;
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 3px;
  line-height: 1.2;
  white-space: nowrap;
}

/* Neuer Preis (Sale) */
.ciamore-card-new-price {
  font-size: 13px;
  font-weight: 600;
  color: #111;
}

/* Alter Preis (durchgestrichen) */
.ciamore-card-old-price {
  font-size: 13px;
  color: #9d9d9d;
  text-decoration: line-through;
}

/* Nur aktueller Preis (kein Rabatt) */
.ciamore-card-regular-price {
  font-size: 13px;
  font-weight: 600;
  color: #111;
}

/* Swatches */
.ciamore-card-swatches {
  display: flex;
  gap: 6px;
  margin-top: 6px;
  align-items: center;
}

.ciamore-card-swatch {
  width: 16px;
  height: 16px;
  border-radius: 50%;
  cursor: pointer;
  border: 1.5px solid transparent;
  transition: border-color 0.15s ease;
  box-sizing: border-box;
}

.ciamore-card-swatch:hover,
.ciamore-card-swatch.active {
  border-color: #111;
}

.ciamore-card-swatch--gold {
  background: linear-gradient(135deg, #d4a853, #f0d48a, #c5953a);
}

.ciamore-card-swatch--platin {
  background: linear-gradient(135deg, #c0c0c0, #e8e8e8, #a8a8a8);
}
/* BIS HIER HIN */


/*HINTERGRUND BEI ZAHL IM WARENKORB / WAR DAVOR BLAU*/
.bogos-bp-widget-count {
  background-color: #000000 !important;
}
  /* BIS HIER HIN */


/* "Dein Dankeschön-Deal 🎁" TEXT AUF DER DANKESSEITE"*/ 
.bogos-ty-upsell h3 {
  font-size: 16px !important;
}
  /* BIS HIER HIN */





/*CUSTOM TEXTE UNTER DEM BUNDLE PREIS | WÄHLE MINDESTENS 4 PIECES UND SPARE 50% ETC.*/
