  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  border: 1.5px solid #333;
  background: transparent;
  color: #333;
  white-space: nowrap;
  -webkit-tap-highlight-color: transparent;
}

.ciamore-discount-chip:hover {
  border-color: #111;
  background: #f5f5f5;
}

.ciamore-discount-chip.active {
  background: #111;
  color: #fff;
  border-color: #111;
}

.ciamore-discount-chip .chip-pct {
  font-weight: 800;
}

/* Produkte die rausgefiltert werden */
.bogos-bp-product-card.ciamore-filtered-out {
  display: none !important;
}
/* BIS HIER HIN */


/*HINTERGRUND BEI ZAHL IM WARENKORB / WAR DAVOR BLAU*/
