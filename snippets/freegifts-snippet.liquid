</style>

<script>
  /* LAGERDECKEL FÜR DIE BUNDLE-MENGEN

     Problem: BOGOS kennt pro Variante nur "verfügbar ja/nein", keine
     Stückzahl. Der Mengen-Zähler liess sich deshalb beliebig hochdrehen.
     Beim Absenden hat Shopify dann abgelehnt, aber trotzdem angelegt was
     ging. Ergebnis: ein halber Warenkorb ohne Bundle-Rabatt, also zum
     vollen Preis, und eine Meldung ohne Produktnamen.

     Lösung in drei Teilen:
       1. Bestände kommen aus /collections/all?view=lager (nur Liquid
          kennt die Stückzahl, siehe templates/collection.lager.liquid)
       2. Plus-Button stoppt beim Bestand, darunter steht "Nur noch X"
       3. Vor dem Absenden nochmal frisch prüfen. Passt es nicht, wird
          gar nichts angelegt und die Menge automatisch korrigiert.

     Läuft nur auf den Bundle-Seiten, nirgendwo sonst im Shop. */
  (function () {
    if (!/\/bundle\/\d+/.test(window.location.pathname)) return;

    var cache = null;      /* VariantenId -> Stück, -1 = unbegrenzt */
    var stand = 0;         /* wann zuletzt geholt */
    var laeuft = null;     /* laufende Abfrage */
    var busy = false;      /* wir korrigieren gerade, Observer pausieren */

    /* ---------- Bestände holen ---------- */

    function holen(frisch) {
      if (!frisch && cache && Date.now() - stand < 60000) {
        return Promise.resolve(cache);
      }
      if (laeuft) return laeuft;

      var map = {};
      var seite = 1;

      function naechste() {
        var url = '/collections/all?view=lager&page=' + seite;
        if (frisch) url += '&t=' + Date.now();

        return fetch(url, { cache: frisch ? 'no-store' : 'default' })
          .then(function (r) { return r.text(); })
          .then(function (t) {
            var j = JSON.parse(t.trim());
            Object.keys(j.v).forEach(function (k) { map[k] = j.v[k]; });
            if (seite * 50 < j.total && seite < 12) {
              seite++;
              return naechste();
            }
          });
      }

      laeuft = naechste()
        .then(function () {
          cache = map;
          stand = Date.now();
          laeuft = null;
          return cache;
        })
        .catch(function () {
          /* Wenn die Abfrage scheitert, verhält sich alles wie vorher.
             Lieber kein Deckel als ein falscher Deckel. */
          laeuft = null;
          return cache || null;
        });

      return laeuft;
    }

    function frei(id) {
      if (!cache) return -1;
      var v = cache[String(id)];
      return v === undefined ? -1 : v;
    }

    function posten() {
      return [].slice.call(document.querySelectorAll('.bogos-step-item[data-variant-id]'));
    }

    function menge(it) {
      var inp = it.querySelector('.bogos-bp-quantity-input');
      return parseInt(inp && inp.value, 10) || 1;
    }

    function name(it) {
      var t = it.querySelector('.bogos-step-item-title');
      return t ? t.textContent.trim() : 'Artikel';
    }

    /* Welche Variante würde diese Produktkarte gerade hinzufügen? */
    function karteVariante(card) {
      var sel = card.querySelector('.bogos-bp-product-variant-option-item[aria-selected="true"][data-variant-id]');
      if (sel) return sel.getAttribute('data-variant-id');
      var alle = card.querySelectorAll('.bogos-bp-product-variant-option-item[data-variant-id]');
      if (alle.length === 1) return alle[0].getAttribute('data-variant-id');
      return null;
    }

    function karteName(card) {
      var t = card.querySelector('.bogos-bp-product-title');
      return t ? t.textContent.trim() : 'Artikel';
    }

    /* Wie viele Stück dieser Variante liegen schon im Bundle? */
    function schonDrin(variantId) {
      var summe = 0;
      posten().forEach(function (it) {
        if (it.getAttribute('data-variant-id') === String(variantId)) summe += menge(it);
      });
      return summe;
    }

    /* ---------- Rückmeldung erst beim Versuch ---------- */

    /* Der Restbestand wird NICHT von vornherein angezeigt. Erst wenn
       jemand mehr will, als da ist, kommt die Rückmeldung, und zwar
       ohne dass sich irgendwas verschiebt: der vorhandene Text wird
       kurz ausgetauscht und danach wieder zurückgesetzt. Die Höhe wird
       während des Tauschs festgehalten, damit nichts springt. */
    function kurzTausch(el, text, ms) {
      if (!el) return;
      clearTimeout(el.__cmZeit);
      if (el.__cmAlt === undefined) {
        el.__cmAlt = el.textContent;
        el.style.minHeight = el.offsetHeight + 'px';
      }
      el.textContent = text;
      el.classList.add('cm-max');
      /* falls der Text doch mal breiter ist als der Kasten: verkleinern,
         statt umbrechen und die Höhe zu sprengen */
      el.style.fontSize = '';
      ['95%', '88%', '82%'].forEach(function (s) {
        if (el.scrollWidth > el.clientWidth) el.style.fontSize = s;
      });
      el.__cmZeit = setTimeout(function () {
        el.textContent = el.__cmAlt;
        el.classList.remove('cm-max');
        el.style.minHeight = '';
        el.style.fontSize = '';
        el.__cmAlt = undefined;
      }, ms || 2800);
    }

    /* Wichtig: der Text muss sagen, dass Schluss ist. "Nur noch 1
       möglich" liest sich so, als ginge noch eins, obwohl genau dieses
       eine schon im Bundle liegt. */
    function grossText(max) {
      return max < 1 ? 'NICHT MEHR VERFÜGBAR' : 'MAX. MENGE ERREICHT';
    }

    function kleinText(max) {
      return max < 1 ? 'Nicht mehr verfügbar' : 'Max. Menge erreicht';
    }

    /* ---------- Anzeige und Deckel ---------- */

    function anwenden() {
      if (!cache || busy) return;

      posten().forEach(function (it) {
        var max = frei(it.getAttribute('data-variant-id'));
        var inp = it.querySelector('.bogos-bp-quantity-input');
        var plus = it.querySelector('.bogos-plus-step-item-btn');
        var minus = it.querySelector('.bogos-minus-step-item-btn');
        if (!inp) return;

        var m = menge(it);

        /* Netz für den Fall, dass doch zu viel drin landet (getippte
           Menge, BOGOS-Eigenleben). Über echte Minus-Klicks zurück,
           damit BOGOS seine Summen mitbekommt. */
        if (max >= 0 && m > max && minus) {
          busy = true;
          for (var i = 0; i < m - max; i++) minus.click();
          setTimeout(function () {
            busy = false;
            kurzTausch(it.querySelector('.bogos-step-item-variant-title'), kleinText(max));
            anwenden();
          }, 400);
          return;
        }

        if (max >= 0) inp.setAttribute('max', String(max));
      });

      /* Falls BOGOS doch seine eigene Meldung zeigt: verständlicher machen */
      var be = document.querySelector('.bogos-bundle-error');
      if (be && /Verf..?gbarkeit/i.test(be.textContent)) {
        be.textContent = 'Von einem Produkt sind nicht mehr genug Stück da. Bitte die Menge anpassen.';
      }
    }

    /* ---------- Eigene Meldung ---------- */

    function meldung(text) {
      var btn = document.querySelector('.bogos-bp-button-add');
      if (!btn) return;
      var box = document.querySelector('.cm-lager-fehler');
      if (!box) {
        box = document.createElement('div');
        box.className = 'cm-lager-fehler';
        btn.parentNode.insertBefore(box, btn);
      }
      box.textContent = text;
    }

    function meldungWeg() {
      var box = document.querySelector('.cm-lager-fehler');
      if (box && box.parentNode) box.parentNode.removeChild(box);
    }

    function satz(n, max) {
      if (max === 0) return n + ' ist leider ausverkauft';
      if (max === 1) return 'Vom ' + n + ' ist nur noch 1 Stück da';
      return 'Vom ' + n + ' sind nur noch ' + max + ' Stück da';
    }

    /* ---------- Prüfung vor dem Absenden ---------- */

    function pruefen() {
      return holen(true).then(function () {
        var schlecht = [];
        posten().forEach(function (it) {
          var max = frei(it.getAttribute('data-variant-id'));
          var m = menge(it);
          if (max >= 0 && m > max) {
            schlecht.push({ it: it, max: max, menge: m, name: name(it) });
          }
        });
        return schlecht;
      });
    }

    function korrigieren(liste) {
      busy = true;
      var teile = [];

      liste.forEach(function (x) {
        var minus = x.it.querySelector('.bogos-minus-step-item-btn');
        var entf = x.it.querySelector('.bogos-remove-step-item');
        teile.push(satz(x.name, x.max));

        if (x.max === 0 && entf) {
          entf.click();
          return;
        }
        for (var i = 0; i < x.menge - x.max; i++) {
          if (minus) minus.click();
        }
      });

      meldung(teile.join('. ') + '. Wir haben die Menge angepasst, bitte nochmal auf "Zum Warenkorb" tippen.');
      setTimeout(function () { busy = false; anwenden(); }, 600);
    }

    /* Klick auf "Zum Warenkorb" abfangen, bevor BOGOS ihn bekommt.
       window-capture läuft vor allem anderen. */
    window.addEventListener('click', function (e) {
      if (!e.target || !e.target.closest) return;

      /* Plus im Widget: blocken, bevor BOGOS hochzählt. Sonst sieht man
         für ein paar Hundert Millisekunden den falschen Preis und die
         falsche Restanzahl, bevor es zurückspringt. */
      var pbtn = e.target.closest('.bogos-plus-step-item-btn');
      if (pbtn) {
        var it = pbtn.closest('.bogos-step-item[data-variant-id]');
        if (!it || !cache) return;
        var pmax = frei(it.getAttribute('data-variant-id'));
        if (pmax < 0 || menge(it) < pmax) return;

        e.preventDefault();
        e.stopPropagation();
        if (e.stopImmediatePropagation) e.stopImmediatePropagation();
        /* im Widget die Variantenzeile kurz umschreiben, gleiche Zeile,
           gleiche Höhe, nichts rutscht */
        kurzTausch(it.querySelector('.bogos-step-item-variant-title'), kleinText(pmax));
        return;
      }

      /* Produktkarte: gleiches Spiel */
      var kbtn = e.target.closest('.bogos-bp-btn-add-product');
      if (kbtn) {
        var card = kbtn.closest('.bogos-bp-product-card');
        if (!card || !cache) return;
        var vid = karteVariante(card);
        if (!vid) return;
        var max = frei(vid);
        if (max < 0 || schonDrin(vid) < max) return;

        e.preventDefault();
        e.stopPropagation();
        if (e.stopImmediatePropagation) e.stopImmediatePropagation();
        /* Knopftext selbst tauschen: gleicher Kasten, gleiche Farbe,
           nur ein anderer Text. Danach wieder zurück. */
        kurzTausch(kbtn, grossText(max));
        return;
      }

      var btn = e.target.closest('.bogos-bp-button-add');
      if (!btn) return;

      /* unser eigener Nachklick, durchlassen */
      if (btn.getAttribute('data-cm-ok') === '1') {
        btn.removeAttribute('data-cm-ok');
        return;
      }

      e.preventDefault();
      e.stopPropagation();
      if (e.stopImmediatePropagation) e.stopImmediatePropagation();

      meldungWeg();
      btn.classList.add('cm-pruefe');
      pruefen().then(function (schlecht) {
        btn.classList.remove('cm-pruefe');
        if (!schlecht.length) {
          btn.setAttribute('data-cm-ok', '1');
          btn.click();
          return;
        }
        korrigieren(schlecht);
      });
    }, true);

    /* Letzte Sicherung: selbst wenn der Klick doch durchrutscht, darf
       niemals ein halber Warenkorb entstehen. Greift nur mit frischen
       Beständen (unter 10 Sekunden alt) und nur auf Bundle-Seiten. */
    var echtesFetch = window.fetch;
    window.fetch = function (input, init) {
      try {
        var url = typeof input === 'string' ? input : (input && input.url) || '';
        if (/\/cart\/add(\.js)?/.test(url) &&
            init && typeof init.body === 'string' &&
            cache && Date.now() - stand < 10000) {
          var body = JSON.parse(init.body);
          var items = body && body.items;
          if (items && items.length) {
            var schlecht = items.filter(function (i) {
              var max = frei(i.id);
              return max >= 0 && i.quantity > max;
            });
            if (schlecht.length) {
              meldung('Von einem Produkt sind nicht mehr genug Stück verfügbar. Es wurde nichts in den Warenkorb gelegt, bitte die Menge anpassen.');
              setTimeout(anwenden, 150);
              return Promise.resolve(new Response(
                JSON.stringify({ status: 422, message: 'Bestand', description: 'Bestand' }),
                { status: 422, headers: { 'Content-Type': 'application/json' } }
              ));
            }
          }
        }
      } catch (err) { /* im Zweifel normal weiterleiten */ }
      return echtesFetch.apply(this, arguments);
    };

    /* ---------- Start ---------- */

    /* Sofort reagieren, nicht zeitversetzt. MutationObserver läuft als
       Microtask, also noch vor dem Zeichnen. Alle Schreibzugriffe oben
       prüfen vorher, ob sich überhaupt etwas ändert, sonst würde sich der
       Observer selbst immer wieder auslösen. */
    holen(false).then(function () {
      anwenden();
      new MutationObserver(anwenden).observe(document.body, { childList: true, subtree: true });
    });
  })();
</script>
