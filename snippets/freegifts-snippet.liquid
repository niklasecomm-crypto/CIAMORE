<style>
  .bogos-bundle-page-container .bogos-bp-steps-bar, 
  .bogos-bundle-page-container .bogos-bp-step-bar-single {
    display: none !important;
  }


  /* MEHR PRODUKTE ANSEHEN BUTTON */
  .bogos-bp-product-load-more-container {
    margin-top: 20px !important;
    margin-bottom: -5px !important;
  }
  /* BIS HIER HIN */


  /* PROGRESS BALKEN MIT 50% OFF IN DER MITTE (UNTEN AUF DER BUNDLE PAGE) */
  .bogos-bp-widget-progress-container {
    display: none !important;
  }
  /* BIS HIER HIN */


  /* IM CONTAINER UNTEN "STEP 1" WEGMACHEN */
  .bogos-step-items-header-title {
    display: none !important;
  }
  /* BIS HIER HIN */


  /* "WÄHLE MINDESTENS 4 PRODUKTE" TEXT WEGMACHEN */
  .bogos-step-items-product-require {
    display: none !important;
  }
  /* BIS HIER HIN */


  /* FEATURE BADGES */
  .ciamore-feature-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 12px;
    margin-bottom: 10px;
    justify-content: center;
  }

  .ciamore-feature-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    background: #FBF7F0;
    padding: 6px 10px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 700;
    color: #111;
    line-height: 1;
    white-space: nowrap;
  }

  .ciamore-feature-badges-row {
    display: flex;
    gap: 8px;
    justify-content: center;
    width: 100%;
  }

  .ciamore-feature-badges-center {
    display: flex;
    justify-content: center;
    width: 100%;
  }
  /* BIS HIER HIN */


/* BLACK WEEK DISCOUNT FILTER CHIPS — Underline-Tabs, unter dem Banner */
.ciamore-discount-filters {
  display: none;
  gap: 24px;
  justify-content: center;
  flex-wrap: wrap;
  margin: 18px 0 6px;
  padding: 0 16px;
}

.bundle-blackweek .ciamore-discount-filters {
  display: flex;
}

.ciamore-discount-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 6px 2px;
  border: 0;
  border-radius: 0;
  background: none;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  color: #8a8a8a;
  white-space: nowrap;
  position: relative;
  transition: color 0.2s ease;
  -webkit-tap-highlight-color: transparent;
}

.ciamore-discount-chip:hover {
  color: #111;
}

.ciamore-discount-chip.active {
  color: #111;
}

.ciamore-discount-chip.active::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -3px;
  height: 2px;
  background: #c9a45c;
  border-radius: 2px;
}

.ciamore-discount-chip .chip-pct {
  font-weight: 800;
}

/* Wenn ein Filter aktiv ist: ALLE Cards per CSS verstecken, nur gematchte zeigen.
   BOGOS grid-enter Animation und Load-More bei aktivem Filter unterdrücken,
   damit nichts zuckt oder kurz aufblitzt. */
.ciamore-filter-active .bogos-bp-product-card {
  display: none !important;
  animation: none !important;
}
.ciamore-filter-active .bogos-bp-product-card.ciamore-filter-match {
  display: flex !important;
}
.ciamore-filter-active .bogos-bp-product-load-more-container {
  display: none !important;
}
.ciamore-filter-active .bogos-bp-not-found-products {
  display: none !important;
}
/* BIS HIER HIN */


/* RABATT-BADGE + PREISANZEIGE auf BOGOS-Karten (alle Bundles) */

/* Badge oben links auf dem Produktbild */
.bogos-bp-product-card .bogos-bp-product-img-container {
  position: relative !important;
}

/* Standard: exakt wie .sale-box in der Kollektion (Gradient + Border + Shadow) */
.ciamore-sale-badge {
  position: absolute;
  top: 8px;
  left: 8px;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.35) 38%, rgba(255, 255, 255, 0) 60%), rgb(245, 243, 239);
  color: rgb(51, 51, 51);
  font-family: Inter, sans-serif;
  font-size: 10.5px;
  font-weight: 600;
  padding: 5px 8px;
  border-radius: 8px;
  border: 1px solid rgba(0, 0, 0, 0.07);
  box-shadow: rgba(255, 255, 255, 0.95) 0px 1px 0px 0px inset, rgba(0, 0, 0, 0.035) 0px -1px 0px 0px inset, rgba(20, 20, 20, 0.18) 0px 4px 12px -6px;
  line-height: 1.2;
  text-transform: uppercase;
  z-index: 2;
  pointer-events: none;
}

/* Black Week: schwarzes Badge ohne Gradient/Border */
.bundle-blackweek .ciamore-sale-badge {
  background: #111;
  color: #fff;
  border: none;
  box-shadow: none;
}

/* Originalen BOGOS-Preis ausblenden wenn unser Preis da ist */
.bogos-bp-product-card.ciamore-price-enhanced .bogos-bp-product-price {
  display: none !important;
}

/* Neuer Preis-Container */
.ciamore-price-row {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 2px;
  flex-wrap: wrap;
}

.ciamore-price-row .new-price {
  font-size: 13px;
  font-weight: 400;
  color: rgb(216, 35, 35);
}

.ciamore-price-row .old-price {
  font-size: 13px;
  font-weight: 400;
  color: rgb(77, 77, 77);
  text-decoration: line-through;
}
/* BIS HIER HIN */


/* KEIN HOVER-ZOOM AUF TOUCH-GERÄTEN
   Beim Wischen am Handy berührt der Finger die Produktbilder und löst sonst
   den Hover-Zoom (scale 1.2) aus — das Bild hebt sich hervor. Auf Touch-Geräten
   abschalten; Desktop (Maus) behält den Zoom. */
@media (hover: none) {
  .bogos-bp-product-card .bogos-bp-product-img,
  .bogos-bp-product-card:hover .bogos-bp-product-img,
  .bogos-bp-product-card .bogos-bp-product-img:hover {
    transform: none !important;
  }
}
/* BIS HIER HIN */


/*HINTERGRUND BEI ZAHL IM WARENKORB / WAR DAVOR BLAU*/
.bogos-bp-widget-count {
  background-color: #000000 !important;
}
  /* BIS HIER HIN */


/* "Dein Dankeschön-Deal 🎁" TEXT AUF DER DANKESSEITE"*/ 
.bogos-ty-upsell h3 {
  font-size: 16px !important;
}
  /* BIS HIER HIN */





/*CUSTOM TEXTE UNTER DEM BUNDLE PREIS | WÄHLE MINDESTENS 4 PIECES UND SPARE 50% ETC.*/
.bundle-50off .bogos-bp-widget-header::after {
  content: 'Wähle mindestens 4 Pieces und spare 50%!';
  display: block;
  font-size: 13px;
  color: #000000ff;
  margin-top: 4px;
  text-align: left;
}

.bundle-5for79 .bogos-bp-widget-header::after {
  content: 'Wähle 5 Pieces und zahle nur 79€!';
  display: block;
  font-size: 13px;
  color: #000000ff;
  margin-top: 4px;
  text-align: left;
}

.bundle-3for69 .bogos-bp-widget-header::after {
  content: 'Wähle 3 Pieces und zahle nur 69€!';
  display: block;
  font-size: 13px;
  color: #000000ff;
  margin-top: 4px;
  text-align: left;
}

.bundle-blackweek .bogos-bp-widget-header::after {
  content: 'Wähle mindestens 6 Pieces und spare 70% auf jedes!';
  display: block;
  font-size: 13px;
  color: #000000ff;
  margin-top: 4px;
  text-align: left;
}
/* BIS HIER HIN */


</style>




<script>
  var path = window.location.pathname;
  if (path.includes('28202')) {
    document.body.classList.add('bundle-50off');
  } else if (path.includes('28201')) {
    document.body.classList.add('bundle-5for79');
  } else if (path.includes('28353')) {
    document.body.classList.add('bundle-3for69');
  } else if (path.includes('35605')) {
    document.body.classList.add('bundle-blackweek');
  }
</script>




<script id="bogos_bundle_page_section" type="text/template">
  {% raw %}
    <div class="bogos-bundle-page-overlay"></div>
    
    <div class="bogos-bundle-page-container">
      
      <div class="bogos-bundle-page-banner {{ bogos_check_show_banner }}">
        <img loading="lazy" class="bogos-bp-banner-img" src="{{ bogos_bundle_page_banner_img }}" alt="bogos-bundle-page-banner">
      </div>
    
      <div class="bogos-bundle-page-header">
        <div class="bogos-bp-header-title">
          {{ bogos_bundle_page_title }}
        </div>
        <div class="bogos-bp-header-subtitle">
          {{ bogos_bundle_page_subtitle }}
        </div>

        <!-- Black Week Discount Filter Chips -->
        <div class="ciamore-discount-filters">
          <button class="ciamore-discount-chip active" data-filter="all">Alle</button>
          <button class="ciamore-discount-chip" data-filter="30">ab <span class="chip-pct">30%</span></button>
          <button class="ciamore-discount-chip" data-filter="50">ab <span class="chip-pct">50%</span></button>
          <button class="ciamore-discount-chip" data-filter="70">ab <span class="chip-pct">70%</span></button>
        </div>

        <!-- Ciamore Feature Badges -->
        <div class="ciamore-feature-badges">
          <div class="ciamore-feature-badges-row">
            
            <div class="ciamore-feature-badge">
              <img src="https://cdn.shopify.com/s/files/1/0877/8157/2952/files/1_9d6a6793-a493-4884-81d7-007925406b1f_800x800.png?v=1777708321" style="width:14.5px; height:14.5px;" alt="Wasserfest">
              <span>Wasserfest - Kein Abfärben</span>
            </div>
            
            <div class="ciamore-feature-badge">
              <img src="https://cdn.shopify.com/s/files/1/0877/8157/2952/files/2_61654a14-d98b-44eb-bac7-09cc9d152a3f_800x800.png?v=1777708321" style="width:16px; height:16px;" alt="Lifetime Care">
              <span>Lifetime Care</span>
            </div>
            
          </div>
          
          <div class="ciamore-feature-badges-center">
            <div class="ciamore-feature-badge">
              <img src="https://cdn.shopify.com/s/files/1/0877/8157/2952/files/3_5e648fb8-7ee2-4c76-8940-ed6064cee137_800x800.png?v=1777708320" style="width:13px; height:13px;" alt="Rückgaberecht">
              <span>30 Tage Rückgaberecht</span>
            </div>
          </div>
        </div>
      </div>
    
      <div class="bogos-bundle-page-body">
        <div class="bogos-bp-products-info">
          {{ bogos_bundle_page_steps_data }}
        </div>
        <div class="bogos-bp-widget-container">
          {{ bogos_bundle_page_widget }}
        </div>
      </div>

    </div>
  {% endraw %}
</script>

<script>
  /* RABATT-BADGES + PREISANZEIGE + DISCOUNT-FILTER — Alle Bundles */
  (function(){
    var productCache = {};
    var activeFilter = 'all';
    var enhancing = false;

    function formatPrice(cents) {
      return '€' + (cents / 100).toFixed(2).replace('.', ',');
    }

    function applyFilter() {
      var container = document.querySelector('.bogos-bp-products-info');
      if (!container) return;

      if (activeFilter === 'all') {
        /* Kein Filter → Container-Klasse weg, alle sichtbar */
        container.classList.remove('ciamore-filter-active');
        document.querySelectorAll('.bogos-bp-product-card.ciamore-filter-match').forEach(function(c) {
          c.classList.remove('ciamore-filter-match');
        });
      } else {
        /* Filter aktiv → Container-Klasse setzt CSS das ALLES versteckt,
           nur Cards mit .ciamore-filter-match werden sichtbar */
        container.classList.add('ciamore-filter-active');
        var filterVal = parseInt(activeFilter, 10);
        document.querySelectorAll('.bogos-bp-product-card').forEach(function(card) {
          if (card.hasAttribute('data-discount') && parseInt(card.getAttribute('data-discount'), 10) >= filterVal) {
            card.classList.add('ciamore-filter-match');
          } else {
            card.classList.remove('ciamore-filter-match');
          }
        });
      }
    }

    function enhanceCards() {
      if (enhancing) return;
      var cards = document.querySelectorAll('.bogos-bp-product-card:not(.ciamore-price-enhanced)');
      if (!cards.length) return;
      enhancing = true;

      /* Einzigartige Handles sammeln */
      var handles = [];
      cards.forEach(function(card) {
        var h = card.getAttribute('data-product-handle');
        if (h && handles.indexOf(h) === -1) handles.push(h);
      });

      /* Produkt-JSON laden */
      var fetches = handles.map(function(h) {
        if (productCache[h]) return Promise.resolve();
        return fetch('/products/' + h + '.js')
          .then(function(r) { return r.json(); })
          .then(function(data) { productCache[h] = data; })
          .catch(function() { productCache[h] = null; });
      });

      Promise.all(fetches).then(function() {
        cards.forEach(function(card) {
          if (card.classList.contains('ciamore-price-enhanced')) return;

          var handle = card.getAttribute('data-product-handle');
          var data = productCache[handle];
          if (!data) return;

          /* Beste Variante (höchster Rabatt) finden */
          var bestVariant = null;
          var maxDiscount = 0;
          var firstVariant = data.variants && data.variants[0];

          (data.variants || []).forEach(function(v) {
            if (v.compare_at_price && v.compare_at_price > v.price) {
              var d = Math.round((v.compare_at_price - v.price) / v.compare_at_price * 100);
              if (d > maxDiscount) {
                maxDiscount = d;
                bestVariant = v;
              }
            }
          });

          /* data-discount für Filter-Chips setzen */
          card.setAttribute('data-discount', maxDiscount);

          /* Nur wenn es einen echten Rabatt gibt: Badge + Preisanzeige */
          if (bestVariant && maxDiscount > 0) {
            /* Sale-Badge oben links auf dem Bild */
            var imgContainer = card.querySelector('.bogos-bp-product-img-container');
            if (imgContainer && !imgContainer.querySelector('.ciamore-sale-badge')) {
              var badge = document.createElement('span');
              badge.className = 'ciamore-sale-badge';
              badge.textContent = '-' + maxDiscount + '%';
              imgContainer.appendChild(badge);
            }

            /* Preis ersetzen: neuer Preis + durchgestrichener alter Preis */
            var priceEl = card.querySelector('.bogos-bp-product-price');
            if (priceEl && !card.querySelector('.ciamore-price-row')) {
              var priceRow = document.createElement('div');
              priceRow.className = 'ciamore-price-row';
              priceRow.innerHTML =
                '<span class="new-price">' + formatPrice(bestVariant.price) + '</span>' +
                '<span class="old-price">' + formatPrice(bestVariant.compare_at_price) + '</span>';
              priceEl.insertAdjacentElement('afterend', priceRow);
              card.classList.add('ciamore-price-enhanced');
            }
          }
        });

        enhancing = false;
        /* Aktiven Filter nach dem Laden der Daten nochmal anwenden */
        applyFilter();
      });
    }

    /* Chip-Klick-Handler — speichert aktiven Filter und wendet ihn an */
    document.addEventListener('click', function(e) {
      var chip = e.target.closest('.ciamore-discount-chip');
      if (!chip) return;

      document.querySelectorAll('.ciamore-discount-chip').forEach(function(c) {
        c.classList.remove('active');
      });
      chip.classList.add('active');

      activeFilter = chip.getAttribute('data-filter');
      applyFilter();
    });

    /* Warten bis BOGOS die Produkte gerendert hat */
    var checkInterval = setInterval(function() {
      if (document.querySelectorAll('.bogos-bp-product-card').length > 0) {
        clearInterval(checkInterval);
        enhanceCards();
      }
    }, 500);
    setTimeout(function() { clearInterval(checkInterval); }, 10000);

    /* Black Week: Chips aus dem Header raus, zwischen Banner und Produktfeed setzen */
    var moveChipsInterval = setInterval(function() {
      var filters = document.querySelector('.ciamore-discount-filters');
      var header = document.querySelector('.bogos-bundle-page-header');
      if (filters && header && filters.parentElement === header) {
        header.insertAdjacentElement('afterend', filters);
        clearInterval(moveChipsInterval);
      }
    }, 300);
    setTimeout(function() { clearInterval(moveChipsInterval); }, 10000);

    /* MutationObserver für "Mehr Produkte laden" */
    var obsInterval = setInterval(function() {
      var container = document.querySelector('.bogos-bp-products-info');
      if (container) {
        clearInterval(obsInterval);
        new MutationObserver(function(mutations) {
          var hasNew = false;
          mutations.forEach(function(m) {
            m.addedNodes.forEach(function(n) {
              if (n.nodeType === 1 && (n.classList && n.classList.contains('bogos-bp-product-card') || n.querySelector && n.querySelector('.bogos-bp-product-card'))) {
                hasNew = true;
              }
            });
          });
          if (hasNew) {
            enhancing = false;
            enhanceCards();
          }
        }).observe(container, { childList: true, subtree: true });
      }
    }, 500);
    setTimeout(function() { clearInterval(obsInterval); }, 10000);
  })();
</script>

<script>
  /* Geschenk-Popup darf nicht geschlossen werden — Overlay-Klick blockieren */
  (function(){
    var container = document.getElementById('freegifts-main-popup-container');
    if (!container) return;

    function blockOverlayClick(e) {
      /* Klick direkt auf den Container (= Overlay), nicht aufs Modal */
      if (e.target === container || e.target.classList.contains('bogos-gift-slider-overlay')) {
        e.stopPropagation();
        e.stopImmediatePropagation();
        e.preventDefault();
      }
    }

    container.addEventListener('click', blockOverlayClick, true);

    /* Falls BOGOS den Container erst später ins DOM injiziert */
    var obs = new MutationObserver(function(){
      var c = document.getElementById('freegifts-main-popup-container');
      if (c && !c.__cmOverlayBlocked) {
        c.__cmOverlayBlocked = true;
        c.addEventListener('click', blockOverlayClick, true);
      }
    });
    obs.observe(document.body, { childList: true, subtree: true });
  })();
</script>