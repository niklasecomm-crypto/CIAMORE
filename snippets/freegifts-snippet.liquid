  font-weight: 400;
  color: rgb(216, 35, 35);
}

.ciamore-price-row .old-price {
  font-size: 13px;
  font-weight: 400;
  color: rgb(77, 77, 77);
  text-decoration: line-through;
}
/* BIS HIER HIN */


