<script>
  /* BLACK WEEK DISCOUNT FILTER CHIPS — Filtert Produkte nach Rabattstufe */
  (function(){
    if (!document.body.classList.contains('bundle-blackweek')) return;

    var priceCache = {};
    var initialized = false;

    function parsePrice(str) {
      /* "24,90 €" → 24.90 */
      return parseFloat(str.replace(/[^\d,]/g, '').replace(',', '.'));
    }

    function initFilters() {
      if (initialized) return;
      var cards = document.querySelectorAll('.bogos-bp-product-card');
      if (!cards.length) return;
      initialized = true;

      /* Einzigartige Handles sammeln */
      var handles = [];
      cards.forEach(function(card) {
        var h = card.getAttribute('data-product-handle');
        if (h && handles.indexOf(h) === -1) handles.push(h);
      });

      /* Produkt-JSON laden für compare_at_price */
      var fetches = handles.map(function(h) {
        if (priceCache[h]) return Promise.resolve();
        return fetch('/products/' + h + '.js')
          .then(function(r) { return r.json(); })
          .then(function(data) {
            /* Höchsten Rabatt über alle Varianten nehmen */
            var maxDiscount = 0;
            (data.variants || []).forEach(function(v) {
              var cap = v.compare_at_price; /* in Cents */
              var price = v.price;           /* in Cents */
              if (cap && cap > price) {
                var d = Math.round((cap - price) / cap * 100);
                if (d > maxDiscount) maxDiscount = d;
              }
            });
            priceCache[h] = maxDiscount;
          })
          .catch(function() { priceCache[h] = 0; });
      });

      Promise.all(fetches).then(function() {
        /* Rabatt als data-Attribut auf jede Karte schreiben */
        cards.forEach(function(card) {
          var h = card.getAttribute('data-product-handle');
          card.setAttribute('data-discount', priceCache[h] || 0);
        });
      });
    }

    /* Chip-Klick-Handler */
    document.addEventListener('click', function(e) {
      var chip = e.target.closest('.ciamore-discount-chip');
      if (!chip) return;

      /* Aktiven Chip wechseln */
      document.querySelectorAll('.ciamore-discount-chip').forEach(function(c) {
        c.classList.remove('active');
      });
      chip.classList.add('active');

      var filter = chip.getAttribute('data-filter');
      var cards = document.querySelectorAll('.bogos-bp-product-card');
      cards.forEach(function(card) {
        if (filter === 'all') {
          card.classList.remove('ciamore-filtered-out');
        } else {
          var discount = parseInt(card.getAttribute('data-discount') || '0', 10);
          if (discount >= parseInt(filter, 10)) {
            card.classList.remove('ciamore-filtered-out');
          } else {
            card.classList.add('ciamore-filtered-out');
          }
        }
      });
    });

    /* Warten bis BOGOS die Produkte gerendert hat */
    var checkInterval = setInterval(function() {
      if (document.querySelectorAll('.bogos-bp-product-card').length > 0) {
        clearInterval(checkInterval);
        initFilters();
      }
    }, 500);
    /* Fallback: nach 10s aufhören */
    setTimeout(function() { clearInterval(checkInterval); }, 10000);
  })();
</script>

<script>
  /* Geschenk-Popup darf nicht geschlossen werden — Overlay-Klick blockieren */
  (function(){
    var container = document.getElementById('freegifts-main-popup-container');
    if (!container) return;

    function blockOverlayClick(e) {
      /* Klick direkt auf den Container (= Overlay), nicht aufs Modal */
      if (e.target === container || e.target.classList.contains('bogos-gift-slider-overlay')) {
        e.stopPropagation();
        e.stopImmediatePropagation();
        e.preventDefault();
      }
    }

    container.addEventListener('click', blockOverlayClick, true);

    /* Falls BOGOS den Container erst später ins DOM injiziert */
    var obs = new MutationObserver(function(){
      var c = document.getElementById('freegifts-main-popup-container');
      if (c && !c.__cmOverlayBlocked) {
        c.__cmOverlayBlocked = true;
        c.addEventListener('click', blockOverlayClick, true);
      }
    });
    obs.observe(document.body, { childList: true, subtree: true });
  })();
</script>