{%- comment -%}
  CIAMORE X-Mas Bundle (cm-xmas-bundle)
  Mix-and-match picker styled 1:1 to the BOGOS bundle pages (Black Week etc.).
  Pick {bundle_size} pieces, the cheapest ({bundle_size|minus:pay_count}) are free, pay the {pay_count} most expensive.
  Real free pricing is applied in the cart by the BOGOS "cheapest item free" offer; this page is picker + preview.
  Self-contained, prefixed (.cmx-*). Remove campaign: delete this snippet + templates/page.xmas-bundle.liquid + the Shopify page + the BOGOS offer.
{%- endcomment -%}

{%- assign coll = collection -%}
{%- assign bsize = bundle_size | default: 7 -%}
{%- assign pay = pay_count | default: 3 -%}
{%- assign freecount = bsize | minus: pay -%}
{%- assign eyebrow = eyebrow | default: 'Weihnachten bei Ciamore' -%}
{%- assign heading = heading | default: 'X-Mas Bundle' -%}
{%- assign subheading = subheading | default: 'Wähle 7 Pieces, zahle nur 3.' -%}

<style>
  .cmx{--ink:#1e1e1e;--ink2:#212121;--muted:#6b655d;--muted2:#4d4d4d;--line:#e6e4e0;--cream:#f9f8f5;
    --panel:#f3f3f3;--track:#e6e7df;--gold:#c9a45c;--hero:#0a0a0a;--hero-sub:rgba(255,255,255,.66);
    --body:"Figtree","DM Sans",system-ui,sans-serif;--disp:"Bricolage Grotesque","Figtree",sans-serif;
    font-family:var(--body);color:var(--ink);line-height:1.45}
  .cmx *{box-sizing:border-box}
  .cmx-wrap{max-width:1120px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
  /* hero: dark rounded box like BOGOS header */
  .cmx-hero{background:var(--hero);color:#fff;border:1px solid var(--line);border-radius:22px;
    box-shadow:inset 0 1px 0 0 rgba(255,255,255,.9),0 10px 24px -18px rgba(20,20,20,.35);
    padding:40px 32px;margin-top:16px;text-align:center}
  .cmx-eyebrow{font-family:var(--body);font-size:12px;letter-spacing:.18em;text-transform:uppercase;font-weight:600;
    background:linear-gradient(92deg,#b07f32,#f6d98f 28%,#c9a45c 52%,#fcefbf 72%,#a9792c);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;margin:0 0 10px}
  .cmx-hero h1{font-family:var(--disp);font-weight:700;font-size:28px;line-height:28px;letter-spacing:-.56px;text-transform:uppercase;margin:0;
    background:linear-gradient(92deg,#b07f32,#f6d98f 28%,#c9a45c 52%,#fcefbf 72%,#a9792c);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent}
  .cmx-sub{font-size:14px;color:var(--hero-sub);margin:8px auto 0;max-width:32rem}
  .cmx-badges{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-top:16px}
  .cmx-badge{border:1px solid rgba(201,164,92,.4);color:#fff;border-radius:999px;padding:6px 13px;font-size:12px;font-weight:500}
  /* layout */
  .cmx-layout{display:grid;grid-template-columns:1fr 330px;gap:28px;align-items:start;padding:24px 0 72px}
  .cmx-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  /* card */
  .cmx-card{display:flex;flex-direction:column;gap:6px;font-family:var(--body)}
  .cmx-imgwrap{position:relative;aspect-ratio:1/1;background:var(--cream);border-radius:8px;overflow:hidden}
  .cmx-img{width:100%;height:100%;object-fit:contain;display:block}
  .cmx-sold{position:absolute;top:8px;left:8px;background:#111;color:#fff;font-size:10.5px;font-weight:600;padding:5px 8px;border-radius:8px;text-transform:uppercase;letter-spacing:.02em}
  .cmx-title{font-size:14px;font-weight:600;line-height:20px;color:#1e1e1e;margin-top:2px;min-height:40px}
  .cmx-price{font-size:13px;font-weight:450;color:#6b655d}
  .cmx-vars{display:flex;flex-wrap:wrap;gap:6px;margin:2px 0}
  .cmx-var{border:1px solid #d6d3ce;border-radius:6px;padding:5px 11px;font-size:13px;background:#fff;cursor:pointer;color:#1e1e1e}
  .cmx-var.sel{border-color:#212121;background:#212121;color:#fff}
  .cmx-var:disabled{opacity:.4;cursor:not-allowed;text-decoration:line-through}
  .cmx-addwrap{margin-top:auto;padding-top:4px}
  .cmx-add{width:100%;height:44px;border:1px solid #212121;background:#212121;color:#fff;font-family:var(--body);font-weight:700;font-size:13.5px;padding:10px 12px;border-radius:10px;cursor:pointer;transition:opacity .15s}
  .cmx-add:hover{opacity:.9}
  .cmx-add:disabled{opacity:.4;cursor:not-allowed}
  .cmx-step{height:44px;display:flex;align-items:center;justify-content:space-between;border:1px solid var(--gold);border-radius:10px;overflow:hidden}
  .cmx-step button{border:0;background:transparent;color:#212121;font-size:1.2rem;font-weight:700;width:44px;height:100%;cursor:pointer;line-height:1}
  .cmx-step button:hover{background:rgba(201,164,92,.14)}
  .cmx-step button:disabled{opacity:.35;cursor:not-allowed}
  .cmx-step span{font-weight:700;font-variant-numeric:tabular-nums}
  /* panel */
  .cmx-panel{position:sticky;top:16px;background:var(--panel);border-radius:22px;box-shadow:0 -6px 24px 0 rgba(30,30,30,.08),0 10px 30px -22px rgba(30,30,30,.25);padding:16px;display:flex;flex-direction:column;gap:12px}
  .cmx-phead{display:flex;align-items:center;gap:10px}
  .cmx-pbag{width:34px;height:34px;border-radius:10px;background:#fff;display:flex;align-items:center;justify-content:center;flex:none;box-shadow:0 1px 2px rgba(30,30,30,.06)}
  .cmx-pbag svg{width:18px;height:18px;stroke:#212121;fill:none;stroke-width:1.7}
  .cmx-ptitle{font-family:var(--disp);font-size:20px;font-weight:800;letter-spacing:-.4px;color:#000;line-height:1.05}
  .cmx-ptot{margin-left:auto;font-family:var(--disp);font-weight:800;font-size:18px;color:#000;font-variant-numeric:tabular-nums}
  .cmx-prog{height:6px;border-radius:6px;background:var(--track);overflow:hidden}
  .cmx-prog__v{height:100%;border-radius:6px;background:#212121;width:0;transition:width .3s ease}
  .cmx-status{display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:500;color:#4d4d4d;margin-top:1px}
  .cmx-dot{width:8px;height:8px;border-radius:50%;background:var(--gold);flex:none}
  .cmx-status.done .cmx-dot{background:#3f7a53}
  .cmx-items{display:flex;flex-direction:column;gap:8px;max-height:240px;overflow:auto;margin:0;padding:0;list-style:none}
  .cmx-item{display:flex;align-items:center;gap:8px;font-size:13px}
  .cmx-item .nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#1e1e1e}
  .cmx-item .pr{font-variant-numeric:tabular-nums;color:#1e1e1e}
  .cmx-item .qp{color:#212121;font-weight:700;flex:none;font-variant-numeric:tabular-nums}
  .cmx-chip{font-size:10px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;padding:2px 6px;border-radius:5px;flex:none}
  .cmx-chip.free{color:#3f7a53;background:rgba(63,122,83,.12)}
  .cmx-chip.pay{color:#8a6a1f;background:rgba(201,164,92,.18)}
  .cmx-item.freeline .nm,.cmx-item.freeline .pr{color:#8a847b}
  .cmx-item.freeline .pr{text-decoration:line-through}
  .cmx-rm{border:0;background:transparent;color:#9a948b;cursor:pointer;font-size:16px;line-height:1;padding:2px 5px;border-radius:6px;flex:none}
  .cmx-rm:hover{color:#212121;background:rgba(0,0,0,.05)}
  .cmx-empty{color:#6b655d;font-size:13px;text-align:center;padding:18px 8px;border:1px dashed #ddd9d2;border-radius:12px;background:#fff}
  .cmx-note{font-size:12.5px;color:#1e1e1e;background:#fff;border-radius:10px;padding:10px 12px;line-height:1.35}
  .cmx-pfoot{display:flex;flex-direction:column;gap:8px;border-top:1px solid #e3e1dc;padding-top:12px}
  .cmx-save{display:flex;justify-content:space-between;font-size:13px;color:#6b655d}
  .cmx-save b{color:#3f7a53}
  .cmx-total{display:flex;justify-content:space-between;align-items:baseline}
  .cmx-total .lbl{font-weight:700;color:#1e1e1e}
  .cmx-total .val{font-family:var(--disp);font-weight:800;font-size:22px;color:#000;font-variant-numeric:tabular-nums}
  .cmx-total .val.old{font-size:14px;color:#9a948b;text-decoration:line-through;font-weight:500;margin-right:6px}
  .cmx-cta{width:100%;border:1px solid #212121;background:#212121;color:#fff;font-family:var(--body);font-weight:700;font-size:14px;padding:12px;border-radius:10px;cursor:pointer}
  .cmx-cta:disabled{background:#d7d4cf;border-color:#d7d4cf;color:#8a847b;cursor:not-allowed}
  .cmx-cta.busy{opacity:.75;cursor:progress}
  @media (max-width:860px){
    .cmx-hero{padding:28px 20px;margin-top:12px}
    .cmx-layout{grid-template-columns:1fr;gap:16px;padding-bottom:10rem}
    .cmx-grid{grid-template-columns:repeat(2,1fr);gap:14px}
    .cmx-panel{position:fixed;left:0;right:0;bottom:0;top:auto;border-radius:22px 22px 0 0;z-index:40;
      padding:12px max(16px,env(safe-area-inset-left,0px)) calc(12px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-right,0px));gap:8px}
    .cmx-items,.cmx-onlywide{display:none}
  }
  @media (max-width:380px){.cmx-grid{grid-template-columns:1fr 1fr;gap:10px}}
</style>

<div class="cmx" data-size="{{ bsize }}" data-pay="{{ pay }}">
  <div class="cmx-wrap">
    <div class="cmx-hero">
      {%- if eyebrow != blank -%}<p class="cmx-eyebrow">{{ eyebrow }}</p>{%- endif -%}
      <h1>{{ heading }}</h1>
      <div class="cmx-sub">{{ subheading }} Die {{ freecount }} günstigsten Teile gehen aufs Haus, du zahlst nur die {{ pay }} teuersten.</div>
      <div class="cmx-badges">
        <span class="cmx-badge">Wasserfest, kein Abfärben</span>
        <span class="cmx-badge">Lifetime Care</span>
        <span class="cmx-badge">30 Tage Rückgabe</span>
      </div>
    </div>
    <div class="cmx-layout">
      <div class="cmx-grid" id="cmx-grid">
        {%- for product in coll.products -%}
          {%- assign v0 = product.selected_or_first_available_variant -%}
          {%- unless v0.price <= 0 or product.handle contains 'guthaben' -%}
            <div class="cmx-card" data-variants='[{% for vv in product.variants %}{"id":{{ vv.id }},"t":{{ vv.title | json }},"p":{{ vv.price }},"a":{{ vv.available }}}{% unless forloop.last %},{% endunless %}{% endfor %}]' data-title="{{ product.title | escape }}">
              <div class="cmx-imgwrap">
                {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 480 | image_tag: loading: 'lazy', sizes: '(max-width:860px) 45vw, 240px', widths: '240,360,480', class: 'cmx-img', alt: product.title }}{%- endif -%}
              </div>
              <div class="cmx-title">{{ product.title }}</div>
              <div class="cmx-price"></div>
              <div class="cmx-vars"></div>
              <div class="cmx-addwrap"></div>
            </div>
          {%- endunless -%}
        {%- else -%}
          <p>Keine Produkte in der Kollektion.</p>
        {%- endfor -%}
      </div>
      <aside class="cmx-panel" id="cmx-panel"></aside>
    </div>
  </div>
</div>

<script>
(function(){
  var root=document.querySelector('.cmx');if(!root)return;
  var MAX=parseInt(root.dataset.size,10)||7, PAY=parseInt(root.dataset.pay,10)||3, FREE=MAX-PAY;
  var grid=root.querySelector('#cmx-grid'), panel=root.querySelector('#cmx-panel');
  var HEAD=(root.querySelector('.cmx-hero h1')||{}).textContent||'Bundle';
  function eur(c){return (c/100).toFixed(2).replace('.',',')+' €';}
  function esc(s){return (s||'').replace(/[&<>"]/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m];});}

  var cards=[].slice.call(grid.querySelectorAll('.cmx-card')).map(function(el){
    var vs=[];try{vs=JSON.parse(el.getAttribute('data-variants'))||[];}catch(e){}
    var sel=0;for(var i=0;i<vs.length;i++){if(vs[i].a){sel=i;break;}}
    return {el:el,title:el.dataset.title,vars:vs,sel:sel,qty:0,
      priceEl:el.querySelector('.cmx-price'),varsEl:el.querySelector('.cmx-vars'),addEl:el.querySelector('.cmx-addwrap')};
  });
  function cur(c){return c.vars[c.sel]||{p:0,a:false,id:0};}
  function count(){return cards.reduce(function(s,c){return s+c.qty;},0);}

  function drawCard(c){
    c.priceEl.textContent=eur(cur(c).p);
    if(c.vars.length>1){
      c.varsEl.innerHTML=c.vars.map(function(v,i){return '<button class="cmx-var'+(i===c.sel?' sel':'')+'" '+(v.a?'':'disabled')+' data-v="'+i+'">'+esc(v.t)+'</button>';}).join('');
    } else {c.varsEl.innerHTML='';}
    var full=count()>=MAX, avail=cur(c).a;
    if(!avail){c.addEl.innerHTML='<button class="cmx-add" disabled>Ausverkauft</button>';}
    else if(c.qty===0){c.addEl.innerHTML='<button class="cmx-add" '+(full?'disabled':'')+' data-act="add">'+(full?'Set voll':'In den Warenkorb')+'</button>';}
    else{c.addEl.innerHTML='<div class="cmx-step"><button data-act="dec">−</button><span>'+c.qty+'×</span><button data-act="add" '+(full?'disabled':'')+'>+</button></div>';}
  }

  function render(){
    cards.forEach(drawCard);
    var units=[];cards.forEach(function(c,ci){for(var k=0;k<c.qty;k++)units.push({t:c.title,p:cur(c).p,ci:ci});});
    units.sort(function(a,b){return b.p-a.p;});
    var n=units.length, full=n>=MAX;
    var paid=full?units.slice(0,PAY):[], free=full?units.slice(PAY):[];
    var payT=paid.reduce(function(s,u){return s+u.p;},0), saved=free.reduce(function(s,u){return s+u.p;},0), fullT=units.reduce(function(s,u){return s+u.p;},0);
    var totHead=full?payT:fullT;

    var items;
    if(n===0){items='<div class="cmx-empty">Hier werden deine Produkte angezeigt</div>';}
    else if(full){
      items='<ul class="cmx-items">'+units.map(function(u,idx){var f=idx>=PAY;
        return '<li class="cmx-item '+(f?'freeline':'')+'"><span class="cmx-chip '+(f?'free':'pay')+'">'+(f?'Gratis':'Zahlst du')+'</span><span class="nm">'+esc(u.t)+'</span><span class="pr">'+eur(u.p)+'</span><button class="cmx-rm" title="Entfernen" data-dec="'+u.ci+'">×</button></li>';
      }).join('')+'</ul>';
    } else {
      items='<ul class="cmx-items">'+cards.map(function(c,ci){return c.qty?'<li class="cmx-item"><span class="qp">'+c.qty+'×</span><span class="nm">'+esc(c.title)+'</span><span class="pr">'+eur(cur(c).p*c.qty)+'</span><button class="cmx-rm" title="Entfernen" data-rm="'+ci+'">×</button></li>':'';}).join('')+'</ul>';
    }
    var status=full
      ?'<div class="cmx-status done"><span class="cmx-dot"></span>Alle '+MAX+' gewählt, die '+FREE+' günstigsten sind gratis</div>'
      :'<div class="cmx-status"><span class="cmx-dot"></span>Noch '+(MAX-n)+' '+((MAX-n)===1?'Produkt':'Produkte')+' wählen</div>';
    var foot;
    if(full){
      foot='<div class="cmx-note">Die '+FREE+' günstigsten Teile gehen aufs Haus. Du zahlst nur die '+PAY+' teuersten.</div>'
        +'<div class="cmx-pfoot"><div class="cmx-save">Du sparst <b>'+eur(saved)+'</b></div>'
        +'<div class="cmx-total"><span class="lbl">Dein Preis</span><span><span class="val old">'+eur(fullT)+'</span><span class="val">'+eur(payT)+'</span></span></div>'
        +'<button class="cmx-cta" data-act="checkout">In den Warenkorb</button></div>';
    } else {
      foot='<div class="cmx-pfoot"><div class="cmx-total"><span class="lbl">Zwischensumme</span><span class="val">'+eur(fullT)+'</span></div>'
        +'<button class="cmx-cta" disabled>In den Warenkorb</button></div>';
    }
    panel.innerHTML='<div class="cmx-phead"><span class="cmx-pbag"><svg viewBox="0 0 24 24"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 016 0"/></svg></span>'
      +'<span class="cmx-ptitle">Dein '+esc(HEAD)+'</span><span class="cmx-ptot">'+eur(totHead)+'</span></div>'
      +'<div class="cmx-prog"><div class="cmx-prog__v" style="width:'+Math.min(100,n/MAX*100)+'%"></div></div>'
      +status
      +'<div class="cmx-onlywide">'+items+'</div>'
      +foot;
  }

  grid.addEventListener('click',function(e){
    var ci=cards.findIndex(function(c){return c.el===(e.target.closest('.cmx-card'));});
    if(ci<0)return;var c=cards[ci];
    var vb=e.target.closest('.cmx-var');if(vb){c.sel=+vb.dataset.v;render();return;}
    var b=e.target.closest('button[data-act]');if(!b)return;
    if(b.dataset.act==='add'&&count()<MAX&&cur(c).a)c.qty++;
    if(b.dataset.act==='dec'&&c.qty>0)c.qty--;
    render();
  });
  panel.addEventListener('click',function(e){
    var rm=e.target.closest('[data-rm]');if(rm){cards[+rm.dataset.rm].qty=0;render();return;}
    var dc=e.target.closest('[data-dec]');if(dc){var c=cards[+dc.dataset.dec];if(c.qty>0)c.qty--;render();return;}
    var cta=e.target.closest('[data-act="checkout"]');if(cta&&!cta.disabled)checkout(cta);
  });
  function checkout(btn){
    var items=cards.filter(function(c){return c.qty>0;}).map(function(c){return {id:cur(c).id,quantity:c.qty};});
    if(!items.length)return;
    btn.classList.add('busy');btn.textContent='Wird hinzugefügt...';btn.disabled=true;
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:items})})
      .then(function(r){if(!r.ok)throw 0;window.location.href='/cart';})
      .catch(function(){btn.classList.remove('busy');btn.textContent='Nochmal versuchen';btn.disabled=false;});
  }
  render();
})();
</script>
