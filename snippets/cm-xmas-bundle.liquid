{%- comment -%}
  CIAMORE X-Mas Bundle (cm-xmas-bundle)
  Mix-and-match: pick {bundle_size} pieces, the {bundle_size | minus: pay_count} cheapest are free,
  customer pays the {pay_count} most expensive. The real free pricing is applied in the cart by the
  BOGOS "cheapest item free" offer; this page is the picker + live preview.
  Self-contained + prefixed (.cmx-*) so it can be deleted cleanly after the campaign.
{%- endcomment -%}

{%- assign coll = collection -%}
{%- assign bsize = bundle_size | default: 7 -%}
{%- assign pay = pay_count | default: 3 -%}
{%- assign freecount = bsize | minus: pay -%}
{%- assign eyebrow = eyebrow | default: 'Weihnachten bei Ciamore' -%}
{%- assign heading = heading | default: 'X-Mas Bundle' -%}
{%- assign subheading = subheading | default: 'Wähle 7 Pieces, zahle nur 3.' -%}

<style>
  .cmx{--ink:#1c1b18;--card:#fff;--muted:#726c61;--line:#e9e3d8;--gold:#c9a45c;--gold-deep:#a8853f;
    --hero-bg:#1b1a17;--hero-fg:#f4efe6;--hero-muted:#b7afa0;--free:#3f7a53;--cream:#faf8f4;
    --shadow:0 1px 2px rgba(28,27,24,.05),0 8px 24px rgba(28,27,24,.06);
    --disp:"Bricolage Grotesque",Georgia,serif;--body:"DM Sans",system-ui,sans-serif;
    color:var(--ink);font-family:var(--body);line-height:1.5;background:var(--cream)}
  .cmx *{box-sizing:border-box}
  .cmx-wrap{max-width:1120px;margin:0 auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
  .cmx-hero{background:var(--hero-bg);color:var(--hero-fg);text-align:center}
  .cmx-hero__in{padding-block:2.6rem}
  .cmx-eyebrow{font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font-weight:700;margin:0 0 .7rem}
  .cmx-hero h1{font-family:var(--disp);font-weight:800;font-size:clamp(2.1rem,6vw,3.3rem);letter-spacing:-.01em;line-height:1.02;margin:0;text-wrap:balance}
  .cmx-hero__sub{font-size:clamp(1rem,2.4vw,1.2rem);margin:.6rem 0 0;font-weight:500}
  .cmx-hero__note{color:var(--hero-muted);margin:.5rem auto 0;font-size:.95rem;max-width:34rem}
  .cmx-badges{display:flex;flex-wrap:wrap;gap:.5rem;justify-content:center;margin-top:1.3rem}
  .cmx-badge{border:1px solid rgba(201,164,92,.4);color:var(--hero-fg);border-radius:999px;padding:.35rem .8rem;font-size:.78rem;font-weight:500}
  .cmx-layout{display:grid;grid-template-columns:1fr 330px;gap:2rem;align-items:start;padding-block:2.2rem 6rem}
  .cmx-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}
  .cmx-card{background:var(--card);border:1px solid var(--line);border-radius:14px;overflow:hidden;display:flex;flex-direction:column;box-shadow:var(--shadow)}
  .cmx-thumb{aspect-ratio:1/1;background:#f6f1e8;position:relative}
  .cmx-thumb img{width:100%;height:100%;object-fit:cover;display:block}
  .cmx-sold{position:absolute;left:.55rem;top:.55rem;background:rgba(28,27,24,.72);color:#fff;font-size:.68rem;font-weight:700;letter-spacing:.03em;text-transform:uppercase;padding:.2rem .5rem;border-radius:6px}
  .cmx-b{padding:.8rem .85rem 1rem;display:flex;flex-direction:column;gap:.55rem;flex:1}
  .cmx-n{font-size:.92rem;font-weight:500;line-height:1.25;min-height:2.3em}
  .cmx-p{font-family:var(--disp);font-weight:700;font-size:1.05rem;font-variant-numeric:tabular-nums}
  .cmx-add{margin-top:auto;border:0;background:var(--ink);color:#fff;font-family:var(--body);font-weight:700;font-size:.9rem;padding:.6rem;border-radius:9px;cursor:pointer;transition:opacity .15s,transform .08s}
  .cmx-add:hover{opacity:.88}.cmx-add:active{transform:scale(.98)}
  .cmx-add:disabled{opacity:.4;cursor:not-allowed}
  .cmx-step{margin-top:auto;display:flex;align-items:center;justify-content:space-between;border:1px solid var(--gold);border-radius:9px;overflow:hidden}
  .cmx-step button{border:0;background:transparent;color:var(--ink);font-size:1.2rem;font-weight:700;width:2.4rem;height:2.3rem;cursor:pointer;line-height:1}
  .cmx-step button:hover{background:rgba(201,164,92,.14)}
  .cmx-step button:disabled{opacity:.35;cursor:not-allowed}
  .cmx-step span{font-weight:700;font-variant-numeric:tabular-nums}
  .cmx-panel{position:sticky;top:1rem;background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);padding:1.15rem;display:flex;flex-direction:column;gap:.9rem}
  .cmx-panel h2{font-family:var(--disp);font-size:1.15rem;font-weight:700;margin:0}
  .cmx-psub{font-size:.9rem;color:var(--muted);margin-top:-.25rem}
  .cmx-prog{height:9px;border-radius:999px;background:var(--line);overflow:hidden}
  .cmx-prog__v{height:100%;width:0;border-radius:999px;background:linear-gradient(90deg,var(--gold),var(--gold-deep));transition:width .3s ease}
  .cmx-slots{display:flex;gap:.4rem}
  .cmx-slot{flex:1 1 0;min-width:0;height:6px;border-radius:999px;background:var(--line)}
  .cmx-slot.on{background:var(--gold)}
  .cmx-status{display:flex;align-items:center;gap:.55rem;font-size:.9rem;font-weight:500}
  .cmx-dot{width:9px;height:9px;border-radius:50%;background:var(--gold);flex:none;box-shadow:0 0 0 3px rgba(201,164,92,.22)}
  .cmx-status.done .cmx-dot{background:var(--free);box-shadow:0 0 0 3px rgba(63,122,83,.2)}
  .cmx-items{display:flex;flex-direction:column;gap:.5rem;max-height:230px;overflow:auto;margin:0;padding:0;list-style:none}
  .cmx-item{display:flex;align-items:center;gap:.55rem;font-size:.86rem}
  .cmx-item .nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .cmx-item .pr{font-variant-numeric:tabular-nums;font-weight:500}
  .cmx-item .qp{color:var(--gold-deep);font-weight:700;flex:none;font-variant-numeric:tabular-nums}
  .cmx-tag{font-size:.68rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:.12rem .4rem;border-radius:5px}
  .cmx-tag.free{color:var(--free);background:rgba(63,122,83,.12)}
  .cmx-tag.pay{color:var(--gold-deep);background:rgba(201,164,92,.16)}
  .cmx-item.freeline .nm,.cmx-item.freeline .pr{color:var(--muted)}
  .cmx-item.freeline .pr{text-decoration:line-through}
  .cmx-rm{border:0;background:transparent;color:var(--muted);cursor:pointer;font-size:1.05rem;line-height:1;padding:.1rem .3rem;border-radius:6px;flex:none}
  .cmx-rm:hover{color:var(--ink);background:var(--line)}
  .cmx-empty{color:var(--muted);font-size:.88rem;text-align:center;padding:1.2rem .5rem;border:1px dashed var(--line);border-radius:12px}
  .cmx-note{font-size:.84rem;color:var(--ink);background:rgba(201,164,92,.1);border:1px solid rgba(201,164,92,.32);border-radius:9px;padding:.55rem .65rem;line-height:1.35}
  .cmx-sum{border-top:1px solid var(--line);padding-top:.85rem;display:flex;flex-direction:column;gap:.4rem}
  .cmx-save{display:flex;justify-content:space-between;font-size:.9rem;color:var(--muted)}
  .cmx-save b{color:var(--free)}
  .cmx-total{display:flex;justify-content:space-between;align-items:baseline;margin-top:.2rem}
  .cmx-total .lbl{font-weight:700}
  .cmx-total .val{font-family:var(--disp);font-weight:800;font-size:1.5rem;font-variant-numeric:tabular-nums}
  .cmx-total .val.old{font-size:.95rem;color:var(--muted);text-decoration:line-through;font-weight:500;margin-right:.45rem}
  .cmx-cta{border:0;background:var(--ink);color:#fff;font-family:var(--body);font-weight:700;font-size:1rem;padding:.85rem;border-radius:11px;cursor:pointer;width:100%}
  .cmx-cta:disabled{background:var(--line);color:var(--muted);cursor:not-allowed}
  .cmx-cta.busy{opacity:.7;cursor:progress}
  .cmx-hint{font-size:.78rem;color:var(--muted);text-align:center}
  @media (max-width:860px){
    .cmx-layout{grid-template-columns:1fr;gap:1.2rem;padding-bottom:9.5rem}
    .cmx-grid{grid-template-columns:repeat(2,1fr)}
    .cmx-panel{position:fixed;left:0;right:0;bottom:0;top:auto;border-radius:16px 16px 0 0;z-index:30;
      padding:.8rem max(16px,env(safe-area-inset-left,0px)) calc(.8rem + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-right,0px));gap:.6rem}
    .cmx-panel h2{font-size:1rem}
    .cmx-items,.cmx-onlywide{display:none}
  }
  @media (max-width:380px){.cmx-grid{grid-template-columns:1fr 1fr;gap:.7rem}}
</style>

<div class="cmx" data-size="{{ bsize }}" data-pay="{{ pay }}">
  <div class="cmx-hero">
    <div class="cmx-wrap cmx-hero__in">
      {%- if eyebrow != blank -%}<p class="cmx-eyebrow">{{ eyebrow }}</p>{%- endif -%}
      <h1>{{ heading }}</h1>
      <div class="cmx-hero__sub">{{ subheading }}</div>
      <p class="cmx-hero__note">Die {{ freecount }} günstigsten Teile gehen aufs Haus. Du zahlst nur die {{ pay }} teuersten.</p>
      <div class="cmx-badges">
        <span class="cmx-badge">Wasserfest, kein Abfärben</span>
        <span class="cmx-badge">Lifetime Care</span>
        <span class="cmx-badge">30 Tage Rückgabe</span>
      </div>
    </div>
  </div>

  <div class="cmx-wrap">
    <div class="cmx-layout">
      <div class="cmx-grid" id="cmx-grid">
        {%- for product in coll.products -%}
          {%- assign v = product.selected_or_first_available_variant -%}
          {%- unless v.price <= 0 or product.handle contains 'guthaben' -%}
            <div class="cmx-card" data-id="{{ v.id }}" data-price="{{ v.price }}" data-title="{{ product.title | escape }}" data-avail="{{ v.available }}">
              <div class="cmx-thumb">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 480 | image_tag: loading: 'lazy', sizes: '(max-width:860px) 45vw, 240px', widths: '240,360,480', alt: product.title }}
                {%- endif -%}
                {%- unless v.available -%}<span class="cmx-sold">Ausverkauft</span>{%- endunless -%}
              </div>
              <div class="cmx-b">
                <div class="cmx-n">{{ product.title }}</div>
                <div class="cmx-p">{{ v.price | money }}</div>
                <div class="cmx-ctrl"></div>
              </div>
            </div>
          {%- endunless -%}
        {%- else -%}
          <p>Keine Produkte in der Kollektion.</p>
        {%- endfor -%}
      </div>
      <aside class="cmx-panel" id="cmx-panel"></aside>
    </div>
  </div>
</div>

<script>
(function(){
  var root=document.currentScript.closest('.cmx')||document.querySelector('.cmx');
  if(!root)return;
  var MAX=parseInt(root.dataset.size,10)||7, PAY=parseInt(root.dataset.pay,10)||3;
  var grid=root.querySelector('#cmx-grid'), panel=root.querySelector('#cmx-panel');
  var cards=[].slice.call(grid.querySelectorAll('.cmx-card')).map(function(el){
    return {el:el, id:el.dataset.id, price:parseInt(el.dataset.price,10)||0,
            title:el.dataset.title, avail:el.dataset.avail==='true', qty:0,
            ctrl:el.querySelector('.cmx-ctrl')};
  });
  function count(){return cards.reduce(function(s,c){return s+c.qty;},0);}
  function eur(cents){return (cents/100).toFixed(2).replace('.',',')+' €';}
  function esc(s){return (s||'').replace(/[&<>"]/g,function(m){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m];});}

  function drawCtrl(c){
    var full=count()>=MAX;
    if(!c.avail){c.ctrl.innerHTML='<button class="cmx-add" disabled>Ausverkauft</button>';return;}
    if(c.qty===0){c.ctrl.innerHTML='<button class="cmx-add" '+(full?'disabled':'')+' data-act="add">'+(full?'Set voll':'Hinzufügen')+'</button>';}
    else{c.ctrl.innerHTML='<div class="cmx-step"><button data-act="dec">−</button><span>'+c.qty+'×</span><button data-act="add" '+(full?'disabled':'')+'>+</button></div>';}
  }

  function render(){
    cards.forEach(drawCtrl);
    var units=[];
    cards.forEach(function(c,ci){for(var k=0;k<c.qty;k++)units.push({t:c.title,p:c.price,ci:ci});});
    units.sort(function(a,b){return b.p-a.p;});
    var n=units.length, full=n>=MAX;
    var paid=full?units.slice(0,PAY):[], free=full?units.slice(PAY):[];
    var payTotal=paid.reduce(function(s,u){return s+u.p;},0);
    var saved=free.reduce(function(s,u){return s+u.p;},0);
    var fullTotal=units.reduce(function(s,u){return s+u.p;},0);
    var slots='';for(var k=0;k<MAX;k++)slots+='<i class="cmx-slot '+(k<n?'on':'')+'"></i>';

    var items;
    if(n===0){items='<div class="cmx-empty">Hier werden deine Produkte angezeigt</div>';}
    else if(full){
      items='<ul class="cmx-items">'+units.map(function(u,idx){var f=idx>=PAY;
        return '<li class="cmx-item '+(f?'freeline':'')+'"><span class="cmx-tag '+(f?'free':'pay')+'">'+(f?'Gratis':'Zahlst du')+'</span><span class="nm">'+esc(u.t)+'</span><span class="pr">'+eur(u.p)+'</span><button class="cmx-rm" title="Entfernen" data-dec="'+u.ci+'">×</button></li>';
      }).join('')+'</ul>';
    } else {
      items='<ul class="cmx-items">'+cards.map(function(c,ci){return c.qty?'<li class="cmx-item"><span class="qp">'+c.qty+'×</span><span class="nm">'+esc(c.title)+'</span><span class="pr">'+eur(c.price*c.qty)+'</span><button class="cmx-rm" title="Entfernen" data-rm="'+ci+'">×</button></li>':'';}).join('')+'</ul>';
    }
    var status=full
      ? '<div class="cmx-status done"><span class="cmx-dot"></span>Alle '+MAX+' gewählt, die '+(MAX-PAY)+' günstigsten sind gratis</div>'
      : '<div class="cmx-status"><span class="cmx-dot"></span>Noch '+(MAX-n)+' '+((MAX-n)===1?'Produkt':'Produkte')+' wählen</div>';
    var totals;
    if(full){
      totals='<div class="cmx-note">Die '+(MAX-PAY)+' günstigsten Teile gehen aufs Haus. Du zahlst nur die '+PAY+' teuersten.</div>'
        +'<div class="cmx-sum"><div class="cmx-save">Du sparst <b>'+eur(saved)+'</b></div>'
        +'<div class="cmx-total"><span class="lbl">Dein Preis</span><span><span class="val old">'+eur(fullTotal)+'</span><span class="val">'+eur(payTotal)+'</span></span></div></div>';
    } else {
      totals='<div class="cmx-sum"><div class="cmx-total"><span class="lbl">Zwischensumme</span><span class="val">'+eur(fullTotal)+'</span></div></div>';
    }
    panel.innerHTML='<h2>Dein '+esc(root.querySelector('.cmx-hero h1')?root.querySelector('.cmx-hero h1').textContent:'Bundle')+'</h2>'
      +'<div class="cmx-psub cmx-onlywide">Wähle '+MAX+' Pieces, zahle nur '+PAY+'.</div>'
      +'<div class="cmx-prog"><div class="cmx-prog__v" style="width:'+Math.min(100,n/MAX*100)+'%"></div></div>'
      +'<div class="cmx-slots cmx-onlywide">'+slots+'</div>'
      +status
      +'<div class="cmx-onlywide">'+items+'</div>'
      +totals
      +'<button class="cmx-cta" data-act="checkout" '+(full?'':'disabled')+'>In den Warenkorb</button>';
  }

  grid.addEventListener('click',function(e){
    var b=e.target.closest('button[data-act]');if(!b)return;
    var ci=cards.findIndex(function(c){return c.el===b.closest('.cmx-card');});
    if(ci<0)return;var c=cards[ci];
    if(b.dataset.act==='add'&&count()<MAX&&c.avail)c.qty++;
    if(b.dataset.act==='dec'&&c.qty>0)c.qty--;
    render();
  });
  panel.addEventListener('click',function(e){
    var rm=e.target.closest('[data-rm]'); if(rm){cards[+rm.dataset.rm].qty=0;render();return;}
    var dc=e.target.closest('[data-dec]'); if(dc){var c=cards[+dc.dataset.dec];if(c.qty>0)c.qty--;render();return;}
    var cta=e.target.closest('[data-act="checkout"]'); if(cta&&!cta.disabled)checkout(cta);
  });

  function checkout(btn){
    var items=cards.filter(function(c){return c.qty>0;}).map(function(c){return {id:parseInt(c.id,10),quantity:c.qty};});
    if(!items.length)return;
    btn.classList.add('busy');btn.textContent='Wird hinzugefügt...';btn.disabled=true;
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:items})})
      .then(function(r){if(!r.ok)throw 0;window.location.href='/cart';})
      .catch(function(){btn.classList.remove('busy');btn.textContent='Nochmal versuchen';btn.disabled=false;});
  }

  render();
})();
</script>
