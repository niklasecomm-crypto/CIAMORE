{%- comment -%}
  Rotierendes Banner (Ciamore)
  Bilder behalten ihr eigenes Format: Die Höhe richtet sich nach dem Seitenverhältnis
  des ersten Bildes (Desktop) bzw. des ersten Handybildes (Mobil).
  Alle Banner bitte im selben Format hochladen.
{%- endcomment -%}

{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'
  assign interval = section.settings.interval | times: 1000

  assign ratio_desktop = 2.0
  assign ratio_mobile = 0.8
  assign found_desktop = false
  assign found_mobile = false

  for block in slides
    if block.settings.image != blank and found_desktop == false
      assign ratio_desktop = block.settings.image.aspect_ratio
      assign found_desktop = true
    endif
    if block.settings.image_mobile != blank and found_mobile == false
      assign ratio_mobile = block.settings.image_mobile.aspect_ratio
      assign found_mobile = true
    endif
  endfor

  if found_mobile == false
    assign ratio_mobile = ratio_desktop
  endif
-%}

<rotating-banner
  class="rb rb--{{ section.id }}"
  data-interval="{{ interval }}"
  style="--rb-ratio-desktop: {{ ratio_desktop }}; --rb-ratio-mobile: {{ ratio_mobile }};"
>
  <div class="rb__track">
    {%- for block in slides -%}
      {%- liquid
        assign img = block.settings.image
        assign img_mobile = block.settings.image_mobile | default: img
        assign alt = block.settings.alt | default: img.alt | escape
        if forloop.first
          assign loading = 'eager'
          assign priority = 'high'
        else
          assign loading = 'lazy'
          assign priority = 'auto'
        endif
      -%}

      <div class="rb__slide{% if forloop.first %} is-active{% endif %}"
        data-index="{{ forloop.index0 }}"
        {% unless forloop.first %}aria-hidden="true"{% endunless %}
        {{ block.shopify_attributes }}>

        {%- if block.settings.link != blank -%}
          <a class="rb__link" href="{{ block.settings.link }}" aria-label="{{ alt }}" {% unless forloop.first %}tabindex="-1"{% endunless %}>
        {%- endif -%}

        {%- if img != blank -%}
          <picture>
            <source media="(max-width: 749px)"
              srcset="{{ img_mobile | image_url: width: 750 }} 750w, {{ img_mobile | image_url: width: 1100 }} 1100w, {{ img_mobile | image_url: width: 1500 }} 1500w"
              sizes="100vw">
            {{ img | image_url: width: 2400 | image_tag:
              widths: '1000, 1400, 1800, 2400',
              sizes: '100vw',
              loading: loading,
              fetchpriority: priority,
              alt: alt,
              class: 'rb__img'
            }}
          </picture>
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'rb__img rb__placeholder' }}
        {%- endif -%}

        {%- if block.settings.link != blank -%}
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if slides.size > 1 and section.settings.show_dots -%}
    <div class="rb__dots" role="tablist" aria-label="Banner auswählen">
      {%- for block in slides -%}
        <button type="button"
          class="rb__dot{% if forloop.first %} is-active{% endif %}"
          data-go="{{ forloop.index0 }}"
          aria-label="Banner {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</rotating-banner>

<style>
  .rb--{{ section.id }} {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    aspect-ratio: var(--rb-ratio-desktop);
    background: #f3f3f5;
  }
  @media (max-width: 749px) {
    .rb--{{ section.id }} { aspect-ratio: var(--rb-ratio-mobile); }
  }
  .rb--{{ section.id }} .rb__track { position: absolute; inset: 0; }
  .rb--{{ section.id }} .rb__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 1s ease, visibility 0s linear 2s;
  }
  .rb--{{ section.id }} .rb__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 2s ease, visibility 0s;
    z-index: 2;
  }
  .rb--{{ section.id }} .rb__link,
  .rb--{{ section.id }} picture { display: block; width: 100%; height: 100%; }
  .rb--{{ section.id }} .rb__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .rb--{{ section.id }} .rb__dots {
    position: absolute;
    left: 50%;
    bottom: 14px;
    transform: translateX(-50%);
    display: flex;
    gap: 7px;
    z-index: 2;
  }
  .rb--{{ section.id }} .rb__dot {
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255,255,255,.55);
    box-shadow: 0 0 2px rgba(0,0,0,.35);
    cursor: pointer;
    transition: background .2s, transform .2s;
  }
  .rb--{{ section.id }} .rb__dot.is-active { background: #fff; transform: scale(1.25); }
  @media (prefers-reduced-motion: reduce) {
    .rb--{{ section.id }} .rb__slide,
    .rb--{{ section.id }} .rb__slide.is-active { transition: none; }
  }
</style>

<script>
  if (!customElements.get('rotating-banner')) {
    customElements.define('rotating-banner', class extends HTMLElement {
      connectedCallback() {
        this.slides = Array.from(this.querySelectorAll('.rb__slide'));
        this.dots = Array.from(this.querySelectorAll('.rb__dot'));
        this.interval = parseInt(this.dataset.interval, 10) || 6000;
        this.current = 0;
        if (this.slides.length < 2) return;

        this.dots.forEach((dot) => {
          dot.addEventListener('click', () => { this.go(parseInt(dot.dataset.go, 10)); this.restart(); });
        });

        // Wischen auf dem Handy
        let startX = null;
        this.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
        this.addEventListener('touchend', (e) => {
          if (startX === null) return;
          const dx = e.changedTouches[0].clientX - startX;
          if (Math.abs(dx) > 40) { this.go(this.current + (dx < 0 ? 1 : -1)); this.restart(); }
          startX = null;
        });

        // Pausieren, wenn der Tab im Hintergrund ist
        this.onVisibility = () => { document.hidden ? this.stop() : this.start(); };
        document.addEventListener('visibilitychange', this.onVisibility);

        // Theme Editor: angeklickte Slide anzeigen
        this.onBlockSelect = (e) => {
          const i = this.slides.findIndex((s) => s.contains(e.target) || s === e.target);
          if (i > -1) { this.stop(); this.go(i); }
        };
        document.addEventListener('shopify:block:select', this.onBlockSelect);
        document.addEventListener('shopify:block:deselect', () => this.start());

        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) this.start();
      }

      disconnectedCallback() {
        this.stop();
        document.removeEventListener('visibilitychange', this.onVisibility);
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
      }

      go(i) {
        const n = this.slides.length;
        const next = ((i % n) + n) % n;
        if (next === this.current) return;
        this.slides.forEach((s, idx) => {
          const on = idx === next;
          s.classList.toggle('is-active', on);
          s.toggleAttribute('aria-hidden', !on);
          const link = s.querySelector('.rb__link');
          if (link) link.tabIndex = on ? 0 : -1;
        });
        this.dots.forEach((d, idx) => d.classList.toggle('is-active', idx === next));
        this.current = next;
      }

      start() { this.stop(); this.timer = setInterval(() => this.go(this.current + 1), this.interval); }
      stop() { clearInterval(this.timer); }
      restart() { this.start(); }
    });
  }
</script>

{% schema %}
{
  "name": "Rotierendes Banner",
  "settings": [
    {
      "type": "range",
      "id": "interval",
      "label": "Wechsel alle (Sekunden)",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Punkte anzeigen",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Die Höhe richtet sich nach dem Format des ersten Bildes. Alle Banner im gleichen Format hochladen (Desktop untereinander gleich, Handy untereinander gleich)."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Banner",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild Desktop"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Bild Handy (optional)",
          "info": "Leer lassen, dann wird das Desktop Bild genommen"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Bildbeschreibung (Alt Text)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Rotierendes Banner",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
