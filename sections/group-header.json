    "section_custom_code_blackweek": {
      "type": "section-custom-code",
      "name": "Black Week Marquee",
      "settings": {
        "code": "<!-- Black Week Marquee — durchlaufende obere Leiste mit Live-Countdown.\n     Zum Entfernen einfach diese Custom-Code-Sektion im Theme-Editor loeschen.\n     Zeitfenster unten (START/END): nur in diesem Zeitraum sichtbar. -->\n<style>\n#cmbw-bar{background:#0a0a0a;overflow:hidden;position:relative;display:none;}\n#cmbw-bar .cmbw-track{display:inline-block;white-space:nowrap;will-change:transform;animation:cmbw-marq 18s linear infinite;}\n#cmbw-bar .cmbw-seg{display:inline-block;white-space:nowrap;color:#fff;font-family:'Figtree','DM Sans',sans-serif;font-size:12px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;padding:11px 0;vertical-align:middle;}\n#cmbw-bar .cmbw-gold{background:linear-gradient(92deg,#b07f32,#f6d98f 28%,#c9a45c 52%,#fcefbf 72%,#a9792c);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;font-weight:700;}\n#cmbw-bar .cmbw-sep{color:#c9a45c;margin:0 16px;}\n#cmbw-bar .cmbw-cd{font-variant-numeric:tabular-nums;}\n#cmbw-bar .cmbw-n{color:#f0d79a;font-weight:800;}\n#cmbw-bar .cmbw-dot{color:#c9a45c;margin:0 8px;}\n@keyframes cmbw-marq{from{transform:translateX(0)}to{transform:translateX(-50%)}}\n@media (prefers-reduced-motion:reduce){#cmbw-bar .cmbw-track{animation:none;}}\n</style>\n\n<div id=\"cmbw-bar\" aria-label=\"Black Week\"><div class=\"cmbw-track\"></div></div>\n\n<script>\n(function(){\n  /* ZEITFENSTER — Marquee erscheint NUR hier. Start steht zum Testen auf heute;\n     VOR dem Launch auf '2026-11-23T00:01:00+01:00' aendern. */\n  var START = '2026-11-22T00:01:00+01:00';\n  var END   = '2026-11-30T23:59:59+01:00';\n\n  /* Tempo in Pixel pro Sekunde — hoeher = schneller. */\n  var SPEED = 92;\n\n  var bar = document.getElementById('cmbw-bar');\n  if(!bar) return;\n  var startMs = new Date(START).getTime(), endMs = new Date(END).getTime();\n  var now = Date.now();\n  if(now < startMs || now > endMs) return; /* ausserhalb Fenster: nichts anzeigen, nichts verstecken */\n\n  function pad(n){ return (n<10?'0':'')+n; }\n  function cd(){\n    var d = endMs - Date.now(); if(d<0) d=0;\n    var D=Math.floor(d/864e5), h=Math.floor(d%864e5/36e5), m=Math.floor(d%36e5/6e4), s=Math.floor(d%6e4/1e3);\n    function g(v){ return '<span class=\"cmbw-n\">'+v+'</span>'; } /* goldene Zahl */\n    var dot = '<span class=\"cmbw-dot\">·</span>';            /* goldener Trenner */\n    var parts = [];\n    if(D>0) parts.push(g(D)+' T');\n    parts.push(g(pad(h))+' Std');\n    parts.push(g(pad(m))+' Min');\n    parts.push(g(pad(s))+' Sek');\n    return parts.join(dot);\n  }\n  function seg(){\n    return '<span class=\"cmbw-seg\">'+\n      '<span class=\"cmbw-gold\">★ Black Week</span>'+\n      '<span class=\"cmbw-sep\">•</span>Bis zu 70% auf dein Set'+\n      '<span class=\"cmbw-sep\">•</span>Endet in <span class=\"cmbw-cd\">'+cd()+'</span>'+\n      '<span class=\"cmbw-sep\">•</span>Kostenloser Versand ab 39€'+\n      '<span class=\"cmbw-sep\">•</span>100% Wasserfest'+\n      '<span class=\"cmbw-sep\">•</span></span>';\n  }\n\n  var track = bar.querySelector('.cmbw-track');\n  track.innerHTML = seg()+seg(); /* zwei Kopien = nahtlose Schleife */\n  bar.style.display = 'block';\n\n  /* Dauer aus Breite + Tempo, damit die Geschwindigkeit konstant bleibt. */\n  function applySpeed(){\n    var half = track.scrollWidth / 2;\n    if(half > 0) track.style.animationDuration = Math.max(6, half / SPEED) + 's';\n  }\n  applySpeed();\n  var rt; window.addEventListener('resize', function(){ clearTimeout(rt); rt=setTimeout(applySpeed,200); });\n\n  /* waehrend der Black Week die anderen oberen Leisten ausblenden */\n  function hideOthers(){\n    var mySec = bar.closest('.shopify-section');\n    var n = document.querySelector('.page-announcement'); if(n) n.style.display='none';\n    var customs = document.querySelectorAll('.announcement-bar-custom-full');\n    for(var i=0;i<customs.length;i++){\n      var sec = customs[i].closest('.shopify-section');\n      if(sec && sec!==mySec) sec.style.display='none';\n    }\n  }\n  hideOthers(); setTimeout(hideOthers,500); setTimeout(hideOthers,1500);\n\n  setInterval(function(){\n    var t = cd(); var els = bar.querySelectorAll('.cmbw-cd');\n    for(var i=0;i<els.length;i++) els[i].innerHTML = t;\n  }, 1000);\n})();\n</script>\n",
        "width": "wrapper--full",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    }
