<script>
  document.addEventListener("DOMContentLoaded", function () {
    // =====================
    // ⏰ Countdown-Logik
    // =====================
    var countdownEl = document.getElementById("cartCountdown");
    var COUNTDOWN_KEY = "cartCountdownEndTime";
    var DEFAULT_TIME = 600; // 10 Minuten
    var endTime = null;
    var ticking = false;

    function formatMMSS(totalSeconds) {
      var minutes = Math.floor(totalSeconds / 60);
      var seconds = totalSeconds % 60;
      return (minutes < 10 ? "0" : "") + minutes + ":" + (seconds < 10 ? "0" : "") + seconds;
    }

    function updateCountdown() {
      if (!countdownEl || endTime === null) return;

      var currentTime = Math.floor(Date.now() / 1000);
      var remaining = endTime - currentTime;

      if (remaining <= 0) {
        countdownEl.textContent = "00:00";
        ticking = false;
        return;
      }

      countdownEl.textContent = formatMMSS(remaining);
      ticking = true;
      setTimeout(updateCountdown, 1000);
    }

    function initCountdownWith(endTs) {
      endTime = endTs;
      sessionStorage.setItem(COUNTDOWN_KEY, String(endTime));
      updateCountdown();
    }

    function startCountdownIfNotStarted() {
      if (sessionStorage.getItem(COUNTDOWN_KEY)) return; // schon gestartet
      var newEnd = Math.floor(Date.now() / 1000) + DEFAULT_TIME;
      initCountdownWith(newEnd);
    }

    function showStaticDefaultIfIdle() {
      if (!countdownEl) return;
      // Zeige "10:00", solange der Countdown noch nicht gestartet hat
      if (!sessionStorage.getItem(COUNTDOWN_KEY)) {
        countdownEl.textContent = formatMMSS(DEFAULT_TIME);
      }
    }

    async function checkCartAndMaybeStart() {
      try {
        const res = await fetch("/cart.js", { credentials: "same-origin" });
        if (!res.ok) throw new Error("Cart fetch failed");
        const cart = await res.json();
        if (cart && typeof cart.item_count === "number" && cart.item_count > 0) {
          // Bereits Artikel im Warenkorb → Countdown starten (falls nicht schon)
          startCountdownIfNotStarted();
        } else {
          // Noch leer → statische Anzeige
          showStaticDefaultIfIdle();
        }
      } catch (e) {
        // Fallback: statische Anzeige, wenn /cart.js nicht erreichbar ist
        showStaticDefaultIfIdle();
      }
    }

    if (countdownEl) {
      // Falls der Countdown früher schon gestartet wurde (gleiche Session)
      var storedEnd = sessionStorage.getItem(COUNTDOWN_KEY);
      if (storedEnd) {
        initCountdownWith(parseInt(storedEnd, 10));
      } else {
        // Sonst prüfen, ob der Warenkorb bereits Artikel enthält
        checkCartAndMaybeStart();
      }

      // ▶️ Add-to-Cart Listener (Form-Submit)
      document.addEventListener("submit", function (e) {
        var form = e.target;
        if (!(form instanceof HTMLFormElement)) return;
        // Greife gängige Shopify-Formen ab
        if (form.matches('form[action*="/cart/add"], form.product-form, form[action*="/cart/add.js"]')) {
          startCountdownIfNotStarted();
        }
      }, true);

      // ▶️ Add-to-Cart Listener (Button-Klick)
      document.addEventListener("click", function (e) {
        var btn = e.target && (e.target.closest('button[name="add"], button.add-to-cart, .product-form__submit, [data-add-to-cart], [data-action="add-to-cart"]'));
        if (btn) {
          startCountdownIfNotStarted();
        }
      }, true);
    }

    // =====================================================
    // 📦 Menü-Umschaltfunktion im leeren Cart-Drawer (unverändert)
    // =====================================================
    const mainMenu = document.querySelector('.drawer__menu--main');
    const productsMenu = document.querySelector('.drawer__menu--products');
    const productButton = document.querySelector('[data-submenu="products"]');
    const backButton = document.querySelector('.drawer__btn-back');

    if (productButton && backButton && mainMenu && productsMenu) {
      productButton.addEventListener('click', function (e) {
        e.preventDefault();
        mainMenu.style.display = 'none';
        productsMenu.style.display = 'block';
      });

      backButton.addEventListener('click', function (e) {
        e.preventDefault();
        productsMenu.style.display = 'none';
        mainMenu.style.display = 'block';
      });
    }
  });
</script>











<script>
  document.addEventListener("DOMContentLoaded", function () {
    var productsBtn = document.querySelector('[data-submenu="products"]');
    var productsMenu = document.querySelector('.drawer__menu--products');

    if (productsBtn && productsMenu) {
      productsBtn.addEventListener('click', function () {
        // Entferne die Animation kurz und triggere sie neu
        productsMenu.classList.remove('animate');
        void productsMenu.offsetWidth; // Reflow trick
        productsMenu.classList.add('animate');
      });
    }
  });

  
  document.addEventListener("DOMContentLoaded", function () {
    var productsBtn = document.querySelector('[data-submenu="products"]');
    var productsMenu = document.querySelector('.drawer__menu--products');
    var emptyInner = document.querySelector('.drawer__empty__inner');

    if (productsBtn && productsMenu && emptyInner) {
      productsBtn.addEventListener("click", function () {
        productsMenu.classList.remove("animate"); // Reset Animation
        void productsMenu.offsetWidth;
        productsMenu.classList.add("animate");

        emptyInner.classList.add("submenu-open");
      });
    }

    var backButtons = document.querySelectorAll('.drawer__btn-back');
    backButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        emptyInner.classList.remove('submenu-open');
      });
    });
  });
  
</script>






<script>
  document.addEventListener("DOMContentLoaded", function () {
    var emptyInner = document.querySelector('.drawer__empty__inner');

    // Menü-Konfiguration
    var menuButtons = [
      { trigger: '[data-submenu="products"]', menu: '.drawer__menu--products' },
      { trigger: '[data-submenu="geschenke"]', menu: '.drawer__menu--geschenke' }
    ];

    menuButtons.forEach(function (item) {
      var triggerBtn = document.querySelector(item.trigger);
      var targetMenu = document.querySelector(item.menu);

      if (triggerBtn && targetMenu) {
        triggerBtn.addEventListener("click", function () {
          // Animation neu triggern
          targetMenu.classList.remove("animate");
          void targetMenu.offsetWidth;
          targetMenu.classList.add("animate");

          // Menüumschaltung
          document.querySelector(".drawer__menu--main").style.display = "none";
          targetMenu.style.display = "flex";

          // Hinweistext ausblenden
          if (emptyInner) emptyInner.classList.add("submenu-open");
        });
      }
    });

    // Zurück-Button
    var backButtons = document.querySelectorAll("[data-menu-back]");
    backButtons.forEach(function (btn) {
      btn.addEventListener("click", function () {
        document.querySelectorAll(".drawer__menu").forEach(function (menu) {
          menu.style.display = "none";
        });
        document.querySelector(".drawer__menu--main").style.display = "block";
        if (emptyInner) emptyInner.classList.remove("submenu-open");
      });
    });
  });
</script>
