{%- comment -%}
  CIAMORE | Newsletter-Karte. Anmeldung geht per Klaviyo (Double Opt-in, Willkommens-Flow mit 15 %); Shopify-Formular nur als Fallback, falls Klaviyo nicht erreichbar ist.
{%- endcomment -%}
<div class="cm-nl cm-nl--{{ section.id }}{% if section.settings.footer_style %} cm-nl--footer{% endif %}">
  <div class="cm-nl__card">
    {%- if section.settings.eyebrow != blank -%}<span class="cm-nl__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="cm-nl__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="cm-nl__text">{{ section.settings.text }}</p>{%- endif -%}
    {%- assign cm_form_id = 'CmNewsletter-' | append: section.id -%}
    {%- form 'customer', id: cm_form_id, class: 'cm-nl__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="cm-nl__msg" role="status">{{ section.settings.success }}</p>
      {%- else -%}
        <div class="cm-nl__row">
          <label for="CmNlMail-{{ section.id }}" class="visually-hidden">E-Mail</label>
          <input id="CmNlMail-{{ section.id }}" type="email" name="contact[email]" required autocomplete="email" placeholder="{{ section.settings.placeholder }}" value="{{ form.email }}">
          <button type="submit">{{ section.settings.button }}</button>
        </div>
        {%- if form.errors -%}<p class="cm-nl__msg cm-nl__msg--err" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>{%- endif -%}
      {%- endif -%}
    {%- endform -%}
    {%- if section.settings.klaviyo_list != blank -%}
    <script>
      (function () {
        var f = document.getElementById({{ cm_form_id | json }}); if (!f || f.dataset.cmKl) return; f.dataset.cmKl = '1';
        f.addEventListener('submit', function (e) {
          var inp = f.querySelector('input[type="email"]'); if (!inp || f.dataset.cmFallback) return;
          e.preventDefault();
          var btn = f.querySelector('button[type="submit"]'); if (btn) btn.disabled = true;
          var body = { data: { type: 'subscription', attributes: { custom_source: {{ section.settings.klaviyo_source | default: 'Website Formular' | json }}, profile: { data: { type: 'profile', attributes: { email: inp.value.trim() } } } }, relationships: { list: { data: { type: 'list', id: {{ section.settings.klaviyo_list | json }} } } } } };
          fetch('https://a.klaviyo.com/client/subscriptions/?company_id={{ section.settings.klaviyo_company | default: "R99EUf" }}', {
            method: 'POST', headers: { 'content-type': 'application/vnd.api+json', 'revision': '2024-10-15' }, body: JSON.stringify(body)
          }).then(function (r) {
            if (!r.ok) throw new Error(r.status);
            var row = f.querySelector('.cm-nl__row'); var err = f.querySelector('.cm-nl__msg--err'); if (err) err.remove();
            var msg = document.createElement('p'); msg.className = 'cm-nl__msg'; msg.setAttribute('role', 'status'); msg.textContent = {{ section.settings.success_doi | json }};
            if (row) row.replaceWith(msg); else f.appendChild(msg);
          }).catch(function () { f.dataset.cmFallback = '1'; if (btn) btn.disabled = false; f.submit(); });
        });
      })();
    </script>
    {%- endif -%}
    {%- if section.settings.legal != blank -%}<div class="cm-nl__legal">{{ section.settings.legal }}</div>{%- endif -%}
    {%- if section.settings.footer_style -%}
      {%- assign cm_ig = settings.instagram_link | default: 'https://instagram.com/ciamore.de' -%}
      {%- assign cm_tt = settings.tiktok_link | default: 'https://tiktok.com/@ciamore.de' -%}
      <div class="cm-nl__social">
        <a href="{{ cm_ig }}" target="_blank" rel="noopener" aria-label="Ciamore auf Instagram">
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href="{{ cm_tt }}" target="_blank" rel="noopener" aria-label="Ciamore auf TikTok">
          <svg viewBox="0 0 24 24" width="23" height="23" fill="currentColor" aria-hidden="true"><path d="M16.6 2h-3.3v13.4a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .9.1V9.2a6.3 6.3 0 1 0 5.3 6.2V8.6a7.9 7.9 0 0 0 4.4 1.4V6.7a4.6 4.6 0 0 1-4.4-4.7z"/></svg>
        </a>
      </div>
    {%- endif -%}
  </div>
</div>
<style>
  .cm-nl--{{ section.id }} { padding: {{ section.settings.pt_mobile }}px 16px {{ section.settings.pb_mobile }}px; }
  .cm-nl--{{ section.id }} .cm-nl__card { border-radius: 26px; background: var(--cm-sand-2); padding: 26px 20px; display: flex; flex-direction: column; gap: 14px; }
  .cm-nl--{{ section.id }} .cm-nl__eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #7d705e; }
  .cm-nl--{{ section.id }} .cm-nl__title { margin: 0; font-family: var(--cm-display); font-weight: 800; font-size: 26px; line-height: 1.05; letter-spacing: -0.03em; color: var(--cm-ink); }
  .cm-nl--{{ section.id }} .cm-nl__text { margin: 0; font-size: 14.5px; line-height: 1.5; color: var(--cm-muted); }
  .cm-nl--{{ section.id }} .cm-nl__row { display: flex; gap: 8px; }
  .cm-nl--{{ section.id }} input[type="email"] { flex: 1; min-width: 0; height: 48px; border-radius: 999px; border: 0; padding: 0 18px; background: #fff; font-family: var(--cm-body); font-size: 15px; color: var(--cm-ink); }
  .cm-nl--{{ section.id }} button { height: 48px; padding: 0 18px; border-radius: 999px; border: 0; background: var(--cm-black); color: #fff; font-family: var(--cm-body); font-weight: 700; font-size: 14px; cursor: pointer; }
  .cm-nl--{{ section.id }} .cm-nl__msg { margin: 0; font-size: 14px; font-weight: 600; }
  .cm-nl--{{ section.id }} .cm-nl__msg--err { color: #b3261e; }
  .cm-nl--{{ section.id }} .cm-nl__legal { font-size: 11.5px; line-height: 1.45; color: var(--cm-muted); }
  .cm-nl--{{ section.id }} .cm-nl__legal a { color: inherit; }
  @media (min-width: 750px) {
    .cm-nl--{{ section.id }} { padding: {{ section.settings.pt }}px var(--outer, 24px) {{ section.settings.pb }}px; }
    .cm-nl--{{ section.id }} .cm-nl__card { display: grid; grid-template-columns: 1fr minmax(320px, 440px); column-gap: 40px; align-items: center; padding: 48px 40px; }
    .cm-nl--{{ section.id }} .cm-nl__card > * { grid-column: 1; }
    .cm-nl--{{ section.id }} .cm-nl__form, .cm-nl--{{ section.id }} .cm-nl__legal { grid-column: 2; }
    .cm-nl--{{ section.id }} .cm-nl__form { grid-row: 1 / span 3; align-self: center; }
    .cm-nl--{{ section.id }} .cm-nl__title { font-size: 38px; }
  }
  {%- if section.settings.footer_style -%}
  .cm-nl--{{ section.id }} { background: #212121; padding: {{ section.settings.pt_mobile }}px 16px {{ section.settings.pb_mobile }}px; }
  .cm-nl--{{ section.id }} .cm-nl__card { background: transparent; border-radius: 0 !important; padding: 0 0 32px; gap: 10px; border: 0; }
  .cm-nl--{{ section.id }} .cm-nl__eyebrow { color: #bdbdbd; font-size: 14.5px; font-weight: 500; letter-spacing: 0; text-transform: none; }
  .cm-nl--{{ section.id }} .cm-nl__title { color: #fff; font-size: 22px; }
  .cm-nl--{{ section.id }} .cm-nl__text { color: #bdbdbd; }
  .cm-nl--{{ section.id }} input[type="email"] { height: 44px; background: #fff; }
  .cm-nl--{{ section.id }} .cm-nl__row { align-items: center; }
  .cm-nl--{{ section.id }} button { height: 44px; margin: 0; padding: 0 20px; display: inline-flex; align-items: center; justify-content: center; line-height: 1; background: #fff; color: #212121; border: 0; }
  .cm-nl--{{ section.id }} .cm-nl__msg { color: #fff; }
  .cm-nl--{{ section.id }} .cm-nl__legal { color: #9a9a9a; font-size: 11px; }
  .cm-nl--{{ section.id }} .cm-nl__legal p { margin: 0; }
  .cm-nl--{{ section.id }} .cm-nl__social { display: flex; align-items: center; gap: 18px; margin: 16px 0 0 -4px; }
  .cm-nl--{{ section.id }} .cm-nl__social a { display: inline-flex; align-items: center; justify-content: center; padding: 4px; color: #fff; opacity: .8; transition: opacity .2s ease, transform .2s ease; }
  .cm-nl--{{ section.id }} .cm-nl__social a:active { transform: scale(.95); }
  @media (hover: hover) { .cm-nl--{{ section.id }} .cm-nl__social a:hover { opacity: 1; transform: translateY(-1px); } }
  @media (min-width: 750px) {
    .cm-nl--{{ section.id }} { padding: {{ section.settings.pt }}px var(--outer, 24px) {{ section.settings.pb }}px; }
    .cm-nl--{{ section.id }} .cm-nl__card { padding: 0 0 40px; column-gap: 48px; grid-template-columns: 1fr minmax(320px, 460px); }
    .cm-nl--{{ section.id }} .cm-nl__title { font-size: 28px; }
    .cm-nl--{{ section.id }} .cm-nl__form { grid-row: 1 / span 2; }
  }
  {%- endif -%}
</style>
{% schema %}
{
  "name": "Ciamore Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "Newsletter" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Werde Teil der Ciamore Family!" },
    { "type": "textarea", "id": "text", "label": "Text (optional)" },
    { "type": "text", "id": "placeholder", "label": "Platzhalter", "default": "Deine E-Mail" },
    { "type": "text", "id": "button", "label": "Button", "default": "Abonnieren" },
    { "type": "text", "id": "success", "label": "Erfolgsmeldung (nur Fallback über Shopify)", "default": "Danke! Du bist dabei." },
    { "type": "header", "content": "Klaviyo" },
    { "type": "text", "id": "klaviyo_list", "label": "Klaviyo-Listen-ID", "info": "Leer lassen = normale Shopify-Anmeldung", "default": "SU9Niz" },
    { "type": "text", "id": "klaviyo_company", "label": "Öffentliche Klaviyo-Kennung", "default": "R99EUf" },
    { "type": "text", "id": "klaviyo_source", "label": "Quelle (erscheint in Klaviyo)", "default": "Website Formular" },
    { "type": "text", "id": "success_doi", "label": "Erfolgsmeldung", "default": "Fast geschafft! Bitte bestätige deine Anmeldung in deinem Postfach." },
    { "type": "richtext", "id": "legal", "label": "Datenschutz-Hinweis" },
    { "type": "checkbox", "id": "footer_style", "label": "Kompakt im dunklen Footer-Stil", "default": false },
    { "type": "range", "id": "pt", "label": "Abstand oben (Desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "pb", "label": "Abstand unten (Desktop)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "pt_mobile", "label": "Abstand oben (Handy)", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 16 },
    { "type": "range", "id": "pb_mobile", "label": "Abstand unten (Handy)", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 32 }
  ],
  "presets": [{ "name": "Ciamore Newsletter" }],
  "enabled_on": { "templates": ["*"], "groups": ["footer"] }
}
{% endschema %}
