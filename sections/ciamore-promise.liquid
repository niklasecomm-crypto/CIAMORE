{%- comment -%}
  CIAMORE | "Unser Versprechen" in der Fußzeile (ersetzt den alten Kontakt-Block)
{%- endcomment -%}
<div class="cm-promise">
  <p class="cm-promise__title">{{ section.settings.title }}</p>
  <ul class="cm-promise__list">
    {%- for block in section.blocks -%}
      <li class="cm-promise__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          <img class="cm-promise__icon" src="{{ block.settings.icon }}" alt="" width="22" height="22" loading="lazy">
        {%- endif -%}
        <span><b>{{ block.settings.heading }}</b>{%- if block.settings.text != blank -%}<small>{{ block.settings.text }}</small>{%- endif -%}</span>
      </li>
    {%- endfor -%}
  </ul>
</div>
<style>
  .cm-promise { background: #212121; padding: 26px 16px 34px; }
  .cm-promise__title { margin: 0 0 14px; font-family: "Bricolage Grotesque", var(--cm-display, sans-serif); font-weight: 700; font-size: 20px; letter-spacing: -0.02em; color: #fff; }
  .cm-promise__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .cm-promise__item { display: flex; align-items: center; gap: 14px; }
  .cm-promise__icon { flex: 0 0 22px; width: 22px; height: 22px; filter: invert(1); opacity: .9; object-fit: contain; }
  .cm-promise__item b { display: block; font-size: 14.5px; font-weight: 600; color: #fff; line-height: 1.3; }
  .cm-promise__item small { display: block; margin-top: 2px; font-size: 13px; color: #9a9a9a; line-height: 1.4; }
  @media (min-width: 750px) {
    .cm-promise { padding: 30px var(--outer, 24px) 40px; }
    .cm-promise__list { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  }
</style>
{% schema %}
{
  "name": "Vorteile Fußzeile",
  "settings": [
    { "type": "text", "id": "title", "label": "Überschrift", "default": "Darauf kannst du dich verlassen" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Vorteil",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon-URL" },
        { "type": "text", "id": "heading", "label": "Titel" },
        { "type": "text", "id": "text", "label": "Untertitel" }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
