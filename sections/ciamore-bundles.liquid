{%- elsif section.settings.layout == 'tiles' -%}

{%- assign cm_src = collections[section.settings.collection] -%}
<section class="cm-bt cm-bt--{{ section.id }}" aria-labelledby="CmBtTitle-{{ section.id }}">
  <div class="cm-bt__head">
    {%- if section.settings.eyebrow != blank -%}<span class="cm-bt__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2 class="cm-bt__title" id="CmBtTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="cm-bt__copy">{{ section.settings.text }}</p>{%- endif -%}
  </div>
  <div class="cm-bt__track">
    {%- for block in section.blocks -%}
      {%- assign off = forloop.index0 | times: 3 -%}
      <a class="cm-bt__tile{% if block.settings.featured %} is-featured{% endif %}" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        <div class="cm-bt__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'cm-bt__photo', widths: '400, 600, 900', sizes: '(min-width: 750px) 33vw, 78vw' }}
          {%- elsif cm_src != blank -%}
            <div class="cm-bt__collage">
              {%- for product in cm_src.products offset: off limit: 3 -%}
                {%- if product.featured_image -%}
                  <span class="cm-bt__pic cm-bt__pic--{{ forloop.index }}">{{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: product.title, widths: '250, 500', sizes: '(min-width: 750px) 20vw, 45vw' }}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if block.settings.badge != blank -%}<span class="cm-bt__badge">{% if block.settings.featured %}★ {% endif %}{{ block.settings.badge }}</span>{%- endif -%}
        </div>
        <div class="cm-bt__info">
          <div class="cm-bt__row">
            <span class="cm-bt__label">{{ block.settings.label }}</span>
            <span class="cm-bt__price">{{ block.settings.price }}</span>
          </div>
          <div class="cm-bt__row cm-bt__row--sub">
            <span class="cm-bt__per">{{ block.settings.per }}</span>
            <span class="cm-bt__go" aria-hidden="true"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
          </div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>
<style>
