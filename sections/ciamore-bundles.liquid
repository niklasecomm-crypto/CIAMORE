<style>
  .cm-bun--{{ section.id }} { margin: {{ section.settings.mt_mobile }}px 16px 0; border-radius: 26px; background: #f0ede9; color: var(--cm-ink); overflow: hidden; }
  .cm-bun--{{ section.id }} .cm-bun__inner { padding: 30px 0 24px; display: flex; flex-direction: column; gap: 24px; }
  .cm-bun--{{ section.id }} .cm-bun__text { padding: 0 24px; display: flex; flex-direction: column; gap: 12px; }
  .cm-bun--{{ section.id }} .cm-bun__eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #6b6b6b; }
  .cm-bun--{{ section.id }} .cm-bun__title { margin: 0; font-family: var(--cm-display); font-weight: 700; font-size: 36px; line-height: 1.05; letter-spacing: -0.03em; color: inherit; }
  .cm-bun--{{ section.id }} .cm-bun__copy { margin: 0; font-size: 15px; line-height: 1.5; color: var(--cm-muted); max-width: 440px; }
  .cm-bun--{{ section.id }} .cm-bun__btn {
    align-self: flex-start; margin-top: 4px; display: inline-flex; align-items: center; height: 50px; padding: 0 26px;
    border-radius: 999px; background: var(--cm-black); color: #fff; text-decoration: none; font-weight: 700; font-size: 15px;
  }
  /* Handy: Bundles untereinander als breite Karten */
  .cm-bun--{{ section.id }} .cm-bun__cards { display: flex; flex-direction: column; gap: 14px; padding: 8px 18px 4px; }
  .cm-bun--{{ section.id }} .cm-bun__card {
    position: relative; box-sizing: border-box; background: #fff; border-radius: 20px; border: 2px solid #fff;
    padding: 18px 16px 18px 20px; text-decoration: none; color: var(--cm-ink);
    display: grid; grid-template-columns: 1fr auto auto; grid-template-areas: "label price go" "per price go";
    align-items: center; column-gap: 14px; row-gap: 2px;
    transition: transform .15s ease, border-color .15s ease;
  }
  .cm-bun--{{ section.id }} .cm-bun__card:hover, .cm-bun--{{ section.id }} .cm-bun__card.is-highlight { border-color: var(--cm-ink); }
  .cm-bun--{{ section.id }} .cm-bun__badge {
    position: absolute; top: 0; left: 18px; transform: translateY(-50%);
    background: var(--cm-black); color: #fff; border-radius: 999px; padding: 4px 10px; font-size: 11px; font-weight: 700; white-space: nowrap;
  }
  .cm-bun--{{ section.id }} .cm-bun__label { grid-area: label; font-size: 16px; font-weight: 600; color: var(--cm-ink); }
  .cm-bun--{{ section.id }} .cm-bun__per { grid-area: per; font-size: 13px; font-weight: 500; color: var(--cm-muted); }
  .cm-bun--{{ section.id }} .cm-bun__price { grid-area: price; font-family: var(--cm-display); font-weight: 700; font-size: 26px; line-height: 1; letter-spacing: -0.03em; white-space: nowrap; }
  .cm-bun--{{ section.id }} .cm-bun__go {
    grid-area: go; width: 34px; height: 34px; border-radius: 999px; background: var(--cm-black); color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
  }
  /* Top-Angebot: VIP-Look, Schwarz mit Gold */
  .cm-bun--{{ section.id }} { --cm-gold: #c9a45c; }
  .cm-bun--{{ section.id }} .cm-bun__card.is-featured {
    background: #161616; border: 1px solid var(--cm-gold); color: #fff;
    padding-top: 24px; padding-bottom: 24px; box-shadow: 0 12px 30px -14px rgba(0,0,0,.55);
  }
  .cm-bun--{{ section.id }} .cm-bun__card.is-featured:hover { border-color: var(--cm-gold); }
  .cm-bun--{{ section.id }} .cm-bun__card.is-featured .cm-bun__label { color: #fff; }
  .cm-bun--{{ section.id }} .cm-bun__card.is-featured .cm-bun__per { color: var(--cm-gold); }
  .cm-bun--{{ section.id }} .cm-bun__card.is-featured .cm-bun__price { color: #fff; }
  .cm-bun--{{ section.id }} .cm-bun__card.is-featured .cm-bun__go { background: var(--cm-gold); color: #161616; }
  .cm-bun--{{ section.id }} .cm-bun__card.is-featured .cm-bun__badge {
    background: #161616; color: var(--cm-gold); border: 1px solid var(--cm-gold);
    text-transform: uppercase; letter-spacing: .12em; font-size: 10px; padding: 4px 10px 4px 9px;
  }
  .cm-bun--{{ section.id }} .cm-bun__badge { display: inline-flex; align-items: center; gap: 4px; }
  /* Dunkle Variante: Schwarz mit Gold */
  .cm-bun--{{ section.id }}.cm-bun--dark {
    background: radial-gradient(120% 80% at 50% 0%, #2a2a2a 0%, #141414 70%) !important; color: #fff;
  }
  .cm-bun--{{ section.id }}.cm-bun--dark .cm-bun__eyebrow { color: var(--cm-gold); }
  .cm-bun--{{ section.id }}.cm-bun--dark .cm-bun__copy { color: #bdbdbd; }
  .cm-bun--{{ section.id }}.cm-bun--dark .cm-bun__card.is-featured {
    background: linear-gradient(160deg, #2b2620 0%, #1a1815 100%);
    box-shadow: 0 0 0 1px var(--cm-gold), 0 14px 34px -12px rgba(201,164,92,.35);
  }
  .cm-bun--{{ section.id }}.cm-bun--dark .cm-bun__card.is-highlight:not(.is-featured) { border-color: #fff; }
  .cm-bun--{{ section.id }}.cm-bun--dark .cm-bun__card:not(.is-featured) .cm-bun__badge { background: var(--cm-black); color: #fff; border: 1px solid #fff; }
  @media (min-width: 750px) {
    .cm-bun--{{ section.id }} { margin: {{ section.settings.mt }}px var(--outer, 24px) 0; border-radius: 32px; }
    .cm-bun--{{ section.id }} .cm-bun__inner { display: grid; grid-template-columns: minmax(300px, 1fr) minmax(0, 1.4fr); align-items: center; gap: 48px; padding: 56px 48px; }
    .cm-bun--{{ section.id }} .cm-bun__text { padding: 0; gap: 18px; }
    .cm-bun--{{ section.id }} .cm-bun__title { font-size: 52px; }
    .cm-bun--{{ section.id }} .cm-bun__copy { font-size: 17px; }
    .cm-bun--{{ section.id }} .cm-bun__cards { display: grid; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr)); gap: 16px; padding: 14px 0 0; }
    .cm-bun--{{ section.id }} .cm-bun__card { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding: 28px 22px 22px; }
    .cm-bun--{{ section.id }} .cm-bun__badge { left: auto; right: 14px; }
    .cm-bun--{{ section.id }} .cm-bun__label { font-size: 14px; font-weight: 600; color: var(--cm-muted); }
    .cm-bun--{{ section.id }} .cm-bun__per { font-size: 13.5px; font-weight: 700; color: var(--cm-ink); }
    .cm-bun--{{ section.id }} .cm-bun__go { margin-top: 10px; }
    .cm-bun--{{ section.id }} .cm-bun__card.is-featured { transform: translateY(-8px); padding-top: 32px; padding-bottom: 28px; }
    .cm-bun--{{ section.id }} .cm-bun__card.is-featured:hover { transform: translateY(-11px); }
    .cm-bun--{{ section.id }} .cm-bun__card.is-featured .cm-bun__per { color: #d8d3cb; }
    .cm-bun--{{ section.id }} .cm-bun__card:hover { transform: translateY(-3px); }
    .cm-bun--{{ section.id }} .cm-bun__price { font-size: 36px; }
  }
</style>
