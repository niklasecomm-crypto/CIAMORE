    { "type": "select", "id": "card_bg", "label": "Hintergrund Mix/3 Pieces", "options": [{ "value": "silver", "label": "Silber-Verlauf" }, { "value": "pearl", "label": "Perlmutt" }, { "value": "champagne", "label": "Champagner" }, { "value": "mist", "label": "Nebel" }], "default": "silver" },
    { "type": "checkbox", "id": "dark", "label": "Dunkler Hintergrund (Schwarz/Gold)", "default": true },
