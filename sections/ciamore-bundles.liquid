          {%- if block.settings.badge != blank -%}<span class="cm-bun__badge">{% if block.settings.featured %}<svg aria-hidden="true" width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.9 7.1.6-5.4 4.7 1.6 7.3L12 17.8 5.8 21.5l1.6-7.3L2 9.5l7.1-.6z"/></svg>{% endif %}{{ block.settings.badge }}</span>{%- endif -%}
          <span class="cm-bun__label">{{ block.settings.label }}</span>
