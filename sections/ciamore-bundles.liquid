  .cm-bt--{{ section.id }} .cm-bt__title { margin: 0; font-family: var(--cm-display); font-weight: 700; font-size: 32px; line-height: 1.05; letter-spacing: -0.03em; color: var(--cm-ink); }
  .cm-bt--{{ section.id }} .cm-bt__copy { margin: 0; font-size: 15px; line-height: 1.5; color: var(--cm-muted); max-width: 460px; }
  .cm-bt--{{ section.id }} .cm-bt__track {
    display: grid; grid-auto-flow: column; grid-auto-columns: 76%; gap: 12px;
    overflow-x: auto; scroll-snap-type: x mandatory; padding: 0 16px 6px; scroll-padding: 0 16px;
    scrollbar-width: none;
  }
  .cm-bt--{{ section.id }} .cm-bt__track::-webkit-scrollbar { display: none; }
  .cm-bt--{{ section.id }} .cm-bt__tile { scroll-snap-align: start; display: flex; flex-direction: column; text-decoration: none; color: var(--cm-ink); border-radius: 10px; overflow: hidden; background: #f9f8f5; }
  .cm-bt--{{ section.id }} .cm-bt__media { position: relative; aspect-ratio: 4 / 4.2; background: #f9f8f5; overflow: hidden; }
  .cm-bt--{{ section.id }} .cm-bt__photo { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cm-bt--{{ section.id }} .cm-bt__collage { position: absolute; inset: 0; display: grid; grid-template-columns: 1.25fr 1fr; grid-template-rows: 1fr 1fr; gap: 2px; background: #fff; }
  .cm-bt--{{ section.id }} .cm-bt__pic { position: relative; background: #f9f8f5; overflow: hidden; }
  .cm-bt--{{ section.id }} .cm-bt__pic--1 { grid-row: 1 / span 2; }
  .cm-bt--{{ section.id }} .cm-bt__pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; mix-blend-mode: multiply; transition: transform .4s ease; }
  .cm-bt--{{ section.id }} .cm-bt__tile:hover .cm-bt__pic img { transform: scale(1.04); }
  .cm-bt--{{ section.id }} .cm-bt__badge {
    position: absolute; top: 10px; left: 10px; z-index: 1; padding: 5px 9px; border-radius: 6px;
    background: #fff; color: var(--cm-ink); font-size: 11px; font-weight: 700; letter-spacing: .02em;
  }
  .cm-bt--{{ section.id }} .cm-bt__info { padding: 14px 14px 14px; display: flex; flex-direction: column; gap: 4px; background: #fff; border: 1px solid #ebe8e4; border-top: 0; border-radius: 0 0 10px 10px; flex: 1; }
  .cm-bt--{{ section.id }} .cm-bt__row { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
  .cm-bt--{{ section.id }} .cm-bt__row--sub { align-items: center; }
  .cm-bt--{{ section.id }} .cm-bt__label { font-size: 16px; font-weight: 700; }
  .cm-bt--{{ section.id }} .cm-bt__price { font-family: var(--cm-display); font-weight: 700; font-size: 26px; line-height: 1; letter-spacing: -0.03em; white-space: nowrap; }
  .cm-bt--{{ section.id }} .cm-bt__per { font-size: 13px; color: var(--cm-muted); }
  .cm-bt--{{ section.id }} .cm-bt__go { width: 28px; height: 28px; border-radius: 999px; background: var(--cm-black); color: #fff; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
  /* Top-Deal: dunkle Infozeile mit Gold */
  .cm-bt--{{ section.id }} .cm-bt__tile.is-featured .cm-bt__info { background: #161616; border-color: #161616; color: #fff; }
  .cm-bt--{{ section.id }} .cm-bt__tile.is-featured .cm-bt__per { color: var(--cm-gold); }
  .cm-bt--{{ section.id }} .cm-bt__tile.is-featured .cm-bt__go { background: var(--cm-gold); color: #161616; }
  .cm-bt--{{ section.id }} .cm-bt__tile.is-featured .cm-bt__badge { background: #161616; color: var(--cm-gold); text-transform: uppercase; letter-spacing: .1em; font-size: 10px; }
  @media (min-width: 750px) {
    .cm-bt--{{ section.id }} { padding: {{ section.settings.mt | plus: 32 }}px var(--outer, 24px) 16px; }
    .cm-bt--{{ section.id }} .cm-bt__head { padding: 0 0 26px; display: grid; grid-template-columns: 1fr minmax(0, 440px); column-gap: 40px; row-gap: 8px; align-items: end; }
    .cm-bt--{{ section.id }} .cm-bt__eyebrow { grid-column: 1; grid-row: 1; }
    .cm-bt--{{ section.id }} .cm-bt__title { grid-column: 1; grid-row: 2; }
    .cm-bt--{{ section.id }} .cm-bt__copy { grid-column: 2; grid-row: 2; padding-bottom: 6px; }
    .cm-bt--{{ section.id }} .cm-bt__title { font-size: 48px; }
    .cm-bt--{{ section.id }} .cm-bt__copy { font-size: 16px; }
    .cm-bt--{{ section.id }} .cm-bt__track { grid-auto-flow: row; grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, minmax(0, 1fr)); overflow: visible; padding: 0; gap: 18px; }
    .cm-bt--{{ section.id }} .cm-bt__info { padding: 18px 18px; }
    .cm-bt--{{ section.id }} .cm-bt__price { font-size: 32px; }
  }
</style>
{%- else -%}
<section class="cm-bun cm-bun--{{ section.id }}{% if section.settings.dark %} cm-bun--dark{% endif %}" aria-labelledby="CmBunTitle-{{ section.id }}">
  <div class="cm-bun__inner">
