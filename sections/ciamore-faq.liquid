{%- comment -%}
  CIAMORE | Kurzes FAQ (Startseite unten). Aufklappen wie auf der Produktseite, immer nur eine Frage offen.
{%- endcomment -%}
<div class="cm-faq cm-faq--{{ section.id }}" data-cm-acc-group>
  <div class="cm-faq__wrap">
    <div class="cm-faq__head">
      {%- if section.settings.eyebrow != blank -%}<span class="cm-faq__eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="cm-faq__title">{{ section.settings.heading }}</h2>
    </div>
    <div class="cm-faq__list">
      {%- for block in section.blocks -%}
        <details class="cm-faq__item" {{ block.shopify_attributes }}>
          <summary><span>{{ block.settings.question }}</span><span class="cm-faq__icon" aria-hidden="true"></span></summary>
          <div class="cm-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>
<style>
  .cm-faq--{{ section.id }} { background: {{ section.settings.bg }}; padding: {{ section.settings.pt_mobile }}px 16px {{ section.settings.pb_mobile }}px; }
  .cm-faq--{{ section.id }} .cm-faq__wrap { max-width: 760px; margin: 0 auto; }
  .cm-faq--{{ section.id }} .cm-faq__head { margin-bottom: 18px; }
  .cm-faq--{{ section.id }} .cm-faq__eyebrow { display: block; margin-bottom: 6px; font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #9d9d9d; }
  .cm-faq--{{ section.id }} .cm-faq__title { margin: 0; font-family: var(--cm-display); font-weight: 800; font-size: 28px; line-height: 1.05; letter-spacing: -0.03em; color: #212121; }
  .cm-faq--{{ section.id }} .cm-faq__list { border-top: 1px solid #dcdcdc; }
  .cm-faq--{{ section.id }} .cm-faq__item { border-bottom: 1px solid #dcdcdc; }
  .cm-faq--{{ section.id }} summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 2px; font-family: var(--cm-body); font-size: 15.5px; font-weight: 700; color: #212121; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .cm-faq--{{ section.id }} summary::-webkit-details-marker { display: none; }
  .cm-faq--{{ section.id }} .cm-faq__icon { position: relative; flex: 0 0 14px; width: 14px; height: 14px; }
  .cm-faq--{{ section.id }} .cm-faq__icon::before, .cm-faq--{{ section.id }} .cm-faq__icon::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; margin-top: -0.75px; background: #212121; border-radius: 1px; transition: transform .3s ease, opacity .3s ease; }
  .cm-faq--{{ section.id }} .cm-faq__icon::after { transform: rotate(90deg); }
  .cm-faq--{{ section.id }} .cm-acc-open .cm-faq__icon::before { transform: rotate(180deg); }
  .cm-faq--{{ section.id }} .cm-acc-open .cm-faq__icon::after { transform: rotate(180deg); opacity: 0; }
  .cm-faq--{{ section.id }} .cm-acc-body { overflow: hidden; transition: height .3s ease; }
  .cm-faq--{{ section.id }} .cm-acc-inner { opacity: 0; transform: translateY(-20px); transition: transform .3s ease-in, opacity .3s ease-out; padding: 0 2px 18px; }
  .cm-faq--{{ section.id }} .cm-acc-open .cm-acc-inner { opacity: 1; transform: none; }
  .cm-faq--{{ section.id }} .cm-faq__answer, .cm-faq--{{ section.id }} .cm-faq__answer p { margin: 0; font-family: var(--cm-body); font-size: 14.5px; line-height: 1.55; color: #4d4d4d; }
  .cm-faq--{{ section.id }} .cm-faq__answer p + p { margin-top: 8px; }
  .cm-faq--{{ section.id }} .cm-faq__answer a { color: #212121; text-decoration: none; }
  @media (min-width: 750px) {
    .cm-faq--{{ section.id }} { padding: {{ section.settings.pt }}px var(--outer, 24px) {{ section.settings.pb }}px; }
    .cm-faq--{{ section.id }} .cm-faq__title { font-size: 36px; }
    .cm-faq--{{ section.id }} .cm-faq__head { text-align: center; margin-bottom: 26px; }
  }
</style>
{% schema %}
{
  "name": "FAQ kurz",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Überzeile", "default": "Gut zu wissen" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Noch Fragen?" },
    { "type": "color", "id": "bg", "label": "Hintergrund", "default": "#ffffff" },
    { "type": "range", "id": "pt", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand oben (PC)", "default": 64 },
    { "type": "range", "id": "pb", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand unten (PC)", "default": 64 },
    { "type": "range", "id": "pt_mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand oben (Handy)", "default": 44 },
    { "type": "range", "id": "pb_mobile", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand unten (Handy)", "default": 44 }
  ],
  "blocks": [
    { "type": "question", "name": "Frage", "settings": [
      { "type": "text", "id": "question", "label": "Frage" },
      { "type": "richtext", "id": "answer", "label": "Antwort" }
    ] }
  ],
  "presets": [ { "name": "FAQ kurz" } ]
}
{% endschema %}
