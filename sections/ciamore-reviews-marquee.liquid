{%- comment -%}
  CIAMORE | Bewertungen Laufband
  Endlos durchlaufende Kundenbewertungen. Wischen pausiert, nach kurzer Pause läuft es weiter.
{%- endcomment -%}

<style>
  #cm-rv-{{ section.id }} {
    --cm-bg: {{ section.settings.bg }};
    --cm-card: {{ section.settings.card_bg }};
    --cm-text: {{ section.settings.text }};
    --cm-star: {{ section.settings.star }};
    background: var(--cm-bg);
    color: var(--cm-text);
    padding: {{ section.settings.pt }}px 0 {{ section.settings.pb }}px;
    overflow: hidden;
  }
  #cm-rv-{{ section.id }} .cm-rv__head {
    text-align: center;
    padding: 0 16px;
    margin-bottom: 22px;
  }
  #cm-rv-{{ section.id }} .cm-rv__title {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--cm-text);
  }
  #cm-rv-{{ section.id }} .cm-rv__sub {
    margin: 6px 0 0;
    font-size: 13px;
    opacity: .7;
  }
  #cm-rv-{{ section.id }} .cm-rv__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
            mask-image: linear-gradient(to right, transparent 0, #000 6%, #000 94%, transparent 100%);
  }
  #cm-rv-{{ section.id }} .cm-rv__viewport::-webkit-scrollbar { display: none; }
  #cm-rv-{{ section.id }} .cm-rv__track {
    display: flex;
    align-items: stretch;
    width: max-content;
    will-change: transform;
    transform: translate3d(0, 0, 0);
  }
  #cm-rv-{{ section.id }} .cm-rv__card {
    flex: 0 0 auto;
    width: 260px;
    margin-right: 14px;
    padding: 18px 18px 16px;
    background: var(--cm-card);
    border-radius: 14px;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
  }
  #cm-rv-{{ section.id }} .cm-rv__stars {
    color: var(--cm-star);
    font-size: 15px;
    letter-spacing: 2px;
    line-height: 1;
    margin-bottom: 10px;
  }
  #cm-rv-{{ section.id }} .cm-rv__stars .is-off { opacity: .25; }
  #cm-rv-{{ section.id }} .cm-rv__text {
    margin: 0 0 14px;
    font-size: 14px;
    line-height: 1.45;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  #cm-rv-{{ section.id }} .cm-rv__meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  #cm-rv-{{ section.id }} .cm-rv__img {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    object-fit: cover;
    background: #fff;
    flex: 0 0 auto;
  }
  #cm-rv-{{ section.id }} .cm-rv__name {
    display: block;
    font-size: 13px;
    font-weight: 600;
  }
  #cm-rv-{{ section.id }} .cm-rv__product {
    display: block;
    font-size: 12px;
    opacity: .65;
    color: inherit;
    text-decoration: none;
  }
  #cm-rv-{{ section.id }} a.cm-rv__product:hover { text-decoration: underline; }
  /* Glas-Glanz Look */
  #cm-rv-{{ section.id }} .cm-rv__track { padding: 6px 0 18px; }
  #cm-rv-{{ section.id }} .cm-rv__card {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(145deg, rgba(255,255,255,.95) 0%, rgba(255,255,255,.35) 38%, rgba(255,255,255,0) 60%),
      var(--cm-card);
    border: 1px solid rgba(0,0,0,.07);
    box-shadow:
      inset 0 1px 0 rgba(255,255,255,.95),
      inset 0 -1px 0 rgba(0,0,0,.035),
      0 8px 22px -10px rgba(20,20,20,.16);
  }
  #cm-rv-{{ section.id }} .cm-rv__card::before {
    content: "";
    position: absolute;
    top: -60%;
    left: -30%;
    width: 60%;
    height: 220%;
    background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.55), rgba(255,255,255,0));
    transform: rotate(20deg);
    pointer-events: none;
  }
  #cm-rv-{{ section.id }} .cm-rv__card > * { position: relative; }

  @media (min-width: 750px) {
    #cm-rv-{{ section.id }} .cm-rv__card { width: 300px; margin-right: 18px; }
    #cm-rv-{{ section.id }} .cm-rv__text { font-size: 15px; }
    #cm-rv-{{ section.id }} .cm-rv__title { font-size: 17px; }
  }
</style>

<div id="cm-rv-{{ section.id }}" class="cm-rv">
  {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
    <div class="cm-rv__head">
      {%- if section.settings.heading != blank -%}
        <h2 class="cm-rv__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="cm-rv__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="cm-rv__viewport">
    <div class="cm-rv__track">
      {%- for copy in (1..9) -%}
        {%- for block in section.blocks -%}
          {%- assign p = nil -%}
          {%- if block.settings.handle != blank -%}
            {%- assign p = all_products[block.settings.handle] -%}
          {%- endif -%}
          <div class="cm-rv__card"
            {% if copy == 5 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
            <div class="cm-rv__stars" aria-label="{{ block.settings.rating }} von 5 Sternen">
              {%- for s in (1..5) -%}
                <span{% if s > block.settings.rating %} class="is-off"{% endif %}>★</span>
              {%- endfor -%}
            </div>
            <p class="cm-rv__text">{{ block.settings.text }}</p>
            <div class="cm-rv__meta">
              {%- if p.featured_image != blank -%}
                {{ p.featured_image | image_url: width: 96 | image_tag: loading: 'lazy', alt: p.title, class: 'cm-rv__img', width: 38, height: 38 }}
              {%- endif -%}
              <div>
                <span class="cm-rv__name">{{ block.settings.name }}</span>
                {%- if p.title != blank -%}
                  <a class="cm-rv__product" href="{{ p.url }}" aria-label="{{ p.title | escape }} ansehen"{% if copy != 5 %} tabindex="-1"{% endif %}>{{ p.title }}</a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('cm-rv-{{ section.id }}');
    if (!root) return;
    var vp = root.querySelector('.cm-rv__viewport');
    var track = root.querySelector('.cm-rv__track');
    if (!vp || !track) return;

    var dir = {% if section.settings.direction == 'right' %}-1{% else %}1{% endif %};
    var dur = {{ section.settings.duration }};
    var resumeDelay = {{ section.settings.resume_delay | times: 1000 }};
    var pauseHover = {{ section.settings.pause_hover }};
    var mq = window.matchMedia ? window.matchMedia.bind(window) : null;
    var reduce = mq ? mq('(prefers-reduced-motion: reduce)').matches : false;
    var canHover = mq ? mq('(hover: hover) and (pointer: fine)').matches : false;

    var setW = 0;
    var base = 0;      /* scrollLeft while auto mode runs */
    var off = 0;       /* extra offset via transform, subpixel smooth */
    var last = 0, ramp = 1, lastSl = 0;
    var auto = true, touching = false, hovering = false, visible = true;
    var timer = null;

    function setOff(v) {
      off = v;
      track.style.transform = 'translate3d(' + (-off) + 'px,0,0)';
    }

    /* hand over from transform to native scroll, before the user scrolls */
    function toNative() {
      if (!auto) return;
      auto = false;
      var p = Math.round(base + off);
      setOff(0);
      vp.scrollLeft = p;
      lastSl = vp.scrollLeft;
    }

    /* hand over from native scroll back to transform */
    function toAuto() {
      recenter();
      base = vp.scrollLeft;
      lastSl = base;
      setOff(0);
      last = 0;
      ramp = 0;
      auto = true;
    }

    var COPIES = 9;

    /* scroll position that puts the view exactly in the middle of all copies */
    function center() { return (setW * COPIES - vp.clientWidth) / 2; }

    function measure() {
      var w = track.scrollWidth / COPIES;
      if (!w) return;
      var phase = setW ? (((base + off) % setW) + setW) % setW * (w / setW) : 0;
      setW = w;
      var c = center();
      var cur = phase + Math.round((c - phase) / w) * w;
      setOff(0);
      vp.scrollLeft = cur;
      base = vp.scrollLeft;
      lastSl = base;
    }

    function wrapAuto() {
      var p = base + off, c = center();
      if (p < c - setW / 2) setOff(off + setW);
      else if (p > c + setW / 2) setOff(off - setW);
    }

    /* jump back to the middle copy, only while nothing moves (invisible) */
    function recenter() {
      if (!setW) return;
      var sl = vp.scrollLeft;
      var target = sl + Math.round((center() - sl) / setW) * setW;
      if (Math.abs(target - sl) > 1) vp.scrollLeft = target;
      lastSl = vp.scrollLeft;
    }

    function scheduleResume() {
      clearTimeout(timer);
      timer = setTimeout(function () {
        if (touching) return;
        toAuto();
      }, resumeDelay);
    }

    function ease(x) { return x < 1 ? x * x * (3 - 2 * x) : 1; }

    function tick(t) {
      if (!document.body.contains(root)) return;
      if (!last) last = t;
      var dt = Math.min(t - last, 50) / 1000;
      last = t;
      if (auto && !hovering && visible && !reduce && setW) {
        if (ramp < 1) ramp = Math.min(1, ramp + dt / 0.9);
        setOff(off + dir * (setW / dur) * ease(ramp) * dt);
        wrapAuto();
      }
      window.requestAnimationFrame(tick);
    }

    vp.addEventListener('touchstart', function () {
      touching = true;
      clearTimeout(timer);
      toNative();
      recenter();
    }, { passive: true });

    function endTouch() {
      touching = false;
      scheduleResume();
    }
    vp.addEventListener('touchend', endTouch, { passive: true });
    vp.addEventListener('touchcancel', endTouch, { passive: true });

    vp.addEventListener('wheel', function (e) {
      if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
        toNative();
        scheduleResume();
      }
    }, { passive: true });

    vp.addEventListener('scroll', function () {
      if (auto) return;
      var sl = vp.scrollLeft;
      var d = sl - lastSl;
      if (Math.abs(d) > 0.5 && Math.abs(d) < setW * 0.5) dir = d > 0 ? 1 : -1;
      lastSl = sl;
      if (!touching) scheduleResume();
    }, { passive: true });

    if (pauseHover && canHover) {
      vp.addEventListener('mouseenter', function () { hovering = true; });
      vp.addEventListener('mouseleave', function () {
        hovering = false;
        last = 0;
        ramp = 0;
      });
    }

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        visible = entries[0].isIntersecting;
        last = 0;
      }).observe(root);
    }

    if ('ResizeObserver' in window) {
      new ResizeObserver(function () { if (auto) measure(); }).observe(vp);
    } else {
      window.addEventListener('resize', function () { if (auto) measure(); });
    }
    window.addEventListener('load', function () { if (auto) measure(); });

    measure();
    window.requestAnimationFrame(tick);
  })();
</script>

{% schema %}
{
  "name": "Bewertungen Laufband",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Was unsere Kundinnen sagen" },
    { "type": "text", "id": "subheading", "label": "Unterzeile (optional)" },
    {
      "type": "select",
      "id": "direction",
      "label": "Laufrichtung",
      "options": [
        { "value": "right", "label": "Links nach rechts" },
        { "value": "left", "label": "Rechts nach links" }
      ],
      "default": "right"
    },
    { "type": "range", "id": "duration", "min": 20, "max": 120, "step": 5, "unit": "s", "label": "Dauer pro Durchlauf (höher = langsamer)", "default": 50 },
    { "type": "range", "id": "resume_delay", "min": 1, "max": 6, "step": 1, "unit": "s", "label": "Nach Wischen wieder starten nach", "default": 2 },
    { "type": "checkbox", "id": "pause_hover", "label": "Am Desktop bei Mouse-Over anhalten", "default": true },
    { "type": "color", "id": "bg", "label": "Hintergrund", "default": "#ffffff" },
    { "type": "color", "id": "card_bg", "label": "Kartenfarbe", "default": "#f4f4f2" },
    { "type": "color", "id": "text", "label": "Textfarbe", "default": "#1a1a1a" },
    { "type": "color", "id": "star", "label": "Sternfarbe", "default": "#c9a24d" },
    { "type": "range", "id": "pt", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand oben", "default": 40 },
    { "type": "range", "id": "pb", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Abstand unten", "default": 40 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Bewertung",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text", "info": "Kurz halten, max. 4 Zeilen werden angezeigt" },
        { "type": "text", "id": "name", "label": "Vorname" },
        { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Sterne", "default": 5 },
        { "type": "text", "id": "handle", "label": "Produkt Handle (optional)", "info": "Der Teil nach /products/ in der URL, z. B. tennis-armband" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Bewertungen Laufband",
      "blocks": [
        { "type": "review", "settings": { "name": "Helena", "rating": 5, "handle": "clean-girl-set", "text": "Wirklich wasserfest! Trage den Schmuck seit drei Monaten und er sieht immer noch sehr gut aus." } },
        { "type": "review", "settings": { "name": "Rana", "rating": 5, "handle": "tennis-armband", "text": "Hatte schon Tennis Armbänder von mehreren Marken, das hier hat zu 100% die beste Qualität." } },
        { "type": "review", "settings": { "name": "Denise", "rating": 5, "handle": "gold-clover-armband", "text": "Super schönes Armband, sieht noch schöner aus als auf dem Bild 🤩" } },
        { "type": "review", "settings": { "name": "Lorena", "rating": 5, "handle": "select-clover-kette", "text": "Schon das dritte Mal bestellt und immer wieder zufrieden. Gute Qualität und schneller Versand 💗" } },
        { "type": "review", "settings": { "name": "Fernanda", "rating": 5, "handle": "glossy-pink-clover-armband", "text": "Wunderschönes Armband, hat den Urlaub problemlos überstanden 😘" } },
        { "type": "review", "settings": { "name": "Thea", "rating": 5, "handle": "miroa-ring", "text": "Toller Ring, färbt nicht ab und ein sehr guter Preis." } },
        { "type": "review", "settings": { "name": "Jana", "rating": 5, "handle": "pink-halo-armreif", "text": "Das Pink ist nicht zu knallig, sondern richtig schön. Und die Qualität ist der Hammer." } },
        { "type": "review", "settings": { "name": "Valerie", "rating": 5, "handle": "linea-zirconia-ohrringe", "text": "Nicht zu groß, fallen aber trotzdem auf und funkeln richtig stark mit den Steinen." } }
      ]
    }
  ]
}
{% endschema %}
